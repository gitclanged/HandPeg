<Project Sdk="Microsoft.NET.Sdk">

  <!--
      HandPeg's golden-file tests, run by tools\GoldenTests.ps1. A program of its own beside HandPeg (HandPegApp.csproj
      leaves tools\ out of its build), referencing the app's build so that it tests the very code HandPeg runs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <AssemblyName>HandPeg.GoldenTests</AssemblyName>
    <RootNamespace>HandPegGoldenTests</RootNamespace>
    <!-- For [LibraryImport]: the Explorer thumbnail handler's GDI calls (compiled in below) and the test's own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="golden\**;fixtures\**" />
    <Compile Remove="golden\**;fixtures\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HandPegApp.csproj" />
  </ItemGroup>

  <!--
      The Explorer thumbnail handler (Pass 5.2D), its sources compiled in here (the SeekBench pattern), so the
      explorer-thumbnails test calls the very class Explorer loads. Not a ProjectReference: HandPeg's build builds that library itself
      (HandPegApp.csproj), and a second build of it from here, with other global properties, would race it into the same folders.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\ShellThumbnails\*.cs" Link="ShellThumbnails\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
