<Project Sdk="Microsoft.NET.Sdk">

  <!--
      HandPeg's golden-file tests, run by tools\GoldenTests.ps1. A program of its own beside HandPeg (HandPegApp.csproj
      leaves tools\ out of its build), referencing the app's build so that it tests the very code HandPeg runs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <AssemblyName>HandPeg.GoldenTests</AssemblyName>
    <RootNamespace>HandPegGoldenTests</RootNamespace>
    <!-- For [LibraryImport] and pointers: the Explorer thumbnail handler's COM tables and GDI+ calls (compiled in below) and the test's own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="golden\**;fixtures\**" />
    <Compile Remove="golden\**;fixtures\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HandPegApp.csproj" />
  </ItemGroup>

  <!--
      The Explorer thumbnail handler (Pass 5.2D; NativeAOT since Pass 5.3-Stage2), its sources compiled in here (the SeekBench pattern),
      so the explorer-thumbnails test calls the very code Explorer loads, through its exports by address, as Explorer's surrogate calls the
      DLL. Only its sources: its project's NativeAOT settings stay out of this program (it runs on .NET as any test does), and a Release
      build's published DLL is loaded by the test where it exists. Not a ProjectReference: HandPeg's Release build publishes that library
      itself (HandPegApp.csproj), and a second build of it from here, with other global properties, would race it into the same folders.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\ShellThumbnails\*.cs" Link="ShellThumbnails\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
      HandPeg.exe of the portable zips and both installers (Pass 5.2.1, 5.3-Stage1): where it looks for .NET, which of Microsoft's files it
      takes, and what it does with none, compiled in here (portable-bootstrap). Its windows and its hosting (ChoiceWindow, ProgressWindow,
      HostFxr, Program) are not: nothing here calls them.
  -->
  <ItemGroup>
    <Compile Include="..\PortableBootstrap\DotNetRoots.cs;..\PortableBootstrap\PortableDotNet.cs;..\PortableBootstrap\SystemDotNet.cs;..\PortableBootstrap\Launch.cs;..\PortableBootstrap\PendingSwapException.cs;..\PortableBootstrap\Web.cs;..\PortableBootstrap\Native.cs"
             Link="PortableBootstrap\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
