<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HandPeg.exe of the portable zips (Pass 5.2.1) and of both Setup installers (Pass 5.3-Stage1): a native program (NativeAOT: no .NET
    needed to start it) that runs HandPeg.dll in its own process through hostfxr when a .NET 10 Desktop Runtime for its processor is
    the copy's own or on the PC (one hostfxr refuses passes to the next), and otherwise asks: download Microsoft's own into the copy's own
    root (portable\dotnet for a zip, dotnet beside a portable.txt or portable-argument copy's program, the install folder's dotnet for an
    installed copy; no admin, no script), or install it for every program with Microsoft's installer (admin); then it runs it.
    Published once per processor:
      dotnet publish tools\PortableBootstrap\HandPegBootstrap.csproj -c Release -r win-x64    (and -r win-arm64)
    which needs the C++ build tools (Visual Studio's "Desktop development with C++", with the ARM64 and x64 compilers) for the
    linker; the target below finds them without vswhere.exe on PATH. Release.ps1 copies the result over the publish's HandPeg.exe in
    each zip and in each installer's package. It has no icon of its own (HandPeg ships none until a designed one is made); the version
    below is the release's, set with the app's.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>HandPegBootstrap</AssemblyName>
    <RootNamespace>HandPegBootstrap</RootNamespace>
    <Product>HandPeg</Product>
    <AssemblyTitle>HandPeg</AssemblyTitle>
    <Company>HandPeg</Company>
    <Version>5.4.4</Version>
    <AssemblyVersion>5.4.4.0</AssemblyVersion>
    <FileVersion>5.4.4.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native, small, quick to start: no stack trace data, no globalization data, resource keys for messages, no background GC thread. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- No CET shadow stacks (Pass 5.3-Stage2, the user's answer, a security trade-off): NativeAOT links an x64 program CET-compatible
         by default (/CETCOMPAT), and Windows then keeps a shadow stack of every call, which cost about 16 ms of HandPeg's start-up on the
         Desktop's Zen 4. This is the released HandPeg.exe, so HandPeg itself, its GPU worker and its crash sentinel (all started through
         it) run without. ARM64 has no such mark. Takes effect from a clean obj only (Release.ps1 deletes it). -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <!--
      NativeAOT finds the C++ linker through Visual Studio's vcvarsall.bat, which calls vswhere.exe by name: the Visual Studio Installer
      folder (where vswhere.exe is, never on PATH by itself) is put on this build's PATH just before NativeAOT looks for the linker.
  -->
  <UsingTask TaskName="AddFolderToPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Folder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var path = System.Environment.GetEnvironmentVariable("PATH") ?? "";
        if (System.IO.Directory.Exists(Folder) && path.IndexOf(Folder, System.StringComparison.OrdinalIgnoreCase) < 0)
            System.Environment.SetEnvironmentVariable("PATH", path + ";" + Folder);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PutVsWhereOnPath" BeforeTargets="SetupOSSpecificProps">
    <AddFolderToPath Folder="$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer" />
  </Target>

</Project>
