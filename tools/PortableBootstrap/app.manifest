<?xml version="1.0" encoding="utf-8"?>
<!--
  HandPeg.exe of the portable zips (5.2.1) and of both Setup installers (5.3-Stage1). It becomes HandPeg's process (it runs HandPeg.dll
  in place), so it says no more of that process than .NET's own apphost does: no DPI awareness (WPF and HandPeg's UiScale decide it),
  no OS list, no common controls (so the choice dialog's buttons are owner-drawn). The choice dialog and the download window take
  per-monitor DPI for their own thread alone (ChoiceWindow, ProgressWindow). asInvoker: only Microsoft's installer, which the user
  may choose, asks for administrator rights.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MyApplication.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
