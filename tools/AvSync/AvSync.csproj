<Project Sdk="Microsoft.NET.Sdk">

  <!--
      The A/V sync harness (see tools\README.md, "AvSyncTest.ps1"): draws a project's picture with a real compositor
      worker and renders its sound with the real mixer, as the GPU engine makes them, and measures how far they are from
      the files they came from; or plays it in real time through a real GpuPreviewEngine and measures the frames shown
      against the sound heard. It opens the project in the app's own view model, so it references the app (and starts
      itself again as the compositor's worker, as HandPeg does).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HandPegApp.Tools.AvSync</RootNamespace>
    <AssemblyName>AvSync</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HandPegApp.csproj" />
  </ItemGroup>

</Project>
