<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The program is HandPeg.exe; the project, its folder and the namespace keep their working name. -->
    <AssemblyName>HandPeg</AssemblyName>
    <RootNamespace>HandPegApp</RootNamespace>
    <Product>HandPeg</Product>
    <AssemblyTitle>HandPeg</AssemblyTitle>
    <Version>1.1.0</Version>

    <!-- Main is written by hand in Program.cs, so that the updater's bootstrap runs before WPF starts. -->
    <StartupObject>HandPegApp.Program</StartupObject>

    <!-- Windows Forms is referenced for two things WPF lacks: the system colour picker and tray notifications. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 64-bit Intel/AMD only: that is what the tools and the player library HandPeg downloads are built for. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Its namespaces are not imported everywhere: half their type names collide with WPF's. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Built as a Page instead of the application definition: that keeps InitializeComponent and drops the generated Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Published and packed output, when it is made inside the project folder. -->
  <ItemGroup>
    <Compile Remove="publish\**;Releases\**" />
    <None Remove="publish\**;Releases\**" />
    <Page Remove="publish\**;Releases\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
