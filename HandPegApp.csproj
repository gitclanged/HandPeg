<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The program is HandPeg.exe; the project, its folder and the namespace keep their working name. -->
    <AssemblyName>HandPeg</AssemblyName>
    <RootNamespace>HandPegApp</RootNamespace>
    <Product>HandPeg</Product>
    <AssemblyTitle>HandPeg</AssemblyTitle>
    <Version>5.3.1</Version>
    <AssemblyVersion>5.3.1.0</AssemblyVersion>
    <FileVersion>5.3.1.0</FileVersion>

    <!-- Main is written by hand in Program.cs, so that the updater's bootstrap runs before WPF starts. -->
    <StartupObject>HandPegApp.Program</StartupObject>

    <!-- No ApplicationIcon (5.3, the user's answer): HandPeg ships with no custom .ico until the user provides a human-designed one. -->

    <!-- Windows Forms is referenced for two things WPF lacks: the system colour picker and tray notifications. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 64-bit Intel/AMD, or 64-bit ARM when published for win-arm64 (4.3D): the tools HandPeg downloads are the builds
         for the processor it runs on (DependencyUpdater.IsArm64). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- A build that names no runtime is for the machine it is made on: on an ARM64 PC the debug build and the tools'
         builds (golden tests, SeekBench, AvSync) run natively, without an x64 .NET beside the ARM64 one. -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64')">ARM64</PlatformTarget>
    <!-- For the native calls: the compositor's COM by hand (function pointers), Windows through generated [LibraryImport] code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
      Start-up and memory. A published build is compiled to machine code ahead of time (one composite image,
      so the framework's code and HandPeg's are optimized together), and the JIT that remains uses what it
      learns while running. The heap is the workstation one, which does not grow with the number of cores,
      and it is allowed to shrink again when the work is done (DATAS).
  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>

    <!-- No CET shadow stacks (Pass 5.3-Stage2, the user's answer, a security trade-off): .NET 9 and later mark an x64 HandPeg.exe
         CET-compatible, and Windows then keeps a shadow stack of every call, which cost about 16 ms of start-up on the Desktop's Zen 4.
         ARM64 has no such mark. This is the build's own HandPeg.exe (and a raw publish's); the released HandPeg.exe is the bootstrapper,
         which says the same (tools\PortableBootstrap). It takes effect from a clean obj only (CLAUDE.md section 4). -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <!--
      The youngest generation may grow to 64 MB before it is collected (5.3, measured on .NET 10): the ~18 MB a start allocates before
      its first frame then costs no pause. Left to .NET 10 (or held to 16 MB) it cost the XPS three collections and 18 ms of pauses and
      the Desktop one of 12 ms. First frame, medians of 9 alternating starts: XPS 433 ms with none, 423 with 16 MB, 417 with 64 MB;
      Desktop 440, 442, 440 (no change there). The heap 10 s after the first frame is unchanged (the start-up collection after it compacts).
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="67108864" />
  </ItemGroup>

  <!-- Its namespaces are not imported everywhere: half their type names collide with WPF's. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The golden tests reach the engine's own parts (the sound engine's effects and downmix, the GPU scene's lowering). -->
  <ItemGroup>
    <InternalsVisibleTo Include="HandPeg.GoldenTests" />
  </ItemGroup>

  <!--
      App.xaml is built as a Page instead of the application definition: that keeps InitializeComponent and drops the
      generated Main. Living in src\, it is one by default (only a root App.xaml defaults to the application definition).
  -->

  <!--
      Published and packed output, when it is made inside the project folder; local\, this PC's untracked material (never
      part of the program); the developer tools, which live beside the
      program without being part of it (tools\, each a project of its own); and the Explorer thumbnail handler, a library of
      its own (src\ShellThumbnails, built below), its obj\ with it.
  -->
  <ItemGroup>
    <Compile Remove="publish\**;Releases\**;local\**;tools\**;src\ShellThumbnails\**" />
    <None Remove="publish\**;Releases\**;local\**;tools\**;src\ShellThumbnails\**" />
    <Page Remove="publish\**;Releases\**;local\**;tools\**;src\ShellThumbnails\**" />
    <EmbeddedResource Remove="local\**;tools\**;src\ShellThumbnails\**" />
    <Content Remove="tools\**;src\ShellThumbnails\**" />
  </ItemGroup>

  <!--
      The GPU compositor's shaders (Pass 5.0-Core): every .hlsl under src\Compositor\Shaders is compiled at build time by
      Windows' own d3dcompiler_47.dll (System32; no SDK, no NuGet), one blob per entry point named VS* (vs_5_0) or PS*
      (ps_5_0), optimised, warnings as errors, and embedded as HandPegApp.Shaders.<entry>.cso. Nothing compiles at run
      time. Incremental: only when a shader source changed.
  -->
  <ItemGroup>
    <HlslSource Include="src\Compositor\Shaders\*.hlsl" />
    <HlslHeader Include="src\Compositor\Shaders\*.hlsli" />
    <None Remove="src\Compositor\Shaders\**" />
  </ItemGroup>

  <PropertyGroup>
    <HlslOutput>$(BaseIntermediateOutputPath)shaders\</HlslOutput>
  </PropertyGroup>

  <UsingTask TaskName="CompileHlsl" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <WpfEffects ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <OutputDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Text.RegularExpressions;

public class CompileHlsl : Microsoft.Build.Utilities.Task
{
    [Microsoft.Build.Framework.Required] public Microsoft.Build.Framework.ITaskItem[] Sources { get; set; }
    public Microsoft.Build.Framework.ITaskItem[] WpfEffects { get; set; }
    [Microsoft.Build.Framework.Required] public string OutputDirectory { get; set; }

    [DllImport("d3dcompiler_47.dll", CharSet = CharSet.Unicode)]
    private static extern int D3DCompileFromFile(string fileName, IntPtr defines, IntPtr include, [MarshalAs(UnmanagedType.LPStr)] string entry,
        [MarshalAs(UnmanagedType.LPStr)] string target, uint flags1, uint flags2, out IntPtr code, out IntPtr errors);

    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate IntPtr BufferPointer(IntPtr blob);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] private delegate IntPtr BufferSize(IntPtr blob);

    private static T Method<T>(IntPtr instance, int slot) where T : class =>
        (T)(object)Marshal.GetDelegateForFunctionPointer(Marshal.ReadIntPtr(Marshal.ReadIntPtr(instance), slot * IntPtr.Size), typeof(T));

    private static byte[] Bytes(IntPtr blob)
    {
        var pointer = Method<BufferPointer>(blob, 3)(blob);
        var size = (long)Method<BufferSize>(blob, 4)(blob);
        var bytes = new byte[size];
        Marshal.Copy(pointer, bytes, 0, (int)size);
        return bytes;
    }

    public override bool Execute()
    {
        // D3DCOMPILE_ENABLE_STRICTNESS | OPTIMIZATION_LEVEL3 | WARNINGS_ARE_ERRORS; the standard include handler.
        const uint flags = (1u << 11) | (1u << 15) | (1u << 18);
        var include = new IntPtr(1);
        var entryPoint = new Regex(@"^\s*(?:float4|VsOut)\s+((?:VS|PS)\w+)\s*\(", RegexOptions.Multiline);
        Directory.CreateDirectory(OutputDirectory);
        foreach (var stale in Directory.GetFiles(OutputDirectory, "*.cso"))
            File.Delete(stale);

        var ok = true;
        foreach (var effect in WpfEffects ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
            // ps_2_0 for WPF: its older syntax, so not strict; warnings as errors all the same.
            var path = effect.GetMetadata("FullPath");
            IntPtr code, errors;
            var hr = D3DCompileFromFile(path, IntPtr.Zero, include, "main", "ps_2_0", (1u << 15) | (1u << 18), 0, out code, out errors);
            if (hr < 0)
            {
                ok = false;
                var text = errors != IntPtr.Zero ? System.Text.Encoding.ASCII.GetString(Bytes(errors)).TrimEnd('\0', '\r', '\n') : hr.ToString("X8");
                Log.LogError("HLSL", "HLSL0003", null, path, 0, 0, 0, 0, "main (ps_2_0): {0}", text);
                continue;
            }

            File.WriteAllBytes(Path.Combine(OutputDirectory, Path.GetFileNameWithoutExtension(path) + ".ps"), Bytes(code));
            Marshal.Release(code);
        }

        foreach (var source in Sources)
        {
            var path = source.GetMetadata("FullPath");
            foreach (Match match in entryPoint.Matches(File.ReadAllText(path)))
            {
                var entry = match.Groups[1].Value;
                var profile = entry.StartsWith("VS", StringComparison.Ordinal) ? "vs_5_0" : "ps_5_0";
                IntPtr code, errors;
                var hr = D3DCompileFromFile(path, IntPtr.Zero, include, entry, profile, flags, 0, out code, out errors);
                if (errors != IntPtr.Zero)
                {
                    var text = System.Text.Encoding.ASCII.GetString(Bytes(errors)).TrimEnd('\0', '\r', '\n');
                    Marshal.Release(errors);
                    if (hr < 0)
                        Log.LogError("HLSL", "HLSL0001", null, path, 0, 0, 0, 0, "{0} ({1}): {2}", entry, profile, text);
                    else if (text.Length > 0)
                        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "{0}: {1}", entry, text);
                }

                if (hr < 0)
                {
                    ok = false;
                    if (errors == IntPtr.Zero)
                        Log.LogError("HLSL", "HLSL0002", null, path, 0, 0, 0, 0, "{0} ({1}) failed: 0x{2:X8}", entry, profile, hr);
                    continue;
                }

                File.WriteAllBytes(Path.Combine(OutputDirectory, entry + ".cso"), Bytes(code));
                Marshal.Release(code);
            }
        }

        return ok && !Log.HasLoggedErrors;
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" Inputs="@(HlslSource);@(HlslHeader);@(WpfEffectSource)" Outputs="$(HlslOutput)shaders.stamp">
    <CompileHlsl Sources="@(HlslSource)" WpfEffects="@(WpfEffectSource)" OutputDirectory="$(HlslOutput)" />
    <Touch Files="$(HlslOutput)shaders.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedShaders" AfterTargets="CompileShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_CompiledShader Include="$(HlslOutput)*.cso;$(HlslOutput)*.ps" />
      <EmbeddedResource Include="@(_CompiledShader)" LogicalName="HandPegApp.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!--
      The Explorer thumbnail handler (Pass 5.2D, src\ShellThumbnails; NativeAOT since Pass 5.3-Stage2): a native COM library that Windows
      Explorer loads to show the thumbnail a .hproj or .hpb carries as its preview, with no .NET needed. No part of HandPeg's assembly and
      no reference of it (Explorer loads it alone): published after HandPeg for the same processor (the runtime being built, else this
      machine's: an ARM64 Explorer loads only an ARM64 handler), by a Release build or publish only (a Debug build stays quick and has
      none), and only where Visual Studio's C++ build tools for that processor are (NativeAOT links with them; without them a message
      says so and the build goes on without the handler; Release.ps1 refuses a release without it). Its one file is copied into shell\
      beside HandPeg.exe, and again on a publish; ExplorerThumbnails registers it from there. It is published by a dotnet of its own,
      the command at the top of its project, self-contained, into its own bin\: an MSBuild task here would restore it and publish it in one build, whose
      publish could keep what it read before the restore (measured: a plain .NET publish, no native DLL, in shell\), and would hand it this
      build's own properties ("dotnet publish -o" and "self-contained false" reach every project a build builds). The four files of
      5.3-Stage1's .NET COM host that an older build left in shell\ go on every build.
  -->
  <PropertyGroup>
    <ShellThumbnailsProject>$(MSBuildThisFileDirectory)src\ShellThumbnails\HandPeg.ShellThumbnails.csproj</ShellThumbnailsProject>
  </PropertyGroup>

  <Target Name="BuildShellThumbnails" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(ShellThumbnailsProject)')">
    <PropertyGroup>
      <_ShellThumbnailsRid>$(RuntimeIdentifier)</_ShellThumbnailsRid>
      <_ShellThumbnailsRid Condition="'$(_ShellThumbnailsRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_ShellThumbnailsRid>
      <_ShellThumbnailsDotnet>$(DOTNET_HOST_PATH)</_ShellThumbnailsDotnet>
      <_ShellThumbnailsDotnet Condition="'$(_ShellThumbnailsDotnet)' == ''">dotnet</_ShellThumbnailsDotnet>
      <_ShellThumbnailsDll>$(MSBuildThisFileDirectory)src\ShellThumbnails\bin\Release\net10.0-windows\$(_ShellThumbnailsRid)\publish\HandPeg.ShellThumbnails.dll</_ShellThumbnailsDll>
      <_ShellThumbnailsVsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_ShellThumbnailsVsWhere>
      <!-- The C++ tools NativeAOT's own lookup asks for (ILCompiler's findvcvarsall.bat): the target processor's. -->
      <_ShellThumbnailsVcTools>x86.x64</_ShellThumbnailsVcTools>
      <_ShellThumbnailsVcTools Condition="'$(_ShellThumbnailsRid)' == 'win-arm64'">ARM64</_ShellThumbnailsVcTools>
    </PropertyGroup>

    <ItemGroup>
      <_ShellThumbnailsStale Include="$(OutDir)shell\HandPeg.ShellThumbnails.comhost.dll;$(OutDir)shell\HandPeg.ShellThumbnails.runtimeconfig.json;$(OutDir)shell\HandPeg.ShellThumbnails.deps.json" />
      <_ShellThumbnailsStale Include="$(OutDir)shell\HandPeg.ShellThumbnails.dll" Condition="Exists('$(OutDir)shell\HandPeg.ShellThumbnails.comhost.dll')" />
    </ItemGroup>
    <Delete Files="@(_ShellThumbnailsStale)" />

    <Exec Condition="'$(Configuration)' == 'Release' and Exists('$(_ShellThumbnailsVsWhere)')" EchoOff="true" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low"
          Command="&quot;$(_ShellThumbnailsVsWhere)&quot; -latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.$(_ShellThumbnailsVcTools) -property installationPath">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ShellThumbnailsVs" />
    </Exec>
    <Message Condition="'$(Configuration)' == 'Release' and '$(_ShellThumbnailsVs)' == ''" Importance="high"
             Text="No Visual Studio C++ build tools for $(_ShellThumbnailsRid): the Explorer thumbnail handler (NativeAOT) is not built, so this build has no shell\HandPeg.ShellThumbnails.dll." />
    <Exec Condition="'$(Configuration)' == 'Release' and '$(_ShellThumbnailsVs)' != ''"
          Command="&quot;$(_ShellThumbnailsDotnet)&quot; publish &quot;$(ShellThumbnailsProject)&quot; -c Release -r $(_ShellThumbnailsRid) --self-contained -nologo -v:q -nr:false" />
    <Copy Condition="'$(Configuration)' == 'Release' and '$(_ShellThumbnailsVs)' != ''" SourceFiles="$(_ShellThumbnailsDll)" DestinationFolder="$(OutDir)shell\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishShellThumbnails" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(OutDir)shell\HandPeg.ShellThumbnails.dll')">
    <Copy SourceFiles="$(OutDir)shell\HandPeg.ShellThumbnails.dll" DestinationFolder="$(PublishDir)shell\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
