<Window x:Class="HandPegApp.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        Title="Welcome to HandPeg" Width="820" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- A mode as a large card: outlined in the accent colour while it is the one chosen. -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="card" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="18,16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <!-- Scrolls on a screen too short for all of it; the window is never taller than the work area. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24">
        <TextBlock Text="Welcome to HandPeg" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18"
                   Text="Two choices before you start. Both can be changed later in Settings, one option at a time." />

        <!-- Appearance and fallback -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="ThemeBox" MinWidth="170" Margin="0" SelectionChanged="ThemeBox_SelectionChanged" AutomationProperties.Name="Theme"
                      ToolTip="Dark, light, or whichever Windows is set to. The window changes at once so you can see it." />
            <CheckBox x:Name="FallbackBox" Content="Allow software encoding fallback" Margin="32,0,0,0"
                      ToolTip="If an encode fails on a hardware encoder (NVENC, QuickSync, AMF), try once more with the matching software encoder." />
        </StackPanel>

        <!-- The core choice -->
        <TextBlock Text="How will you use HandPeg?" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="EncoderCard" GroupName="Mode" Style="{StaticResource ModeCard}" IsChecked="True" AutomationProperties.Name="Encoder Mode">
                <StackPanel>
                    <TextBlock Text="Encoder Mode" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardText}"
                               Text="A lean front end for converting and trimming files. A slim timeline, the preset bar at the top of the window, and the standard lightweight defaults." />
                    <TextBlock Style="{StaticResource CardText}" Margin="0,10,0,0"
                               Text="Timeline height 1  ·  presets above the tabs  ·  no waveforms, hover previews or advanced tabs" />
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" x:Name="EditorCard" GroupName="Mode" Style="{StaticResource ModeCard}" AutomationProperties.Name="Editor Mode">
                <StackPanel>
                    <TextBlock Text="Editor Mode" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardText}"
                               Text="The tools for cutting, captioning and laying out a video. A tall timeline with the waveform, the full transport row, and the preset bar in the Summary tab." />
                    <TextBlock Style="{StaticResource CardText}" Margin="0,10,0,0"
                               Text="Timeline height 5  ·  advanced filters  ·  waveform  ·  keyframe and frame stepping  ·  play only cut segments  ·  snapping  ·  hover previews every second  ·  8 s previews at 50%  ·  auto-captions  ·  chapters at cuts  ·  layout pane" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- The tools: nothing ships with HandPeg, so this is where they are fetched -->
        <TextBlock Text="Dependencies" FontWeight="SemiBold" Margin="0,20,0,2" />
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="HandPeg drives these tools and downloads them on request. FFmpeg is needed for everything; yt-dlp for loading a web address; whisper.cpp and a speech model for auto-captions. This can also be done later, in Settings." />
        <local:DependencyPanel x:Name="Dependencies" OffersExistingFfmpeg="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="StartButton" Content="Start HandPeg" MinWidth="140" Padding="18,8" IsDefault="True" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
