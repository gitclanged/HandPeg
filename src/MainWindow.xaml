<Window x:Class="HandPegApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HandPegApp.ViewModels"
        xmlns:local="clr-namespace:HandPegApp"
        xmlns:models="clr-namespace:HandPegApp.Models"
        xmlns:views="clr-namespace:HandPegApp.Views"
        xmlns:docking="clr-namespace:HandPegApp.Docking"
        xmlns:services="clr-namespace:HandPegApp.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="HandPeg" Height="1030" Width="1280" MinHeight="800" MinWidth="1100"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <!-- Carries encode progress on the taskbar button. Its state is None until an encode sets it. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>
    <!--
        Saving, like every other shortcut, is the keybind manager's (Services/KeybindManager.cs, answered in the window's
        PreviewKeyDown, 4.4): bound here as well, a rebound Save would leave Ctrl+S saving still.
    -->
    <Window.Resources>
        <!-- A deleted clip in the recycle bin: a picture of it, what it was and when it was on, and the way back. -->
        <DataTemplate x:Key="BinItemTemplate">
            <Grid Margin="0,3" Width="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InsetBrush}" CornerRadius="3" Height="34" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Restore" Padding="10,3" VerticalAlignment="Center" Click="RestoreDeleted_Click"
                        ToolTip="Puts this clip back on the timeline where it was." />
            </Grid>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
        <local:FractionToOffsetConverter x:Key="FractionToOffset" />
        <local:EncoderPresetLabelConverter x:Key="EncoderPresetLabel" />
        <local:DecibelToScaleConverter x:Key="DecibelToScale" />

        <!-- The parts of a slider's track either side of the thumb: there to be clicked, not seen. -->
        <Style x:Key="BareRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The timeline's scrubber: no track of its own (the waveform, I-frame lines and segment bar behind it
            are the track), and a playhead that is an arrow pointing down with a line dropping to the bar.
            The thumb is 11 wide, which the code that places the hover preview and the segment marks relies on.
        -->
        <Style x:Key="TimelineSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource BareRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BareRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource TextBrush}" />
                                                    <Path Data="M0,0 L11,0 L5.5,9 Z" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="0.75" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The Export Presets selector (5.4B: the encoding presets and the 1-click social cards of before, one system): the built-ins grouped
            "Platform & Social" and "Studio & Archive", then the user's own ("My Presets"), each with its one line as a tool tip; picking one
            sets the export's settings only (never the view's current item: a list view would pick its first preset as the tab is made). Shown
            in the Export tab's first card or above the tabs, as set in Settings (PresetBarFrame there).
        -->
        <DataTemplate x:Key="PresetBar">
            <StackPanel>
                <ComboBox Margin="0,4" ItemsSource="{Binding PresetsView}" SelectedItem="{Binding SelectedPreset}" IsSynchronizedWithCurrentItem="False" MinWidth="220"
                          AutomationProperties.Name="Export Presets"
                          ToolTip="Export Presets: picking one sets the export's size, frame rate, encoder, quality or bitrate, sound and format for a platform or a studio use. The layout, the looks and the captions stay as they are (Game Presets set those).">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="6,8,6,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Detail}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Margin="0,4">
                    <Button Content="+ Save Current as Preset..." Margin="0,0,6,4" Padding="10,3" Click="SaveCurrentPreset_Click"
                            AutomationProperties.Name="Save Current as Preset"
                            ToolTip="Saves the export settings as they are now to My Presets under a name you type. A built-in preset's name is kept for it: the copy is saved as its name with (Custom)." />
                    <Button Content="Import / Export Preset..." Margin="0,0,0,4" Padding="10,3" Click="ManagePresets_Click"
                            AutomationProperties.Name="Manage Export Presets"
                            ToolTip="Brings a preset in from a .hppreset file, or saves the settings as they are now to one, to use on another PC." />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The selector as a pane of its own above the tabs (Settings: Preset Bar at the top of the window). -->
        <DataTemplate x:Key="PresetBarFrame">
            <Border Style="{StaticResource Panel}" Padding="12,6">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetBar}" Focusable="False" />
            </Border>
        </DataTemplate>

        <!-- The handle on a clip's corner, dragged to resize it. Drawn by ResizeAdorner. -->
        <Style x:Key="LayerGrip" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" BorderBrush="#FF0078D7" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- The caption box as it is dragged around the frame. -->
        <Style x:Key="CaptionThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border IsHitTestVisible="False" Background="#B0C08020" BorderBrush="#FFFFC060" BorderThickness="1">
                            <TextBlock Text="Subtitles" Foreground="White" FontSize="11" Margin="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A clip (a video, a Cutout, an image) as it is dragged around the frame: a tinted box carrying its name. -->
        <Style x:Key="LayerThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border IsHitTestVisible="False" Background="#990078D7" BorderBrush="White" BorderThickness="1">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" Margin="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A clip's box over the player (Edit Clips on Video Preview, 4.1.1-B): nearly see-through, so it takes the click;
            outlined in the accent only while it is the selected clip (its BorderThickness, set from code).
        -->
        <Style x:Key="PlayerLayerThumb" TargetType="Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border IsHitTestVisible="False" Background="#01000000" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play while paused, pause while playing: one button whose symbol follows the player. -->
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="local:KeyTip.Action" Value="transport.playPause" />
            <Setter Property="local:KeyTip.Text" Value="Play{keys}" />
            <Setter Property="AutomationProperties.Name" Value="Play" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="local:KeyTip.Text" Value="Pause{keys}" />
                    <Setter Property="AutomationProperties.Name" Value="Pause" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The other buttons of the transport row -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!--
            A button that is the right end of a text box: laid over the box, as tall as the inside of it and
            against the inside of its right border, with that end's corners rounded as the box's are (the box's
            are 4, so one pixel in they are 3) and the other end square.
        -->
        <Style x:Key="InFieldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1,1,1" />
            <Setter Property="Padding" Value="8,0" />
            <!--
                Part of the field, not a button set into it (4.2D): no edge or bevel, the field's own well showing through at
                rest, a faint fill under the pointer, the field's text colour; Reno's dotted rectangle when it has the keyboard.
            -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:ButtonChrome x:Name="border" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="0,3,3,0"
                                            Padding="{TemplateBinding Padding}" DottedInset="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="DottedOutlineBrush" Value="{DynamicResource DottedFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row of a header flyout's menu (Settings, Layout): its words start at the left, where the ordinary button would put them in the middle. -->
        <Style x:Key="FlyoutRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The title bar's caption buttons (CaptionButton, CaptionCloseButton) are styled in App.xaml since 4.4: the Settings screen draws the same title bar. -->

        <!-- A section of the Export tab (Video, Audio): a word, underlined in the active tab's trace while it is the one shown. -->
        <Style x:Key="ExportSectionButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="10,4,10,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="box" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" />
                                <Border x:Name="line" Height="2" CornerRadius="1" Margin="0,0,0,-5" VerticalAlignment="Bottom" Background="{DynamicResource ActiveTabTraceBrush}" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="line" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            An inspector card (5.4B, CLAUDE.md 10.3: the Export tab's three columns): a dark surface with a hairline edge, 6 px corners and
            12 px inside; its rows are 8 px apart (each a margin of 4 above and below). The brushes are the theme's (ThemeManager, App.xaml).
        -->
        <Style x:Key="ExportCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InspectorCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InspectorCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- A card's title: the first row, in its group's words. -->
        <Style x:Key="ExportCardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A card of the Layout Selector: a small picture of a layout's panes and its name; edged while pointed at, and traced in the chosen edge (SelectedBorderBrush) while it is the layout or theme in use (Tag "active"). -->
        <Style x:Key="LayoutCard" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,6,6,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            5.4D: a pill at the top right of a layout card's picture (MakeLayoutCards): "★ Default" on the layout HandPeg opens in (Tag
            "default", in the chosen edge's colour, always shown), "☆ Set Default" on the others and "×" on the user's own, shown while the
            card is pointed at or has the keyboard.
        -->
        <Style x:Key="LayoutPill" TargetType="Button">
            <Setter Property="Padding" Value="7,1,7,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="default">
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window drawn by HandPeg (Pass 4.1B): its own title bar over the content, Windows' frame, shadow and snapping kept. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource CaptionBarHeight}" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <DockPanel x:Name="ChromeRoot">
    <!--
        The title bar (WindowChrome, 26 px since 5.3-Stage2: CaptionBarHeight in App.xaml, which the Settings screen's bar shares):
        HandPeg's name at the left, the caption buttons at the right (Maximize answers
        as Windows' own, so Snap Layouts open from it: TitleBarHook). It carries the status at its middle (dimmed) and the
        progress of the work under way as a dim fill across its whole height, status bar or none (4.1.1); resting on
        the status opens the work flyout, a right-click on it brings the status bar back. Dragging anywhere else moves the
        window; a double-click maximizes it.
    -->
    <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="{StaticResource CaptionBarHeight}" Background="{DynamicResource TitleBarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 5.4D: over the project tabs (ZIndex 10, never hit): a 16% wash across the bar and a 2 DIP accent rail along its foot (MainWindow.TitleBar.cs). -->
        <Canvas x:Name="TitleProgress" Grid.ColumnSpan="3" Panel.ZIndex="10" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
            <Rectangle x:Name="TitleProgressFill" Height="{StaticResource CaptionBarHeight}" Width="0" Fill="{DynamicResource AccentBrush}" Opacity="0.16" />
            <Rectangle x:Name="TitleProgressRail" Canvas.Left="0" Canvas.Bottom="0" Height="2" Width="0" Fill="{DynamicResource AccentBrush}" />
        </Canvas>
        <TextBlock x:Name="TitleText" Text="HandPeg" Margin="14,0,12,0" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False" />
        <!-- 5.4A: the project tabs, browser-style ([ • Name × ] [ + ]): each tab and + take their clicks, the rest stays the caption (MainWindow.ProjectTabs.cs). -->
        <local:ProjectTabStrip x:Name="ProjectTabStrip" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
        <!-- 5.4C: placed by MainWindow.PlaceTitleStatus (its left margin and width): centred while it fits, pushed right by the tabs. -->
        <Border x:Name="TitleStatus" Grid.ColumnSpan="3" HorizontalAlignment="Left" Background="Transparent" Padding="12,0" Visibility="Collapsed"
                WindowChrome.IsHitTestVisibleInChrome="True" MouseEnter="WorkChip_MouseEnter" MouseLeave="WorkFlyout_MouseLeave"
                AutomationProperties.Name="Status" AutomationProperties.AutomationId="TitleStatus">
            <TextBlock x:Name="TitleStatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <StackPanel x:Name="TitleRight" Grid.Column="2" Orientation="Horizontal">
            <!-- 5.0-Core: shown for a few seconds after the GPU compositor came back from a crash or a lost device (CompositorClient.EngineRecovered). -->
            <StackPanel x:Name="EngineRecoveredBadge" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.7" Visibility="Collapsed"
                        Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Preview engine recovered">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                <TextBlock x:Name="EngineRecoveredText" Text="Preview engine recovered" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Each takes its own clicks in the title bar (also set by their style): found in real pixels, under any UI scale (MainWindow.TitleBar.cs, FrameHitTest). -->
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeWindow_Click" AutomationProperties.Name="Maximize" ToolTip="Maximize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CloseWindow_Click" AutomationProperties.Name="Close" ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
    </Grid>

    <!--
        The window's body, edge to edge at its sides and foot in every state (5.3-Stage2, the user's call: no dead band round the
        panes), with 6 under the title bar (the user's call after seeing it flush: the Header's buttons touched the caption buttons
        and read as overlapping them; 6 is the gap between the Header's own buttons). A restored window keeps its resize edges:
        Windows' resize band over the content goes to the frame (FrameHitTest), the player's native window lets it through
        (VideoSurface) and the rows' scroll bar keeps its clicks (IsHitTestVisibleInChrome).
    -->
    <Grid x:Name="ContentRoot" Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- The panes (MainDockHost), between the top bar and the bottom bar. -->
            <RowDefinition Height="*" MinHeight="400" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 is empty since 4.2: Encoder Mode's top bar was there (HandPeg Encoder has it now). -->

        <!--
            The work flyout (resting on the progress chip, or on the status in the title bar while the status bar is hidden:
            WorkChip_MouseEnter places it): every piece of work under way, its progress and cancel, the lanes' pause switches.
        -->
        <Popup x:Name="WorkFlyout" DataContext="{x:Static services:WorkScheduler.Summary}" PlacementTarget="{Binding ElementName=WorkChip}" Placement="Top" AllowsTransparency="True" StaysOpen="True">
            <local:ButtonChrome x:Name="WorkFlyoutPanel" Style="{StaticResource FlyoutChrome}" Padding="10,8" Margin="0,0,0,4" MinWidth="380" MaxWidth="520" MouseLeave="WorkFlyout_MouseLeave">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open Queue" Padding="10,2" Click="WorkFlyoutQueue_Click"
                                ToolTip="The batch queue: encodes waiting to run one after another." />
                        <TextBlock Text="Work in progress" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="Pause:" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ToggleButton x:Name="PauseBackgroundToggle" Content="Background" Padding="10,2" Tag="Background" Click="LanePause_Click"
                                      ToolTip="Thumbnails, waveforms, I-frame lists and proxies wait to start until this is switched off. Work already running carries on." />
                        <ToggleButton x:Name="PauseIdleToggle" Content="Idle" Padding="10,2" Margin="6,0,0,0" Tag="Idle" Click="LanePause_Click"
                                      ToolTip="Folder indexing, cache clean-ups and other quiet-time work wait to start until this is switched off." />
                    </StackPanel>
                    <TextBlock Text="{Binding PausedNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,2" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PausedNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{x:Static services:WorkScheduler.Items}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:WorkItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Height="6" Margin="0,3,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6,4" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Click="WorkItemCancel_Click" ToolTip="Cancel this" AutomationProperties.Name="Cancel"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </local:ButtonChrome>
        </Popup>

        <!--
            The Views menu: which panes are open and where each of them is. Opened by the Views button of the
            transport row; it is placed beside it from code (see PlaceViewsPopup). It takes no room here.
        -->
        <Popup x:Name="ViewsPopup" StaysOpen="False"
               AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=ViewsButton, Mode=TwoWay}"
               Opened="ViewsPopup_Opened" Closed="ViewsPopup_Closed">
            <local:ButtonChrome Style="{StaticResource FlyoutChrome}" Padding="12,10">
                <StackPanel TextElement.Foreground="{DynamicResource TextBrush}" MinWidth="250">
                    <!-- The timeline's checkboxes, always here since 5.3-Stage2 (the playback bar no longer carries them; Timeline Settings has
                         them too). One Timeline section since 5.4C (the user's: it was two, above and below the lists). -->
                    <StackPanel x:Name="ViewsPlaybackOptions" Margin="0,0,0,8">
                        <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox Content="Snap cuts to I-frames" IsChecked="{Binding SnapToIFrames}" Margin="0,2"
                                  ToolTip="Splits move onto the I-frames of the video clip they cut, which is what a stream copy needs to cut without encoding." />
                        <CheckBox Content="Show I-frames" IsChecked="{Binding ShowIFrames}" Margin="0,2"
                                  ToolTip="Draws a thin line on the timeline at every I-frame." />
                        <CheckBox Content="Keyframe diamonds on clips" IsChecked="{Binding ShowClipKeyframes}" Margin="0,2"
                                  ToolTip="Draws a diamond on a clip's block at each of its keyframes." />
                        <CheckBox Content="Sync Sequence Overview Scrubber Stretch" IsChecked="{Binding SyncMasterTimeline}" Margin="0,2" AutomationProperties.Name="Sync Sequence Overview Scrubber Stretch"
                                  ToolTip="The timeline is zoomed with Ctrl + wheel and moved along with Shift + wheel or a middle-button drag. On: the Sequence Overview Scrubber is stretched and moved with it. Off: it always shows the whole sequence." />
                    </StackPanel>
                    <!--
                        Tabs and Panes (Pass 4.1B): every settings tab and every pane this mode has, each shown or hidden for
                        this mode alone; made each time the menu opens (MainWindow.Export.cs, TabsAndPanes), the same list a
                        tab's right-click menu has. 5.4C: each list under its own heading, the panes in two columns (they are
                        twice as many as the tabs, and more with the studios), so the three columns come out even.
                    -->
                    <TextBlock Text="Tabs and Panes" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tabs" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2" />
                        <TextBlock Grid.Column="1" Text="Panes" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2" />
                        <StackPanel Grid.Row="1" x:Name="ViewsTabList" Margin="0,0,24,0" VerticalAlignment="Top" AutomationProperties.Name="Tabs" />
                        <UniformGrid Grid.Row="1" Grid.Column="1" x:Name="ViewsPaneList" Columns="2" VerticalAlignment="Top" AutomationProperties.Name="Panes" />
                    </Grid>
                    <!-- Where the panes are: moved by dragging their tabs; this puts them back. -->
                    <TextBlock Text="Arrange" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"
                               Text="Drag a pane by its tab (its title, or the tab that comes up when the pointer rests on its top-left corner) onto another pane, to a side of one, or out of the window into a side window of its own. The borders between panes are dragged to resize them." />
                    <Button Content="Reset Panes Layout" Click="ResetPanesLayout_Click" Padding="10,4" Margin="0,8,0,0" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Reset Panes Layout"
                            ToolTip="Puts every pane back where your Default layout (★ in the Layout Selector; Standard Editing unless you chose another) has it, at the size it starts with, and closes the Pane Dockers." />
                </StackPanel>
            </local:ButtonChrome>
        </Popup>

        <!--
            The Layout Selector (resting on the Layout button or a click on it, Pass 4.1B: HoverFlyout; 5.4D: the one Layout UI, the click's
            menu retired): a card for each built-in layout and each of the user's own, a small picture of its panes drawn when it opens
            (DockManager.Miniature) with its pill ("★ Default" on the layout HandPeg opens in, "☆ Set Default" and, on the user's own, "×"),
            four to a row; under them the Themes row, as wide; and the footer: each project tab's own layout, the side windows and Save
            Current Layout. While the pointer (or the keyboard) is on a layout card the window takes that layout (the player only moves: it
            floats over its place); on a theme card every window takes that theme. A click keeps it; leaving the cards (the pointer, or the
            keyboard), Escape, the window deactivated or the pointer gone from the selector and the button puts things back as they were.
            Placed once, where it opened, so it stays put while the window changes under it (PlaceLayoutSelector). Reset Layout is in the
            Views menu only (one home per control).
        -->
        <Popup x:Name="LayoutSelector" AllowsTransparency="True" StaysOpen="True" Closed="LayoutSelector_Closed">
            <local:ButtonChrome x:Name="LayoutSelectorPanel" Style="{StaticResource FlyoutChrome}" Padding="10,8,10,10"
                    KeyDown="LayoutSelector_KeyDown" TextElement.Foreground="{DynamicResource TextBrush}">
                <StackPanel Width="776">
                    <DockPanel Margin="4,0,4,6">
                        <TextBlock DockPanel.Dock="Right" Text="Point at one to see it; click to keep it; ★ is where HandPeg opens" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Text="Layouts" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel x:Name="LayoutCards" Width="776" Background="Transparent" MouseLeave="LayoutCards_MouseLeave"
                               IsKeyboardFocusWithinChanged="LayoutCards_IsKeyboardFocusWithinChanged" AutomationProperties.Name="Layouts" />
                    <TextBlock Text="Themes" FontWeight="SemiBold" Margin="4,8,4,4" />
                    <UniformGrid x:Name="ThemeCards" Rows="1" Width="776" Background="Transparent" MouseLeave="ThemeCards_MouseLeave" AutomationProperties.Name="Themes" />
                    <!--
                        5.4D: the footer, a card (CLAUDE.md 10.3): each project tab's own layout, a new side window and a row for each one open
                        (made in code: UpdateSideWindowCheck), and Save Current Layout.
                    -->
                    <Border x:Name="LayoutFooter" Margin="4,10,4,0" Padding="12" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource InspectorCardBrush}" BorderBrush="{DynamicResource InspectorCardBorderBrush}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save Current Layout..." Click="SaveCurrentLayout_Click" Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="Save Current Layout"
                                        ToolTip="Keeps the panes as they are now as a layout of your own, in one of three places: name it, or write over one kept before. It joins the cards above." />
                                <Button DockPanel.Dock="Right" Content="+ New Side Window" Click="SideWindowRow_Click" Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="New Side Window"
                                        ToolTip="A new side window, to put on another monitor: a live view of the player to start with, or (its title bar's choice) a Pane Docker that holds any panes. Drag any pane's tab out of the window to put it in a new one." />
                                <CheckBox x:Name="PerTabLayoutsBox" Content="Each project tab remembers its own layout" VerticalAlignment="Center" Click="PerTabLayoutsBox_Click"
                                          AutomationProperties.Name="Each project tab remembers its own layout"
                                          ToolTip="On: each project tab keeps the window's layout it was left in, and takes it back when brought to the front. Off: every tab shares one layout. (Also in Settings.)" />
                                <CheckBox x:Name="RestoreWorkspaceBox" Content="Projects open in their saved window" VerticalAlignment="Center" Click="RestoreWorkspaceBox_Click" Margin="12,0,0,0"
                                          AutomationProperties.Name="Projects open in their saved window"
                                          ToolTip="On: a project opens in the window it was saved in (the layout, the Media Browser's view and the 3D camera). Off: it opens in the window as it is. (Also in Settings.)" />
                            </DockPanel>
                            <StackPanel x:Name="SideWindowRows" AutomationProperties.Name="Side Windows">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlyoutRowButton}" />
                                </StackPanel.Resources>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </local:ButtonChrome>
        </Popup>




        <!--
            The panes: the player, the playback controls, the timeline, the Sequence Overview Scrubber, the layout, the side panes and the
            settings tabs, each where the arrangement of this mode puts it (Docking/DockManager.cs): in this
            window, or in the side window. Each is made here, in the library below, which is never shown, and
            taken from there into its place when the window is laid out. A pane's tab is its title, where its
            title was (a PaneTitleSlot); a pane with no title has one that comes up over its top-left corner.
        -->
        <ContentControl Grid.Row="1" Grid.RowSpan="3" x:Name="MainDockHost" Focusable="False" />

        <Grid x:Name="PaneLibrary" Visibility="Collapsed">
        <Grid x:Name="PlayerPane" MinWidth="320" MinHeight="180">
            <!-- Video player -->
            <local:ButtonChrome x:Name="VideoBorder" Background="Black" BorderBrush="{DynamicResource WellBorderBrush}" LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" BorderThickness="1" OutlineTakesRoom="True">
                <!-- Hidden until a video and a player are there (UpdateVideoVisibility): the first frame already has the drop hint. -->
                <local:VideoSurface x:Name="VideoView" Visibility="Hidden">
                    <!--
                        Drawn in the transparent window the surface keeps above the video, which is how WPF content
                        can appear over the native video window. The crop canvas is only present while Interactive
                        Crop is on; its faint fill is what lets it receive the mouse (fully transparent pixels let clicks through).
                    -->
                    <!--
                        Files dropped anywhere on it go to the window's own drop handling (4.3E): over a clip's box, the selected
                        clip's handles (in the adorner layer, beside the boxes' canvas) or the crop, a drop on the video lands as
                        it does anywhere else on the window.
                    -->
                    <Grid x:Name="PlayerOverlay" AllowDrop="True" DragEnter="DropHint_DragOver" DragOver="DropHint_DragOver" Drop="Window_Drop">
                        <AdornerDecorator ClipToBounds="True">
                            <Canvas x:Name="CropCanvas" Background="#01000000" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                                    MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown" MouseMove="CropCanvas_MouseMove"
                                    MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp" SizeChanged="CropCanvas_SizeChanged">
                                <Rectangle x:Name="CropRectangle" Stroke="Red" StrokeThickness="2" Fill="#18FF0000" IsHitTestVisible="False" />
                            </Canvas>
                        </AdornerDecorator>
                        <!--
                            Edit Clips on Video Preview (4.1.1-B, MainWindow.PlayerLayout.cs): a box per clip on screen, nearly
                            see-through so a click on a clip selects it; only the selected one is outlined and has the handles.
                            The canvas itself takes clicks only while an outline shows, so a click elsewhere on the video hides it.
                        -->
                        <AdornerDecorator ClipToBounds="True">
                            <Canvas x:Name="PlayerLayoutCanvas" Visibility="Collapsed" ClipToBounds="True" SizeChanged="PlayerLayoutCanvas_SizeChanged"
                                    MouseLeftButtonDown="PlayerLayoutCanvas_MouseLeftButtonDown" />
                        </AdornerDecorator>
                        <!-- Safe Margins: the action-safe (90%) and title-safe (80%) areas of the picture as it is shown. Placed from code. -->
                        <Canvas x:Name="SafeMarginsCanvas" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="SafeMarginsCanvas_SizeChanged">
                            <Rectangle x:Name="ActionSafeRectangle" Stroke="#B0FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" />
                            <Rectangle x:Name="TitleSafeRectangle" Stroke="#B0FFD54F" StrokeThickness="1" StrokeDashArray="4 3" />
                        </Canvas>
                        <!--
                            The 3D Exploded View (5.0D, MainWindow.Exploded.cs). Off, it is see-through and takes nothing, so the boxes,
                            the crop and the handles under it work as before. On, its faint fill takes every press on the video (picking,
                            moving and orbiting), the layers' label badges float over their planes, and the panel holds the Z-Spacing slider.
                        -->
                        <Grid x:Name="ExplodedLayer" IsHitTestVisible="False" Loaded="ExplodedLayer_Loaded">
                            <Canvas x:Name="ExplodedBadges" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Border x:Name="ExplodedPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                    Background="#D80E1014" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,5,6,6"
                                    TextElement.Foreground="#E6FFFFFF" AutomationProperties.Name="3D Exploded View Controls">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="3D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Z-Spacing" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                                        <Slider x:Name="ExplodedSpacing" Width="120" Margin="8,0,6,0" VerticalAlignment="Center" Minimum="0.02" Maximum="0.6" Value="0.16"
                                                SmallChange="0.01" LargeChange="0.05" ValueChanged="ExplodedSpacing_ValueChanged" AutomationProperties.Name="Z-Spacing"
                                                ToolTip="Z-Spacing: how far apart the layers' planes are, from almost touching to more than half the frame's width." />
                                        <Button Style="{StaticResource TransportButton}" Content="&#xE72C;" Padding="7,4" Margin="2,0" Click="ExplodedReset_Click"
                                                ToolTip="Reset the camera: the starting turn and distance (double-click the empty space does the same)." AutomationProperties.Name="Reset 3D Camera" />
                                        <Button Style="{StaticResource TransportButton}" Content="&#xE711;" Padding="7,4" Margin="2,0" Click="ExplodedClose_Click"
                                                ToolTip="Back to the flat picture (Esc)." AutomationProperties.Name="Leave 3D Exploded View" />
                                    </StackPanel>
                                    <!-- The view's keys and gestures (5.3-Stage3): a pinch zooms, two fingers orbit, Alt + the wheel picks the layers. -->
                                    <TextBlock FontSize="10.5" Foreground="#90FFFFFF" Margin="0,3,0,0" LineHeight="14" AutomationProperties.Name="3D View Hints">
                                        <Run Text="Drag: move  &#x00B7;  Shift + drag: through the stack  &#x00B7;  Esc: back" /><LineBreak />
                                        <Run Text="Right-drag, two-finger scroll or a finger: orbit  &#x00B7;  Wheel or pinch: zoom" /><LineBreak />
                                        <Run Text="Alt + wheel or [ ]: the layer in front or behind  &#x00B7;  Shift + wheel: spacing" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </local:VideoSurface>
            </local:ButtonChrome>
            <!--
                Shown while no video is loaded, and solid. Ordinary content of the pane, not of the window kept over
                the video: while it shows, the video surface is hidden (see UpdateVideoVisibility), so it belongs to
                whichever window holds the player and keeps that window's place among the others. Files and links
                dropped on it go to the main window's own drop handling; a click opens Browse. No outline round it
                (5.3-Stage3, the user's call): the icon and the words on the dark surface.
            -->
            <Grid x:Name="DropHint" Background="#FF0E0E0E" AllowDrop="True" Cursor="Hand" Margin="{DynamicResource WellEdgeThickness}"
                  DragEnter="DropHint_DragOver" DragOver="DropHint_DragOver" Drop="Window_Drop" MouseLeftButtonUp="DropHint_MouseLeftButtonUp"
                  AutomationProperties.Name="Drag and Drop Files or Links">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource DropFileOrLinkIcon}" Width="58" Height="54" Stretch="Uniform" Stroke="#88FFFFFF" StrokeThickness="2.2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag &amp; Drop Files or Links" FontSize="26" FontWeight="SemiBold" Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="or click to browse, or paste a path or URL into the source box" FontSize="13" Foreground="#77FFFFFF"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <!-- Shown while the GPU preview is stopped (MainWindow.OnGpuFailed): says why, and what happens next, in the empty space -->
            <Border x:Name="EngineNotice" Visibility="Collapsed" Background="#F0101010" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock x:Name="EngineNoticeTitle" Text="GPU Preview Stopped" FontSize="22" FontWeight="SemiBold" Foreground="#DDFFFFFF" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="EngineProgress" Height="8" Width="320" Margin="0,14,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                    <TextBlock x:Name="EngineNoticeText" FontSize="13" Foreground="#99FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="Engine Notice" />
                </StackPanel>
            </Border>
        </Grid>
            <!--
                Advanced transport, centred under the player when switched on in Settings:
                previous I-frame, back one frame, play/pause, forward one frame, next I-frame.
            -->
            <local:PlaybackRow Grid.Row="1" x:Name="TransportRow" Margin="0">
                <!-- The buttons sit in the middle while there is room; in a narrow player they give way to the volume -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--
                    The Views button at the left of the row. The timeline's I-frame checkboxes that followed it are gone from the row
                    (5.3-Stage2, the user's de-clutter): they are in the Views menu and in Timeline Settings. Not filling the column,
                    so the button keeps its own width.
                -->
                <DockPanel x:Name="TimelineOptionsBar" Margin="0,0,10,0" LastChildFill="False" IsVisibleChanged="TimelineOptionsBar_IsVisibleChanged">
                    <!-- Views: the panes and the timeline's I-frame checkboxes. Its icon is geometry: an eye. -->
                    <ToggleButton x:Name="ViewsButton" DockPanel.Dock="Left" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Views"
                                  ToolTip="Views: show or hide the tabs and the Canvas, Media, Keyframes and Effects panes, put the panes back where they started, and the timeline's I-frame checkboxes.">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="12" Stretch="None" VerticalAlignment="Center" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M 1,6 C 4,1 14,1 17,6 C 14,11 4,11 1,6 Z M 11.5,6 A 2.5,2.5 0 1 1 6.5,6 A 2.5,2.5 0 1 1 11.5,6 Z" />
                            <TextBlock Text="Views" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <!--
                        The progress chip (5.4.1-M5: on the transport row since the status bar was retired): the work under way, the lead piece of it
                        shown, and how many more. While the pointer rests on it, a flyout lists them all, each with its own progress and a cancel
                        button, with the lanes' pause switches. See WorkScheduler.
                    -->
                    <Grid x:Name="WorkChip" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent"
                          DataContext="{x:Static services:WorkScheduler.Summary}" AutomationProperties.Name="Work in Progress"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                          MouseEnter="WorkChip_MouseEnter" MouseLeave="WorkFlyout_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBackground}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ProgressBar Width="80" Height="10" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                         Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                            <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PercentText}" Margin="6,0,0,0" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="6,0" CornerRadius="7" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoreText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MoreText}" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <!-- A newer HandPeg: found (Update downloads it, then restarts into it) or already downloaded (Restart to update). -->
                    <StackPanel x:Name="UpdateNotice" DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="UpdateNoticeText" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="UpdateActionButton" Content="Update" Margin="8,0,0,0" Padding="12,3" Click="UpdateAction_Click" AutomationProperties.Name="Update HandPeg" />
                        <Button x:Name="UpdateLaterButton" Content="Later" Margin="6,0,0,0" Padding="10,3" Click="DismissUpdateNotice_Click" />
                    </StackPanel>
                </DockPanel>
                <!--
                    The controls, each shown or not as chosen with the settings button at the right end (PlaybackControls). On one line, always: what the row has no room for is left out of it, least wanted first, and listed
                    in the menu of its last button (see OverflowStrip and FitTransport).
                -->
                <local:OverflowStrip Grid.Column="1" x:Name="TransportCenter" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:OverflowStrip.Resources>
                        <Style x:Key="TextTransport" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="10,5" />
                        </Style>
                    </local:OverflowStrip.Resources>
                    <Button local:OverflowStrip.Priority="20" Style="{StaticResource TransportButton}" Content="&#xE72C;" Margin="3,0,14,0" Click="ReloadPlayer_Click" Visibility="{Binding PlaybackControls[Reload], Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Use if timeline is stuck" AutomationProperties.Name="Reload Player" />
                    <Button local:OverflowStrip.Priority="60" Style="{StaticResource TransportButton}" Content="&#xEB9E;" Tag="JumpStart" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[JumpStart], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.start" local:KeyTip.Text="Go to Start{keys}" AutomationProperties.Name="Go to Start" />
                    <Button local:OverflowStrip.Priority="50" Style="{StaticResource TransportButton}" FontFamily="Segoe UI Symbol" FontSize="15" Padding="10,4" Content="&#x21E4;" Tag="PrevEdit" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[PrevEdit], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.prevEdit" local:KeyTip.Text="Previous Edit Point{keys}: the nearest start or end of a clip before the playhead" AutomationProperties.Name="Previous Edit Point" />
                    <Button local:OverflowStrip.Priority="70" Style="{StaticResource TransportButton}" Content="&#xE892;" Click="PreviousIFrame_Click" Visibility="{Binding PlaybackControls[PrevIFrame], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.prevIFrame" local:KeyTip.Text="Previous I-Frame{keys}" AutomationProperties.Name="Previous I-Frame" />
                    <Button local:OverflowStrip.Priority="90" Style="{StaticResource TransportButton}" Content="&#xE76B;" Click="StepBack_Click" Visibility="{Binding PlaybackControls[StepBack], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.stepBack" local:KeyTip.Text="Step Back One Frame{keys}" AutomationProperties.Name="Step Back One Frame" />
                    <Button local:OverflowStrip.Priority="40" Style="{StaticResource TransportButton}" Content="&#xE768;" Tag="PlayReverse" Click="PlaybackControl_Click" RenderTransformOrigin="0.5,0.5" Visibility="{Binding PlaybackControls[PlayReverse], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.shuttleBack" local:KeyTip.Text="Play Backwards{keys}: again for faster" AutomationProperties.Name="Play Backwards">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Button.RenderTransform>
                    </Button>
                    <Button local:OverflowStrip.Priority="100" Style="{StaticResource PlayPauseButton}" Padding="20,7" Margin="3,0" Click="PlayPause_Click" />
                    <Button local:OverflowStrip.Priority="90" Style="{StaticResource TransportButton}" Content="&#xE76C;" Click="StepForward_Click" Visibility="{Binding PlaybackControls[StepForward], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.stepForward" local:KeyTip.Text="Step Forward One Frame{keys}" AutomationProperties.Name="Step Forward One Frame" />
                    <Button local:OverflowStrip.Priority="70" Style="{StaticResource TransportButton}" Content="&#xE893;" Click="NextIFrame_Click" Visibility="{Binding PlaybackControls[NextIFrame], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.nextIFrame" local:KeyTip.Text="Next I-Frame{keys}" AutomationProperties.Name="Next I-Frame" />
                    <Button local:OverflowStrip.Priority="50" Style="{StaticResource TransportButton}" FontFamily="Segoe UI Symbol" FontSize="15" Padding="10,4" Content="&#x21E5;" Tag="NextEdit" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[NextEdit], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.nextEdit" local:KeyTip.Text="Next Edit Point{keys}: the nearest start or end of a clip after the playhead" AutomationProperties.Name="Next Edit Point" />
                    <Button local:OverflowStrip.Priority="60" Style="{StaticResource TransportButton}" Content="&#xEB9D;" Tag="JumpEnd" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[JumpEnd], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="transport.end" local:KeyTip.Text="Go to End{keys}" AutomationProperties.Name="Go to End" />
                    <ToggleButton local:OverflowStrip.Priority="45" Content="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,7" Margin="3,0" IsChecked="{Binding LoopPlayback}" Visibility="{Binding PlaybackControls[Loop], Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Loop Playback: at the end, playback starts again from the beginning: of the selected clip, or of the whole sequence." AutomationProperties.Name="Loop Playback" />
                    <Button local:OverflowStrip.Priority="30" Style="{StaticResource TransportButton}" Content="&#xE8C6;" Tag="Split" Click="PlaybackControl_Click"
                            local:KeyTip.Action="edit.split" local:KeyTip.Text="Split at Playhead{keys}: cuts the selected block in two at the playhead." AutomationProperties.Name="Split at Playhead (Playback Bar)">
                        <Button.Visibility>
                            <Binding Path="PlaybackControls[Split]" Converter="{StaticResource BoolToVisibility}" />
                        </Button.Visibility>
                    </Button>
                    <Button local:OverflowStrip.Priority="20" Style="{StaticResource TransportButton}" Content="&#xE7C1;" Margin="14,0,3,0" Tag="AddMarker" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[AddMarker], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="marker.add" local:KeyTip.Text="Add Marker{keys}: a marker at the playhead. Right-click a marker (on the timeline or the ruler) to rename or delete it." AutomationProperties.Name="Add Marker" />
                    <Button local:OverflowStrip.Priority="15" Style="{StaticResource TransportButton}" Tag="PrevMarker" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[PrevMarker], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="marker.prev" local:KeyTip.Text="Previous Marker{keys}" AutomationProperties.Name="Previous Marker">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE7C1;" />
                        </StackPanel>
                    </Button>
                    <Button local:OverflowStrip.Priority="15" Style="{StaticResource TransportButton}" Tag="NextMarker" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[NextMarker], Converter={StaticResource BoolToVisibility}}"
                            local:KeyTip.Action="marker.next" local:KeyTip.Text="Next Marker{keys}" AutomationProperties.Name="Next Marker">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C1;" />
                            <TextBlock Text="&#xE76C;" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton local:OverflowStrip.Priority="10" Content="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,7" Margin="14,0,3,0" IsChecked="{Binding ShowSafeMargins}" Visibility="{Binding PlaybackControls[SafeMargins], Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Safe Margins: outlines the action-safe (90%) and title-safe (80%) areas of the frame over the picture." AutomationProperties.Name="Safe Margins" />
                    <ToggleButton local:OverflowStrip.Priority="10" Content="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,7" Margin="3,0,3,0" IsChecked="{Binding EditLayersOnPlayer}"
                                  ToolTip="Edit Clips on Video Preview: click a clip on the player to select it, then move, resize or turn it there. Only the selected clip is outlined, and nothing while playing." AutomationProperties.Name="Edit Clips on Video Preview">
                        <ToggleButton.Visibility>
                            <Binding Path="PlaybackControls[EditOnVideo]" Converter="{StaticResource BoolToVisibility}" />
                        </ToggleButton.Visibility>
                    </ToggleButton>
                    <!-- 3D Exploded View (5.0D, MainWindow.Exploded.cs): the GPU engine's layer stack in 3D, and back. Its icon is geometry: three planes apart. -->
                    <ToggleButton x:Name="ExplodedToggle" local:OverflowStrip.Priority="12" Padding="10,6" Margin="3,0,3,0" Checked="ExplodedToggle_Changed" Unchecked="ExplodedToggle_Changed"
                                  Visibility="{Binding PlaybackControls[Exploded3D], Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="3D Exploded View"
                                  local:KeyTip.Action="view.exploded3d" local:KeyTip.Text="3D Exploded View{keys}: the player shows the layer stack in 3D, each layer a plane in compositing order. Drag a layer to move it in its plane, Shift + drag to move it through the stack (its track's place); right-drag, a touchpad's two-finger scroll or a finger on the empty space to orbit (Alt + middle-drag from the flat player); the wheel or a pinch to zoom; Alt + the wheel or [ and ] for the layer in front or behind. Esc or this button goes back. Needs the GPU preview engine.">
                        <Path Width="18" Height="16" Stretch="None" VerticalAlignment="Center" StrokeThickness="1.3" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M 2,3 L 9,0.8 L 16,3 L 9,5.2 Z M 2,8 L 9,5.8 L 16,8 L 9,10.2 Z M 2,13 L 9,10.8 L 16,13 L 9,15.2 Z" />
                    </ToggleButton>
                    <!-- 5.4B/5.4D: the Live Encoded Preview toggle and its flyout, made in code (MainWindow.LoopbackPreview.cs), shown by default beside the 3D view. -->
                    <ContentControl x:Name="ExportQualityPreviewBarSlot" local:OverflowStrip.Priority="12" Focusable="False" VerticalAlignment="Center" />
                    <Button local:OverflowStrip.Priority="10" Style="{StaticResource TransportButton}" Content="&#xE722;" Tag="ExportFrame" Click="PlaybackControl_Click" Visibility="{Binding PlaybackControls[ExportFrame], Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Export Frame: saves the frame as it is shown (as the layout makes it) as a PNG in the output's folder." AutomationProperties.Name="Export Frame" />
                    <!-- What the row has no room for: listed in a menu from here (see OverflowStrip). Shown only while something is left out. -->
                    <ToggleButton local:OverflowStrip.IsOverflowButton="True" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,7" Margin="3,0"
                                  AutomationProperties.Name="More Playback Controls" ToolTip="More: the playback controls the bar has no room for." />
                </local:OverflowStrip>
                <!-- The time, sound and speed, and at the end the settings button that chooses what the bar shows -->
                <StackPanel Grid.Column="2" x:Name="TransportRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <local:TimeReadout VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding PlaybackControls[Timecode], Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource TimeText}">
                            <Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                        </TextBlock>
                    </local:TimeReadout>
                    <ToggleButton FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="8,5" Margin="0,0,8,0" IsChecked="{Binding IsPlayerMuted}" Visibility="{Binding PlaybackControls[Mute], Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Mute Player">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Content" Value="&#xE767;" />
                                <Setter Property="ToolTip" Value="Mute the player (the export is not affected)." />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="&#xE74F;" />
                                        <Setter Property="ToolTip" Value="The player is muted. Click to hear it again." />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- How tall the Sequence Overview Scrubber is: no slider here since 4.2B-2; its lower edge (dragged), the border above it (Ctrl-drag) and its tab's right-click menu. -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding PlaybackControls[Volume], Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" ToolTip="Volume" />
                        <Slider Width="64" Margin="6,0,8,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                SmallChange="5" LargeChange="20" IsMoveToPointEnabled="True" ToolTip="Volume. Double-click to reset."
                                Value="{Binding Volume}" AutomationProperties.Name="Volume" local:NumericInput.Default="100" />
                    </StackPanel>
                    <ComboBox MinWidth="64" Margin="0" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed}" Visibility="{Binding PlaybackControls[Speed], Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Playback Speed" AutomationProperties.Name="Playback Speed" />
                    <!-- What the bar shows: every control it can have, to tick or not, kept for this mode -->
                    <ToggleButton x:Name="PlaybackSettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="8,5" Margin="8,0,0,0"
                                  AutomationProperties.Name="Playback Controls Settings"
                                  ToolTip="Playback controls: choose what this bar shows (jump to start and end, edit points, loop, start and stop points, markers, safe margins, export frame, timecode, mute and more). Kept for this mode." />
                    <Popup PlacementTarget="{Binding ElementName=PlaybackSettingsButton}" Placement="Top" HorizontalOffset="-300" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=PlaybackSettingsButton, Mode=TwoWay}" Opened="BinPopup_Opened" Closed="BinPopup_Closed" Tag="{Binding ElementName=PlaybackSettingsButton}">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <DockPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                <TextBlock DockPanel.Dock="Top" Text="Playback controls" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock DockPanel.Dock="Top" Text="What this bar shows, in this mode." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PlaybackControls.Options}" Focusable="False">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,2" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                            <GroupStyle.Panel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Vertical" MaxHeight="420" />
                                                </ItemsPanelTemplate>
                                            </GroupStyle.Panel>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical" MaxHeight="440" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsShown}" ToolTip="{Binding Tip}" Margin="0,2,20,2" MinWidth="190" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </local:PlaybackRow>
            <!-- The Canvas: the output frame with its clips, to drag into place -->
            <Border Grid.Column="2" Grid.RowSpan="2" x:Name="LayoutPane" Style="{StaticResource Panel}">
                <DockPanel>
                    <!-- A title row holding only the tabs: the header joins it when it sits right above this pane. -->
                    <docking:PaneTitleRow DockPanel.Dock="Top" Margin="0,0,0,2">
                        <docking:PaneTitleSlot PaneId="Layout" />
                        <CheckBox Content="Edit on Video" IsChecked="{Binding EditLayersOnPlayer}" Margin="10,0,4,0" VerticalAlignment="Center"
                                  docking:PaneTitleRow.Optional="True" AutomationProperties.Name="Edit Clips on Video Preview"
                                  ToolTip="Edit Clips on Video Preview: the selected clip is moved, resized and turned on the player itself too (only its outline and handles are drawn there, and none while playing)." />
                    </docking:PaneTitleRow>
                    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Drag a clip to move it, its corner handle to resize it. Double-click to center." />
                    <!-- The decorator gives the canvas an adorner layer of its own, where the resize handles are drawn. -->
                    <!-- The well the canvas sits in: sunk by the theme's edge (none in a flat theme: WellEdgeThickness 0). -->
                    <local:ButtonChrome BorderBrush="{DynamicResource WellBorderBrush}" BorderThickness="{DynamicResource WellEdgeThickness}" LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" OutlineTakesRoom="True">
                        <AdornerDecorator ClipToBounds="True">
                            <Canvas x:Name="LayoutCanvas" Background="{DynamicResource InsetBrush}" ClipToBounds="True" SizeChanged="LayoutCanvas_SizeChanged" />
                        </AdornerDecorator>
                    </local:ButtonChrome>
                </DockPanel>
            </Border>
            <!-- Timeline and cut controls. Slim above and below, square (5.3-Stage2: edge to edge); its sides line up the times. -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" x:Name="TimelinePane" Style="{StaticResource Panel}" Background="{DynamicResource ScrubberBrush}" Padding="12,3,12,3" CornerRadius="0">
                <Grid>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- With the advanced transport on, its play/pause button takes over from this one -->
                        <Button Grid.Column="0" Style="{StaticResource PlayPauseButton}" MinWidth="56" Click="PlayPause_Click"
                                Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" ToolTip="Volume"
                                    Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Slider Width="90" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                    SmallChange="5" LargeChange="20" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume}" AutomationProperties.Name="Volume" local:NumericInput.Default="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                    Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource TransportButton}" Content="&#xE72C;" Padding="9,6" Click="ReloadPlayer_Click"
                                    ToolTip="Use if timeline is stuck" AutomationProperties.Name="Reload Player" />
                        </StackPanel>
                        <!-- The scrubber's two times keep room for a twelve-character time and 8 DIPs more (5.3.2): the scrubber never moves. -->
                        <local:TimeReadout Grid.Column="3" Margin="12,0,6,0" Spare="8">
                            <TextBlock x:Name="PositionTextBlock" Text="{Binding PositionText}" Style="{StaticResource TimeText}" TextAlignment="Right"
                                       Background="Transparent" Cursor="Hand" ToolTip="Click to copy the current time"
                                       MouseLeftButtonUp="PositionText_MouseLeftButtonUp" />
                        </local:TimeReadout>
                        <!--
                            The timeline, as tall as the Timeline Height setting makes it. From the back: the strip of
                            pictures and the I-frame lines, the waveform of the mixed audio (both down to its lower
                            edge since 5.2A), and on top the playhead. The side margins line everything up with
                            the travel of the playhead, which stops half its width short of each end.
                        -->
                        <!-- The viewport cuts off what a stretched timeline has outside it; unstretched, the timeline simply fills it. -->
                        <Border Grid.Column="4" x:Name="MasterTimelineViewport" ClipToBounds="True" VerticalAlignment="Center" SizeChanged="MasterTimelineViewport_SizeChanged">
                        <Grid x:Name="MasterTimelineContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Height="{Binding TimelineAreaHeight}">
                            <!-- At the very back: a strip of pictures from the video, cut from the same sheet as the hover previews, dimmed so the waveform reads on top of it. Filled in from code. -->
                            <!-- Rounded to whole device pixels (5.3.1): the cells share the width in fractions, and unrounded their 1 px edges and the first cell's clip fell on half pixels. -->
                            <ItemsControl x:Name="FilmstripList" Margin="5,0" Opacity="0.5" IsHitTestVisible="False" Focusable="False" UseLayoutRounding="True"
                                          Visibility="Collapsed" ClipToBounds="True" SizeChanged="FilmstripList_SizeChanged"
                                          AutomationProperties.Name="Timeline Thumbnails">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border ClipToBounds="True" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="0,0,1,0">
                                            <Image Source="{Binding}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- A line at every I-frame. Each item is a fraction of the timeline, turned into an offset here. -->
                            <ItemsControl x:Name="IFrameMarkList" Margin="5,0" ItemsSource="{Binding IFrameMarks}" IsHitTestVisible="False" Focusable="False"
                                          Visibility="{Binding ShowIFrames, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas ClipToBounds="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource FractionToOffset}">
                                                    <Binding />
                                                    <Binding Path="ActualWidth" ElementName="IFrameMarkList" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1" Height="{Binding ActualHeight, ElementName=IFrameMarkList}"
                                                   Fill="{DynamicResource MutedTextBrush}" Opacity="0.55" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Image Source="{Binding TimelineWaveform}" Stretch="Fill" Margin="5,0" Opacity="0.75"
                                   IsHitTestVisible="False" AutomationProperties.Name="Timeline Waveform" />
                            <Slider x:Name="TimelineSlider" Style="{StaticResource TimelineSlider}" Minimum="0" Maximum="{Binding TimelineMaximum}"
                                    Value="{Binding PositionMs}" SmallChange="1000" LargeChange="5000"
                                    IsMoveToPointEnabled="True" AutomationProperties.Name="Timeline"
                                    ValueChanged="TimelineSlider_ValueChanged"
                                    Thumb.DragStarted="TimelineSlider_DragStarted"
                                    Thumb.DragCompleted="TimelineSlider_DragCompleted"
                                    MouseMove="TimelineSlider_MouseMove" MouseLeave="TimelineSlider_MouseLeave"
                                    ToolTipService.InitialShowDelay="1200"
                                    ToolTip="Click or drag anywhere to scrub." />
                            <!-- The markers, as small flags along the top: a click goes to one, a right-click renames or deletes it. Drawn from code. -->
                            <Canvas x:Name="MarkerCanvas" Margin="5,0" ClipToBounds="False" VerticalAlignment="Stretch" SizeChanged="MarkerCanvas_SizeChanged" />
                            <!-- Thumbnail of the moment under the pointer, cut from the sheet made when the video loaded -->
                            <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=TimelineSlider}" Placement="Relative"
                                   AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Image x:Name="PreviewImage" Stretch="Fill" />
                                        <TextBlock x:Name="PreviewTime" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        </Grid>
                        </Border>
                        <local:TimeReadout Grid.Column="5" Margin="6,0,0,0" Spare="8">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource TimeText}" />
                        </local:TimeReadout>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ShowTimelineOptionsBelow, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Snap cuts to I-frames" IsChecked="{Binding SnapToIFrames}" Margin="24,0,0,0"
                                  ToolTip="Splits move onto the I-frames of the video clip they cut, which is what a stream copy needs to cut without encoding. It does not change the encoders: pick Copy or a codec in the Video and Audio tabs." />
                        <CheckBox Content="Show I-frames" IsChecked="{Binding ShowIFrames}" Margin="16,0,0,0"
                                  ToolTip="Draws a thin line on the timeline at every I-frame. Settings (Timeline) can tie timeline snapping to this box." />
                    </StackPanel>
                </StackPanel>
                <!--
                    The bar's lower edge (5.1-Polish, the user's directive): dragged, its height (16 to 120 px, MainWindow.Docking.cs);
                    double-clicked, the usual one. Over the pane's padding (its margin is the padding's, negated: they change together),
                    above everything else in the pane; the border under the pane (the dock's) sizes the bar too (5.2-AuditB).
                -->
                <local:EdgeGrip x:Name="OverviewGrip" VerticalAlignment="Bottom" Margin="-12,0,-12,-3" Panel.ZIndex="1"
                                DragStarted="OverviewGrip_DragStarted" Dragged="OverviewGrip_Dragged" ResetRequested="OverviewGrip_ResetRequested"
                                ToolTip="Drag to make the Sequence Overview Scrubber taller or shorter. A double-click puts its usual height back." />
                </Grid>
            </Border>
            <!--
                The header (the Header pane): Add Media, Layout, Project and Settings. Its shape is set where the dock manager puts it (ApplyHeaderShape): a row held against
                the right edge, never narrower than its buttons together (HeaderWidth); joined to the title row of the
                pane right under it (one bar: that pane's tabs at the left, these at the right); or, docked at a side
                beside other panes, an upright strip of square icon buttons.
            -->
            <StackPanel x:Name="EditorHeader" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                <!--
                    Add Media (the source): a click opens the file picker; resting the pointer on it opens a flyout
                    with the box for a path or a web address (and the download resolution), the Settings button's pattern.
                -->
                <Grid Margin="6,0,0,6" x:Name="AddMediaHost">
                    <Popup x:Name="AddMediaFlyout"
                           AllowsTransparency="True" StaysOpen="True" Opened="AddMediaFlyout_Opened">
                        <local:ButtonChrome x:Name="AddMediaFlyoutPanel" Style="{StaticResource FlyoutChrome}" Padding="10,8"
                                Width="380" KeyDown="AddMediaFlyout_KeyDown"
                                TextElement.Foreground="{DynamicResource TextBrush}">
                            <StackPanel>
                                <!-- The title, and against the right edge, level with it, the resolution asked of yt-dlp for a URL. -->
                                <DockPanel Margin="0,0,0,6">
                                    <ComboBox DockPanel.Dock="Right" MinWidth="64" Margin="0" VerticalAlignment="Center" ItemsSource="{Binding DownloadResolutions}" SelectedItem="{Binding DownloadResolution}"
                                              AutomationProperties.Name="Download Resolution" ToolTip="Download Resolution: the maximum height requested from yt-dlp when the source is a URL." />
                                    <TextBlock DockPanel.Dock="Right" Text="Download Resolution:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="Add Media" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid>
                                    <!--
                                        The box and its button are two columns: the box has all the width the button does not
                                        take, and ends where the button begins. Nothing lies over the text, so what is typed is
                                        seen right up to the button, whatever the button says and however wide that makes it.
                                    -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourcePaneBox" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="7,7,76,7" KeyDown="SourcePaneBox_KeyDown"
                                             Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source URL or File Path"
                                             ToolTip="Type or paste a path or URL and press Enter, or drop a video file anywhere on the window. A web address is downloaded with yt-dlp." />
                                    <Button x:Name="SourceActionButton" Grid.Column="1" Style="{StaticResource InFieldButton}" Content="{Binding SourceActionText}" MinWidth="64" Padding="12,0"
                                            Click="SourceAction_Click" AutomationProperties.Name="Browse or Load Source"
                                            ToolTip="Browse: opens the file browser, while the box is empty. Load: loads the path or URL in the box (Enter does the same)." />
                                </Grid>
                                <!-- A download's subtitles (the Subtitles tab's box until 4.4): asked of yt-dlp with the next web address. -->
                                <CheckBox IsChecked="{Binding DownloadSubtitles}" Content="Download Subtitles" HorizontalAlignment="Left" Margin="0,8,0,0"
                                          AutomationProperties.Name="Download Subtitles"
                                          ToolTip="For a web address: yt-dlp also fetches its subtitles and automatic captions (--write-subs --write-auto-subs), embedded in the file, so they are listed under Source Subtitle Tracks on the Export tab. Applies to the next URL loaded." />
                            </StackPanel>
                        </local:ButtonChrome>
                    </Popup>
                    <Button x:Name="AddMediaButton" Padding="9,6" Click="AddMedia_Click" AutomationProperties.Name="Add Media"
                            ToolTip="Add Media: choose files to add (with nothing open, the first is opened and put on Track 1 at the start; with a video open, they go onto the timeline at the playhead). Rest the pointer here for a box to paste a path or a web address into.">
                        <Path Data="{StaticResource DropFileOrLinkIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
                <!--
                    Layout: resting on it or a click opens the Layout Selector (the window takes each layout, and each theme, while the
                    pointer is on its card; a click keeps it), with the side windows and Save Current Layout in its footer (5.4D: the
                    click's menu is retired). The selector is on the root grid.
                -->
                <Button x:Name="LayoutButton" Padding="9,6" Margin="6,0,0,6" Click="LayoutButton_Click" PreviewKeyDown="LayoutButton_PreviewKeyDown"
                        AutomationProperties.Name="Layout"
                        ToolTip="Layout: rest the pointer here or click for the Layout Selector: the layouts and themes, shown live while the pointer is on one (click one to keep it; ★ marks the layout HandPeg opens in), the side windows and Save Current Layout. Reset Layout is in the Views menu.">
                    <Path Data="{StaticResource LayoutIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="ProjectButton" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="6,0,0,6" Click="OpenProjects_Click"
                        AutomationProperties.Name="Project"
                        ToolTip="Project: save the current source, cuts and settings as a project, or open a saved one." />
                <!--
                    Settings; and, while the pointer rests on it, a small flyout under it with autosave, the batch
                    queue, the Social Squisher and the Game Presets.
                -->
                <Grid Margin="6,0,0,6" x:Name="SettingsHost">
                    <Popup x:Name="SettingsFlyout"
                           AllowsTransparency="True" StaysOpen="True">
                        <local:ButtonChrome x:Name="SettingsFlyoutPanel" Style="{StaticResource FlyoutChrome}" Padding="6">
                            <StackPanel MinWidth="180">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlyoutRowButton}" />
                                </StackPanel.Resources>
                                <!-- Autosave first: its name on the left like the rest, its box at the right-hand end of the row -->
                                <DockPanel Margin="10,5,8,6" Background="Transparent"
                                           ToolTip="Writes the open project to a file named after it (Name.autosave.hproj) every few minutes, in the background. The interval is in Settings, Behavior.">
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutosaveEnabled}" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Autosave" />
                                    <TextBlock Text="Autosave" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Button Content="{Binding QueueButtonText}" Click="FlyoutQueue_Click" AutomationProperties.Name="Queue"
                                        ToolTip="Show the batch queue. The number is how many jobs are waiting." />
                                <Button Content="Social Squisher" Click="FlyoutSquisher_Click" AutomationProperties.Name="Social Squisher"
                                        ToolTip="Opens the startup dialog with the Social Sharing Squisher: drop a video on a preset to squeeze it under that size." />
                                <!-- 5.4D (Q12 b): reachable even on an empty timeline (also in the clip and track right-click menus). -->
                                <Button Content="Save, Import or Export Game Presets..." Click="FlyoutGamePresets_Click" AutomationProperties.Name="Game Presets"
                                        ToolTip="Game Presets: save the layout, Cutouts and look set now as a preset, or move one to or from an .hpstyle file." />
                            </StackPanel>
                        </local:ButtonChrome>
                    </Popup>
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="10,6"
                            Click="OpenSettings_Click" ToolTip="Settings: dependencies, tool paths, update sources and automation. Rest the pointer here for Autosave, the Queue, the Social Squisher and the Game Presets."
                            AutomationProperties.Name="Settings" />
                    <!-- Badge: yt-dlp or FFmpeg is missing or has a newer release -->
                    <Ellipse Width="11" Height="11" Fill="#FF8C00" Stroke="{DynamicResource WindowBackgroundBrush}" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"
                             Visibility="{Binding IsDependencyUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Dependency update available" />
                </Grid>
            </StackPanel>
            <!--
                The media browser (Views menu): a folder's videos, sounds and pictures, to drag onto the
                timeline. It shares the column's height with the Keyframes pane, by the border under it.
            -->
            <Border Grid.Row="2" x:Name="MediaBrowserPanel" Style="{StaticResource Panel}" Margin="0,0,0,0">
                <views:MediaBrowserPane x:Name="MediaBrowser" />
            </Border>
            <!-- Keyframes: the selected clip's keyframes on a timeline of their own, and the clip as it is at the playhead. -->
            <Border x:Name="KeyframesPane" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <docking:PaneTitleRow Margin="0,0,0,6">
                        <docking:PaneTitleSlot PaneId="Keyframes" />
                        <TextBlock Text="{Binding ActiveKeyLayer.Name}" Margin="10,0,0,0" MinWidth="40" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="The clip whose keyframes are shown: the one last selected on the timeline, or the video clip at the playhead." />
                    </docking:PaneTitleRow>
                    <!--
                        The lanes: a row for every motion property of the clip (and every animated effect value), each keyed, dragged
                        and deleted on its own, with All on top; the selected row's value over time under it. The time bars' stretch
                        of the sequence (their zoom). Drawn from code (KeyLanesView).
                    -->
                    <local:KeyLanesView x:Name="KeyLanes" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource WellBorderBrush}" BorderThickness="{DynamicResource WellEdgeThickness}" LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" ClipToBounds="True" SizeChanged="KeyLanes_SizeChanged"
                            AutomationProperties.Name="Keyframe Lanes"
                            ToolTip="A row for each property. Click a diamond to go to it, drag it along its row to move it, Delete to remove it; the diamond at a row's name keys that property at the playhead. Ctrl + wheel zooms the time bars; Up and Down choose a row." />
                    <!--
                        The keyframe buttons, on one line: in a narrow pane the least needed (Clear, then Zoom to Clip and the
                        graph) go into the "more" menu at the end, and the stepping buttons and Key All stay (see OverflowStrip).
                    -->
                    <local:OverflowStrip HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,5" Margin="0,0,4,0" Click="PreviousKeyframe_Click" local:OverflowStrip.Priority="80"
                                AutomationProperties.Name="Previous Keyframe" local:KeyTip.Action="key.prev" local:KeyTip.Text="Previous Keyframe{keys}: moves the playhead to the keyframe before it." />
                        <Button Content="&#x2666; Key All" Padding="10,4" Margin="0,0,4,0" Click="ToggleKeyframe_Click" Foreground="{DynamicResource KeyAccentBrush}" local:OverflowStrip.Priority="100"
                                AutomationProperties.Name="Key All" local:KeyTip.Action="key.toggle" local:KeyTip.Text="Key All{keys}: sets a keyframe at the playhead holding the clip's place, size, rotation and opacity as they are there; on a keyframe, removes it. A single property is keyed with the diamond at its row's name." />
                        <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,5" Margin="0,0,10,0" Click="NextKeyframe_Click" local:OverflowStrip.Priority="80"
                                AutomationProperties.Name="Next Keyframe" local:KeyTip.Action="key.next" local:KeyTip.Text="Next Keyframe{keys}: moves the playhead to the keyframe after it." />
                        <Button Content="Clear" Padding="10,4" Click="ClearKeyframes_Click" AutomationProperties.Name="Clear Keyframes" Margin="0,0,4,0" local:OverflowStrip.Priority="10"
                                ToolTip="Removes every keyframe of this clip: it stays as it is at the playhead." />
                        <ToggleButton Content="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="9,5" Margin="0,0,4,0" IsChecked="{Binding ShowKeyframeGraph}" local:OverflowStrip.Priority="40"
                                      Click="KeyGraph_Click" AutomationProperties.Name="Value Graph" ToolTip="Graph: shows the selected row's value over time under it, with its easing." />
                        <Button Content="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="9,5" Click="ZoomToKeyClip_Click" local:OverflowStrip.Priority="30"
                                AutomationProperties.Name="Zoom to Clip" ToolTip="Zoom to Clip: the time bars (and these rows) show the selected clip's stretch of the timeline." />
                        <ToggleButton local:OverflowStrip.IsOverflowButton="True" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="9,5" Margin="4,0,0,0"
                                      AutomationProperties.Name="More Keyframe Controls" ToolTip="More: the keyframe buttons this pane has no room for." />
                    </local:OverflowStrip>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Enable keyframes" IsChecked="{Binding KeyframesEnabled}" Margin="0,2,14,2"
                                  ToolTip="On: moving, resizing or turning a clip (in the Canvas, or with the numbers) writes a keyframe. Off: a clip with keyframes takes its whole motion with it when it is moved." />
                        <RadioButton Content="Create new on move" GroupName="KeyframeModePane" IsChecked="{Binding KeyframesCreate}" Margin="0,2,14,2" IsEnabled="{Binding KeyframesEnabled}"
                                     ToolTip="A move sets a new keyframe at the playhead." />
                        <RadioButton Content="Snap to nearest" GroupName="KeyframeModePane" IsChecked="{Binding KeyframesSnap}" Margin="0,2,14,2" IsEnabled="{Binding KeyframesEnabled}"
                                     ToolTip="A move changes the keyframe nearest the playhead, and makes no new ones." />
                        <CheckBox Content="Key changed only" IsChecked="{Binding KeyChangedOnly}" Margin="0,2" IsEnabled="{Binding KeyframesEnabled}"
                                  ToolTip="On: a change by hand keys only the property that changed (a resize also keys the place, which moves with it about the anchor point). Off: every motion property is keyed at once, as Key All does." />
                    </WrapPanel>
                    <!-- How the clip moves on from the keyframe the playhead is on, to the next one -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Easing: how the clip gets from the selected keyframe to the next one. Linear moves at one speed; the others start or end slowly. The selected keyframe is the one the playhead is on: step onto one with the previous and next keyframe buttons.">
                        <TextBlock Text="Easing:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- Each easing with its curve drawn beside its name (EasingChoice.Icon, from the formula: 4.2B-3), in the text's colour. -->
                        <ComboBox MinWidth="140" Margin="0" ItemsSource="{Binding EasingChoices}" SelectedValuePath="Type"
                                  SelectedValue="{Binding SelectedKeyEasing}" IsEnabled="{Binding HasSelectedKeyframe}" AutomationProperties.Name="Keyframe Easing">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon}" Width="16" Height="12" VerticalAlignment="Center" Margin="0,0,8,0" StrokeThickness="1.3"
                                              StrokeLineJoin="Round" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <!-- A Custom Bezier's handles, as CSS writes them: cubic-bezier(x1, y1, x2, y2); a preset to start from. -->
                    <WrapPanel Margin="0,6,0,0" Visibility="{Binding IsBezierSelected, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="The curve's two handles: x is how far through the time (0 to 1), y how far through the change (below 0 or above 1 runs past it).">
                        <ComboBox MinWidth="110" Margin="0,2,10,2" ItemsSource="{Binding BezierPresets}" SelectedItem="{Binding SelectedBezierPreset}" AutomationProperties.Name="Bezier Preset" />
                        <TextBlock Text="x1" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,8,2" Text="{Binding BezierX1, StringFormat={}{0:0.##}}" AutomationProperties.Name="Bezier X1"
                                 local:NumericInput.Default="0.42" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0" local:NumericInput.Maximum="1" />
                        <TextBlock Text="y1" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,8,2" Text="{Binding BezierY1, StringFormat={}{0:0.##}}" AutomationProperties.Name="Bezier Y1"
                                 local:NumericInput.Default="0" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="-2" local:NumericInput.Maximum="3" />
                        <TextBlock Text="x2" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,8,2" Text="{Binding BezierX2, StringFormat={}{0:0.##}}" AutomationProperties.Name="Bezier X2"
                                 local:NumericInput.Default="0.58" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0" local:NumericInput.Maximum="1" />
                        <TextBlock Text="y2" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,0,2" Text="{Binding BezierY2, StringFormat={}{0:0.##}}" AutomationProperties.Name="Bezier Y2"
                                 local:NumericInput.Default="1" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="-2" local:NumericInput.Maximum="3" />
                    </WrapPanel>
                    <!-- The clip as it is at the playhead: between two keyframes these run from one to the other as the playhead moves. Each name stays with its box when the row wraps. -->
                    <WrapPanel Margin="0,6,0,0" ToolTip="The clip at the playhead. Between keyframes the numbers follow the motion; changing one moves the clip (and, with keyframes enabled, writes a keyframe).">
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.PositionXPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe X"
                                 local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Y %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.PositionYPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe Y"
                                 local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Scale %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.SizePercent}" AutomationProperties.Name="Keyframe Scale"
                                 local:NumericInput.DragStep="0.25" local:NumericInput.Minimum="1" local:NumericInput.Maximum="400" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rot &#176;" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.Rotation, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe Rotation"
                                 local:NumericInput.Default="0" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-360" local:NumericInput.Maximum="360" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opacity %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.Opacity}" AutomationProperties.Name="Keyframe Opacity"
                                 local:NumericInput.Default="100" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="100"
                                 ToolTip="How solid the clip is at the playhead. With keyframes enabled, changing it writes a keyframe, so the clip can fade in and out." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Anchor %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,4,2" Text="{Binding ActiveKeyLayer.AnchorXPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Anchor X"
                                 local:NumericInput.Default="50" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="0" local:NumericInput.Minimum="-100" local:NumericInput.Maximum="200"
                                 ToolTip="The anchor point across the clip, in percent of its width from its left edge: it turns and grows about this point. 50 is its middle." />
                        <TextBox Style="{StaticResource ValueBox}" Width="44" Margin="0,2,0,2" Text="{Binding ActiveKeyLayer.AnchorYPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Anchor Y"
                                 local:NumericInput.Default="50" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="0" local:NumericInput.Minimum="-100" local:NumericInput.Maximum="200"
                                 ToolTip="The anchor point down the clip, in percent of its height from its top edge. Drag the dot in the Canvas to move it there." />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Effects: the selected clip's effect stack, or the Sequence Output's. Tabbed with Keyframes to start with. -->
            <Border x:Name="EffectsPanePanel" Style="{StaticResource Panel}">
                <views:EffectsPane x:Name="EffectsView" />
            </Border>
            <!--
                The Master Meter (5.2B): the Sequence's meter and master fader upright, a pane of its own (Tabs and Panes: Master Meter). Fed
                by the window's one AudioMeterFeed (MainWindow.AudioSuite.cs) only while the player plays.
            -->
            <Border x:Name="MasterMeterPanel" Style="{StaticResource Panel}">
                <DockPanel>
                    <docking:PaneTitleRow DockPanel.Dock="Top" Margin="0,0,0,2">
                        <docking:PaneTitleSlot PaneId="Meter" />
                    </docking:PaneTitleRow>
                    <local:AudioMeterControl x:Name="MasterMeterPaneMeter" Orientation="Vertical" Margin="2,4" GainDb="{Binding MasterGainDb, Mode=TwoWay}" />
                </DockPanel>
            </Border>
            <!--
                The timeline (4.4): every track on one drawn surface (the video tracks, their Sub-Lanes of Cutouts and sound,
                the sound clips, the captions), with its ruler, toolbar and the selection's inspector. Its pane is
                "UnifiedTimeline"; wired up by InitializeUnifiedTimeline (MainWindow.UnifiedTimeline.cs). Flush with its part's edges
                (5.3-Stage2): no padding and square corners, so the ruler starts right under the tab strip.
            -->
            <Border x:Name="UnifiedTimelinePanel" Style="{StaticResource Panel}" Padding="0" CornerRadius="0">
                <views:UnifiedTimelinePane x:Name="UnifiedTimeline" />
            </Border>
        <!-- The preset bar above the tabs, as Settings may have it: a pane of its own, with no band under it (5.3-Stage2: the dock's seams part the panes). -->
        <ContentControl x:Name="PresetBarPane" Content="{Binding}" ContentTemplate="{StaticResource PresetBarFrame}" Focusable="False" Margin="0" />
        <TabControl x:Name="SettingsTabs" Padding="16,8">
            <!-- Everything that is done to the picture as a whole: the standard filters, the look, and the color grading. -->
            <TabItem Header="Filters" x:Name="AdvancedTab">
                <!--
                    Not built with the window: what is in a template is only made when it is asked for, which is
                    when the tab is first opened or, failing that, once the window is up and idle (RealizeTab).
                -->
                <TabItem.Tag>
                <DataTemplate>
                <DockPanel IsEnabled="{Binding IsVideoReencoded}">
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Button Content="Live Frame Preview" Click="LiveFramePreview_Click" Margin="0,2,6,0"
                                ToolTip="Shows one frame of the video with these settings applied, updated as the controls move, with an optional histogram." />
                        <Button Content="Reset Colors" Margin="0,2,0,0" Command="{Binding ResetColorCommand}" ToolTip="Puts every color control back where it changes nothing."
                                Visibility="{Binding ShowAdvancedFiltersTab, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox Content="Deinterlace (yadif)" IsChecked="{Binding Deinterlace}" Margin="0,4,24,4" />
                                <CheckBox Content="Denoise (hqdn3d)" IsChecked="{Binding Denoise}" Margin="0,4,24,4" />
                                <CheckBox Content="Audio/Video Fade In (1s)" IsChecked="{Binding FadeIn}" Margin="0,4,24,4"
                                          ToolTip="Fades the picture and every encoded audio track in from black and silence." />
                                <CheckBox Content="Audio/Video Fade Out (1s)" IsChecked="{Binding FadeOut}" Margin="0,4,24,4"
                                          ToolTip="Fades the last second of the output to black and silence." />
                            </WrapPanel>
                            <!-- 760 wide at most, and narrower with the pane (a column of at most 760, so it stays at the left). -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="760" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="LUT (.cube):" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button DockPanel.Dock="Right" Content="Clear" Margin="6,4,0,4" Click="ClearLut_Click" />
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,4,0,4" Click="BrowseLut_Click" />
                                    <TextBox Margin="0,4" Text="{Binding LutPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="LUT File"
                                             ToolTip="A 3D lookup table applied to the colours (lut3d). Leave blank for none." />
                                </DockPanel>
                            </Grid>
                            <!-- Color grading and sharpening. Can be hidden in Settings; values set here keep applying while it is. -->
                            <local:ColorControls Margin="0,10,0,0" Visibility="{Binding ShowAdvancedFiltersTab, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                </DataTemplate>
                </TabItem.Tag>
            </TabItem>
            <TabItem Header="Audio">
                <!--
                    Not built with the window: what is in a template is only made when it is asked for, which is
                    when the tab is first opened or, failing that, once the window is up and idle (RealizeTab).
                -->
                <TabItem.Tag>
                <DataTemplate>
                <!--
                    The sound's settings (4.4: its lanes are the timeline's rows now): how every track is encoded and mixed,
                    ducking, the voiceover and the master mix, from the top down. A file dropped here still goes onto the
                    timeline as a sound clip of its own, at the playhead.
                -->
                <DockPanel x:Name="AudioPanel" Background="Transparent" AllowDrop="True" LastChildFill="False"
                           ToolTipService.ShowDuration="6000">
                    <!--
                        The tab's own controls in one line: how far Auto-Duck turns a sound down on the left (folded into one button that opens
                        it as a small menu when there is no room for it), the buttons on the right. (5.4B: the codec, bitrate, rate, channels,
                        mix and normalize that were here too are the Export tab's, in its Audio & Output card: one home each.)
                    -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1" x:Name="AudioOptionsHost" ClipToBounds="True" Margin="0,0,10,0" SizeChanged="AudioOptionsHost_SizeChanged">
                            <StackPanel x:Name="AudioOptionsInline" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            ToolTip="How far a sound set to Auto-Duck is turned down while a sound marked Voice is speaking. Right-click a track to set it to Auto-Duck, or to mark it as the voice.">
                                    <TextBlock Text="Duck by (dB):" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding DuckAmountDb, StringFormat={}{0:0}}" AutomationProperties.Name="Duck Amount"
                                             local:NumericInput.Default="-15" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="-1" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton x:Name="AudioOptionsButton" Content="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="11,6" HorizontalAlignment="Left"
                                          Visibility="Collapsed" AutomationProperties.Name="Audio Options"
                                          ToolTip="Audio options: how far Auto-Duck turns a sound down." />
                            <Popup x:Name="AudioOptionsPopup" PlacementTarget="{Binding ElementName=AudioOptionsButton}" Placement="Bottom" VerticalOffset="4" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=AudioOptionsButton, Mode=TwoWay}"
                                   Opened="BinPopup_Opened" Closed="BinPopup_Closed">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                        <StackPanel Orientation="Horizontal"
                                                    ToolTip="How far a sound set to Auto-Duck is turned down while a sound marked Voice is speaking. Right-click a track to set it to Auto-Duck, or to mark it as the voice.">
                                            <TextBlock Text="Duck by (dB):" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding DuckAmountDb, StringFormat={}{0:0}}" AutomationProperties.Name="Duck Amount (Menu)"
                                                     local:NumericInput.Default="-15" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="-1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- An eye struck through: lists only the sounds that go into the output -->
                            <ToggleButton IsChecked="{Binding HideDroppedTracks}" Padding="9,6" Margin="0,0,8,0" AutomationProperties.Name="Show or Hide Muted Tracks"
                                          ToolTip="Show/hide muted tracks: hides the sounds that are muted (set to Ignore / Drop), so the timeline's sound rows show only what goes into the output. Press again to show them.">
                                <Path Width="19" Height="15" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      Data="M1,8 C3,4.2 5.5,2.5 8,2.5 C10.5,2.5 13,4.2 15,8 C13,11.8 10.5,13.5 8,13.5 C5.5,13.5 3,11.8 1,8 Z M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z M2.6,14.2 L13.4,1.8" />
                            </ToggleButton>
                            <Button Content="Add Audio File..." Padding="12,5" Click="AddAudio_Click" IsEnabled="{Binding HasSource}"
                                    ToolTip="Adds a sound from a file (music, a recording, or the sound of a video) to the timeline as a clip of its own, starting at the playhead. It is mixed into the first audio track. A file can also be dropped onto the timeline, or anywhere on this tab." />
                            <!-- A recording goes onto the timeline as a clip. -->
                            <Button Margin="8,0,0,0" Padding="12,5" Click="OpenVoiceoverStudio_Click" AutomationProperties.Name="Record Voiceover"
                                    ToolTip="Record Voiceover: record from a microphone while the video plays. When the recording is stopped it goes onto the timeline as an audio clip of its own, starting where the playhead was when it began.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Record Voiceover" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AudioTracksHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <!-- The voiceover, once there is one: a track of its own in the picture, mixed into the first track in the encode -->
                    <Grid DockPanel.Dock="Top" Height="50" Margin="0,10,0,0" Visibility="{Binding HasVoiceover, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Voiceover" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VoiceoverTrimText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding VoiceoverWaveform}" Stretch="Fill" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Voiceover Track Waveform">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding VoiceoverGainDb, Converter={StaticResource DecibelToScale}}" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <CheckBox Content="Mix into output" IsChecked="{Binding MixVoiceover}" Margin="0,0,14,0"
                                      ToolTip="Adds the voiceover to the encode as a second input, mixed into the first audio track. It is always mixed in when captions are made from it." />
                            <TextBlock Text="Gain (dB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Width="130" Minimum="-24" Maximum="24" VerticalAlignment="Center"
                                    Value="{Binding VoiceoverGainDb}" AutomationProperties.Name="Voiceover Gain" local:NumericInput.Default="0" />
                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding VoiceoverGainDb, StringFormat={}{0:0}}" AutomationProperties.Name="Voiceover Gain Value"
                                     local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-24" local:NumericInput.Maximum="24" />
                            <Button Content="Delete Voiceover" Padding="10,4" Margin="14,0,0,0" Command="{Binding RemoveVoiceoverCommand}"
                                    ToolTip="Takes the voiceover out of the project. A recording is deleted; a file brought in from elsewhere is left where it is." />
                        </StackPanel>
                    </Grid>

                    <!--
                        Master mix: the tracks' waveforms laid over each other, each with its gain. (The sounds themselves, their
                        clips and the tools for them are on the timeline since 4.4.)
                    -->
                    <Grid DockPanel.Dock="Top" Height="40" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Master Mix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding ShowWaveforms, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="The output tracks' waveforms laid over each other: what goes into the export. Each sound's gain and filters are its own clip's and lane's, set on the Timeline." />
                        <Border Grid.Column="1" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True" Cursor="Hand"
                                Visibility="{Binding ShowWaveforms, Converter={StaticResource BoolToVisibility}}"
                                MouseLeftButtonDown="Waveform_MouseLeftButtonDown" MouseMove="Waveform_MouseMove" MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                                ToolTip="Click or drag to move the playhead to that moment.">
                            <Grid>
                            <ItemsControl ItemsSource="{Binding AudioTracks}" Focusable="False" AutomationProperties.Name="Master Mix View">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.55" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The voiceover: only the part its trim keeps, starting where it starts and as long as it lasts -->
                            <Canvas x:Name="MixVoiceCanvas" IsHitTestVisible="False"
                                    Visibility="{Binding IncludeVoiceover, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding VoiceoverMixWaveform}" Stretch="Fill" Opacity="0.8" RenderTransformOrigin="0.5,0.5"
                                       Height="{Binding ActualHeight, ElementName=MixVoiceCanvas}" AutomationProperties.Name="Voiceover In Master Mix">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource FractionToOffset}">
                                            <Binding Path="VoiceoverMixStart" />
                                            <Binding Path="ActualWidth" ElementName="MixVoiceCanvas" />
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Image.Width>
                                        <MultiBinding Converter="{StaticResource FractionToOffset}">
                                            <Binding Path="VoiceoverMixWidth" />
                                            <Binding Path="ActualWidth" ElementName="MixVoiceCanvas" />
                                        </MultiBinding>
                                    </Image.Width>
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleY="{Binding VoiceoverGainDb, Converter={StaticResource DecibelToScale}}" />
                                    </Image.RenderTransform>
                                </Image>
                            </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--
                        The master meter and fader (5.2B): the Sequence's mix as it plays (each side's peak and RMS, the loudness in LUFS with
                        its targets, the true peak) and its master gain, the same as the Master Meter pane's. Wired as the tab is made.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Master" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                                   ToolTip="The Sequence's master: what an export gets, after its master gain (before the player's own volume)." />
                        <local:AudioMeterControl x:Name="AudioTabMeter" Grid.Column="1" Orientation="Horizontal" Height="60" MaxWidth="720" HorizontalAlignment="Stretch"
                                                 GainDb="{Binding MasterGainDb, Mode=TwoWay}" />
                    </Grid>
                </DockPanel>
                </DataTemplate>
                </TabItem.Tag>
            </TabItem>
            <!--
                Export (Pass 4.1B; 5.4B the three columns): every export setting once, in three inspector cards (CLAUDE.md 10.3) side by side
                while the pane is wide and one over the other when it is not (ReflowExportColumns): Preset & Format, Quality, Bitrate &
                Resolution (with the rare options in a folded Advanced drawer), Audio & Output (the Live Encoded Preview, the Projected Output
                and DestinationBar itself, moved here while this tab is shown). Under them the source's details, and the Audio tab's content
                while that tab is hidden (one content, moved: MainWindow.Export.cs). The Video tab of before is these columns.
            -->
            <TabItem Header="Export" x:Name="ExportTab">
                <!--
                    Not built with the window (5.3-Stage2): made when the tab is first shown, or once the window is idle (ExportContent;
                    RealizeTabContent finds its named parts). DestinationBar waits outside the window until then (PlaceDestinationBar).
                -->
                <TabItem.Tag>
                <DataTemplate>
                <DockPanel x:Name="ExportPanel">
                    <!-- A label/value row of the Projected Output and the Source Information, found by DynamicResource (made with this template). -->
                    <DockPanel.Resources>
                        <DataTemplate x:Key="InfoRowTemplate">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </DockPanel.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                    <!-- The three columns: placed by ReflowExportColumns (three star columns while each card has 300 px, else one over the other). -->
                    <Grid x:Name="ExportColumns" AutomationProperties.Name="Export Columns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ===== Column 1: Preset & Format ===== -->
                        <Border Style="{StaticResource ExportCard}" AutomationProperties.Name="Preset and Format">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Text="Preset &amp; Format" Style="{StaticResource ExportCardTitle}" />
                                <!-- The Export Presets selector, here while it is not a pane of its own above the tabs (Settings: Preset Bar). -->
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetBar}" Focusable="False" Margin="0,0,0,4"
                                                Visibility="{Binding ShowPresetBarInExport, Converter={StaticResource BoolToVisibility}}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Format:" Style="{StaticResource FieldLabel}" />
                                    <!-- The format stays available during a stream copy: only the container changes. -->
                                    <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" AutomationProperties.Name="Format"
                                              ToolTip="The file's container: mp4, mkv, webm, mov, an animated GIF or WebP, or the sound alone (FLAC lossless, WAV 16-bit PCM, MP3): an Audio Only file draws no picture, and the picture's settings fold away." />
                                    <!-- An Audio Only file (5.4C: FLAC, WAV, MP3) has no picture: its video parts fold away (IsVideoExport). -->
                                    <TextBlock Grid.Row="1" Text="Video Codec:" Style="{StaticResource FieldLabel}" Visibility="{Binding IsVideoExport, Converter={StaticResource BoolToVisibility}}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding VideoEncoders}" SelectedItem="{Binding VideoEncoder}" AutomationProperties.Name="Video Encoder"
                                              Visibility="{Binding IsVideoExport, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="What the picture is encoded with: H.264, HEVC or AV1 in software (x264, x265, SVT-AV1) or on this PC's graphics card (listed once it was checked), VP9, the editing codecs (ProRes, DNxHR), or Copy (the file's own picture, packet for packet)." />
                                </Grid>
                                <WrapPanel Margin="0,4" Visibility="{Binding IsVideoExport, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="Web Optimized" IsChecked="{Binding WebOptimized}" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Web Optimized"
                                              ToolTip="Puts the index at the front of an .mp4, .mov or .m4v file, so that it starts playing in a browser before it has downloaded (-movflags +faststart). On to start with." />
                                    <CheckBox Content="10-bit" IsChecked="{Binding TenBit}" IsEnabled="{Binding CanTenBit}" VerticalAlignment="Center" AutomationProperties.Name="10-bit"
                                              Visibility="{Binding HasTenBit, Converter={StaticResource BoolToVisibility}}" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Encodes in 10 bits instead of 8, which shows less banding in gradients (-pix_fmt p010le for a hardware encoder, yuv420p10le for a software one). With HEVC or AV1 it also keeps an HDR project HDR. Greyed out when this graphics card cannot do it for the selected encoder: neither AMF nor QuickSync has 10-bit H.264." />
                                </WrapPanel>
                                <!-- The picture's notes, folded away with it for an Audio Only file (5.4C). -->
                                <StackPanel Visibility="{Binding IsVideoExport, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Copy passes the picture through: said here, in yellow, when that leaves clips or filters out -->
                                    <TextBlock Text="{Binding CopyBypassWarning}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Copy Warning">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CopyBypassWarning}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- How an HDR project is written: kept HDR (10-bit HEVC or AV1, 5.4B) or tone-mapped to BT.709 SDR, and why -->
                                    <TextBlock Text="{Binding ProjectColorNote}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Project Colour Note">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProjectColorNote}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding HdrStatusText}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,4" />
                                    <!-- The hardware encoders found (a vendor whose card is not here is not named: EncoderProber.ProblemsForCardsHere) -->
                                    <TextBlock Text="{Binding HardwareEncoderStatusText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Column 2: Quality, Bitrate & Resolution ===== -->
                        <Border Grid.Column="1" Style="{StaticResource ExportCard}" AutomationProperties.Name="Quality, Bitrate and Resolution">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Text="Quality, Bitrate &amp; Resolution" Style="{StaticResource ExportCardTitle}" />
                                <!-- An Audio Only file (5.4C) has no picture to size, rate or encode: this card's parts fold away, a line says why. -->
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4" AutomationProperties.AutomationId="Audio Only Note"
                                           Visibility="{Binding IsAudioOnlyExport, Converter={StaticResource BoolToVisibility}}"
                                           Text="An Audio Only file holds the Sequence's sound alone: no picture is drawn, so there is no video quality, bitrate or size to set. The sound's codec, rate, channels and loudness are in Audio &amp; Output." />
                                <StackPanel Visibility="{Binding IsVideoExport, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel2" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Rate Control:" Style="{StaticResource FieldLabel}" />
                                        <!-- The one rate control box: its list is the selected encoder's own, and what is chosen is stored as one of the same three modes whichever encoder it was chosen for. -->
                                        <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding RateControlChoices}" SelectedItem="{Binding RateControlChoice}" IsEnabled="{Binding HasRateControl}"
                                                  AutomationProperties.Name="Rate Control"
                                                  ToolTip="How the data is spent, under the selected encoder's names. VBR (the default) averages the Target Bitrate and lets busy scenes take more; CBR holds it. The constant quality holds the picture at the Constant Quality value: CRF (x264, x265, SVT-AV1, VP9), CQ (NVENC), CQP (AMF and QuickSync, a fixed quantizer) or ICQ (QuickSync, a quality aimed for)." />

                                        <!-- Quality or bitrate: one row, whichever the rate control spends by. -->
                                        <TextBlock Grid.Row="1" Text="Constant Quality:" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding IsConstantQuality, Converter={StaticResource BoolToVisibility}}" />
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4" IsEnabled="{Binding HasRateControl}"
                                              Visibility="{Binding IsConstantQuality, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="51" VerticalAlignment="Center" Value="{Binding Crf}" AutomationProperties.Name="Constant Quality" local:NumericInput.Default="22" />
                                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" Width="46" Margin="8,0,0,0" Text="{Binding Crf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Constant Quality Value"
                                                     local:NumericInput.Default="22" local:NumericInput.DragStep="0.1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="51" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Target Bitrate (kbps):" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsEnabled="{Binding HasRateControl}" AutomationProperties.Name="Target Bitrate"
                                                 local:NumericInput.Default="" local:NumericInput.DragStep="25" local:NumericInput.Minimum="50" local:NumericInput.Maximum="500000" local:NumericInput.Decimals="0"
                                                 Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVisibility}}"
                                                 Text="{Binding TargetBitrate, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Video bitrate in kbps. Empty: an automatic bitrate from the output's size and frame rate (shown under the box). Changing it updates Target File Size, and the other way round." />

                                        <TextBlock Grid.Row="2" Text="Target File Size (MB):" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" IsEnabled="{Binding HasRateControl}" AutomationProperties.Name="Target File Size"
                                                 local:NumericInput.Default="" local:NumericInput.DragStep="0.1" local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="100000" local:NumericInput.Decimals="1"
                                                 Text="{Binding TargetFileSize, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Type a size and the bitrate is worked out from the length of the output and the audio bitrate. Typing here switches Constant Quality to a bitrate mode. Otherwise it shows the size the bitrate gives." />

                                        <TextBlock Grid.Row="3" Text="Encoder Preset:" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding EncoderPresets}" SelectedItem="{Binding EncoderPreset}"
                                                  IsEnabled="{Binding HasEncoderPresets}" AutomationProperties.Name="Encoder Preset"
                                                  ToolTip="Speed against quality, starting at the slowest and best (veryslow for x264 and x265, p7 for NVENC, High Quality for AMF, veryslow for QuickSync; Media Foundation has no steps and is asked for its slowest). The steps offered are the selected encoder's own: ultrafast to veryslow for x264 and x265, veryfast to veryslow for QuickSync, Speed, Balanced, Quality and High Quality for AMF, p1 (fastest) to p7 (highest quality) for NVENC.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EncoderPresetLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Text="Framerate (FPS):" Style="{StaticResource FieldLabel}" />
                                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4" IsEnabled="{Binding IsVideoReencoded}">
                                            <TextBox DockPanel.Dock="Right" Width="70" Margin="8,0,0,0" ToolTip="Custom frame rate, for example 360 or 119.88"
                                                     IsEnabled="{Binding IsCustomFramerate}"
                                                     Visibility="{Binding IsCustomFramerate, Converter={StaticResource BoolToVisibility}}"
                                                     Text="{Binding CustomFramerate, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox ItemsSource="{Binding Framerates}" SelectedItem="{Binding Framerate}" AutomationProperties.Name="Framerate" />
                                        </DockPanel>
                                    </Grid>
                                    <!-- The automatic bitrate (empty Target Bitrate), and why a typed size cannot be met. -->
                                    <TextBlock Text="{Binding AutoBitrateText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,0,0,4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AutoBitrateText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TargetSizeHint}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />

                                    <!-- The output's size (the Video tab's Resolution of before; per-clip crop is on a clip's menu, Crop). -->
                                    <Grid Margin="0,4,0,0" IsEnabled="{Binding IsVideoReencoded}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel2" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Resolution:" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding ResolutionPresets}" SelectedItem="{Binding ResolutionPreset}"
                                                  AutomationProperties.Name="Resolution Preset"
                                                  ToolTip="Common sizes. Choosing one fills in Width and Height, on their side when Use Vertical Resolution is ticked. Match Project Settings is the Sequence's own size; Custom is whatever is typed below." />
                                        <TextBlock Grid.Row="1" Text="Width x Height:" Style="{StaticResource FieldLabel}" />
                                        <!-- Two boxes of 76 where there is room; narrower together, never cut off, in a narrow column (three cards from 924 px). -->
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="76" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MaxWidth="76" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox MinWidth="40" AutomationProperties.Name="Output Width"
                                                     local:NumericInput.Default="" local:NumericInput.DragStep="2" local:NumericInput.Minimum="16" local:NumericInput.Maximum="16384"
                                                     Text="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceSizeText}" />
                                            <TextBlock Grid.Column="1" Text="&#x00D7;" Style="{StaticResource FieldLabel}" Margin="6,0,6,0" />
                                            <TextBox Grid.Column="2" MinWidth="40" AutomationProperties.Name="Output Height"
                                                     local:NumericInput.Default="" local:NumericInput.DragStep="2" local:NumericInput.Minimum="16" local:NumericInput.Maximum="16384"
                                                     Text="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceSizeText}" />
                                        </Grid>
                                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4">
                                            <CheckBox Content="Keep Aspect Ratio" IsChecked="{Binding KeepAspectRatio}" Margin="0,0,16,0"
                                                      ToolTip="Fill in the other dimension automatically from the shape of the Sequence's own size (the first video put on it), turned on its side with Use Vertical Resolution." />
                                            <CheckBox Content="Use Vertical Resolution" IsChecked="{Binding UseVerticalResolution}"
                                                      ToolTip="Turns the shape of the output on its side: 16:9 becomes 9:16, and Width and Height swap. Every clip keeps its middle and its width; fit or fill a clip to the new shape from its menu (Transform), or give it a blur fill." />
                                        </WrapPanel>
                                        <TextBlock Grid.Row="3" Text="Colorspace:" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Colorspaces}" AutomationProperties.Name="Colorspace"
                                                  SelectedItem="{Binding Colorspace}"
                                                  ToolTip="Match Project Settings writes the project's colour: SDR as BT.709; an HDR project stays HDR with 10-bit HEVC or AV1 (else it is tone-mapped, and the note in Preset &amp; Format says why). HDR to SDR always tone-maps PQ or HLG video to BT.709." />
                                    </Grid>

                                    <!-- What only some encoders have, and what is rarely changed: folded away until asked for (CLAUDE.md 10.3's Advanced drawer). -->
                                    <Expander Header="Advanced Codec &amp; Chapter Options" IsExpanded="False" Margin="0,8,0,0" AutomationProperties.Name="Advanced Codec and Chapter Options"
                                              ToolTip="The encoder's own options (tune, profile, level, multipass, lookahead, AQ), the pixel aspect, extra encoder options, the chapters and SponsorBlock.">
                                        <!-- The encoder's options grey out for a stream copy; the chapters and SponsorBlock below do not (a copy keeps them too). -->
                                        <StackPanel Margin="0,6,0,0">
                                            <Grid IsEnabled="{Binding IsVideoReencoded}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel2" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- Tune is x264's and x265's, or, while an NVENC encoder is selected, NVIDIA's. -->
                                                <TextBlock Text="Tune:" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding Tunes}" SelectedItem="{Binding Tune}" AutomationProperties.Name="Tune"
                                                          IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}"
                                                          Visibility="{Binding IsNvencEncoder, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding NvencTunes}" SelectedItem="{Binding NvencTune}" AutomationProperties.Name="NVENC Tuning"
                                                          Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="What the encoder aims for (-tune). High Quality suits files; the low latency ones are for streaming. Lossless keeps every pixel and ignores Rate Control: the files are very large." />
                                                <TextBlock Grid.Row="1" Text="Profile:" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Profile"
                                                          IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}" />
                                                <TextBlock Grid.Row="2" Text="Level:" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" AutomationProperties.Name="Level"
                                                          IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}" />
                                                <TextBlock Grid.Row="3" Text="Multipass:" Style="{StaticResource FieldLabel}" Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding NvencMultipasses}" SelectedItem="{Binding NvencMultipass}" AutomationProperties.Name="NVENC Multipass"
                                                          Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="NVENC: a first look at each frame before it is encoded (-multipass), at a quarter of the resolution or all of it. Spends the bitrate better, at some cost in speed." />
                                                <TextBlock Grid.Row="4" Text="Usage:" Style="{StaticResource FieldLabel}" Visibility="{Binding IsAmfEncoder, Converter={StaticResource BoolToVisibility}}" />
                                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AmfUsages}" SelectedItem="{Binding AmfUsage}" AutomationProperties.Name="AMF Usage"
                                                          Visibility="{Binding IsAmfEncoder, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="AMF: what the encoder is set up for (-usage). Transcoding suits files; High Quality spends more time on each frame and needs a recent FFmpeg and driver; the low latency ones and Webcam are for streaming." />
                                                <TextBlock Grid.Row="5" Text="Pixel Aspect:" Style="{StaticResource FieldLabel}" />
                                                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                                                    <TextBox DockPanel.Dock="Right" Width="56" Margin="8,0,0,0" ToolTip="Custom ratio, for example 8:9"
                                                             Visibility="{Binding IsCustomPixelAspectRatio, Converter={StaticResource BoolToVisibility}}"
                                                             Text="{Binding CustomPixelAspectRatio, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox ItemsSource="{Binding PixelAspectRatios}" SelectedItem="{Binding PixelAspectRatio}" AutomationProperties.Name="Pixel Aspect" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="6" Text="Extra Options:" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" FontFamily="Consolas" AutomationProperties.Name="Extra Video Options"
                                                         Text="{Binding ExtraVideoArguments, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Added after the encoder's own options, for example -g 1 -keyint_min 1 or -profile:v 0." />
                                            </Grid>
                                            <WrapPanel Margin="0,4" IsEnabled="{Binding IsVideoReencoded}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding HasLookahead, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Lookahead (frames):" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding Lookahead, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lookahead"
                                                             local:NumericInput.Default="0" local:NumericInput.DragStep="1" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="100"
                                                             ToolTip="How many frames ahead the rate control looks; 0 turns it off. NVENC looks up to 32 ahead (-rc-lookahead) and a larger number is taken as 32; QuickSync up to 100 (-look_ahead_depth), with VBR and ICQ." />
                                                </StackPanel>
                                                <CheckBox Content="Spatial AQ" IsChecked="{Binding NvencSpatialAq}" Margin="0,4,16,4" VerticalAlignment="Center"
                                                          Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="NVENC: spends more of the bitrate on flat areas, where blocking shows first (-spatial-aq 1)." />
                                                <CheckBox Content="Temporal AQ" IsChecked="{Binding NvencTemporalAq}" IsEnabled="{Binding CanNvencTemporalAq}" Margin="0,4,16,4" VerticalAlignment="Center"
                                                          Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}" ToolTipService.ShowOnDisabled="True"
                                                          ToolTip="NVENC: spends more of the bitrate on what stays still from frame to frame (-temporal-aq 1). Greyed out when this graphics card cannot do it for the selected encoder." />
                                            </WrapPanel>
                                            <!-- Chapters: carried over, at the cuts, at the markers (5.4B: from the retired Video tab). -->
                                            <TextBlock Text="Chapters" FontWeight="SemiBold" Margin="0,8,0,4" />
                                            <CheckBox Content="Create chapter markers" IsChecked="{Binding ChapterMarkers}" Margin="0,4"
                                                      ToolTip="Carries the source's chapters over. Only for uncut encodes: once sections are removed, the source's chapter times no longer fit." />
                                            <CheckBox Content="Generate Chapters at Cut Points" IsChecked="{Binding ChaptersAtCuts}" Margin="0,4"
                                                      ToolTip="Gives the output one chapter per kept segment, so a player can jump from cut to cut." />
                                            <CheckBox Content="Generate Chapters at Markers" IsChecked="{Binding ChaptersAtMarkers}" Margin="0,4"
                                                      local:KeyTip.Text="Gives the output a chapter at each marker (Add Marker, {key:marker.add|on the playback bar}, puts one at the playhead), named after it. Markers in removed stretches are left out; with Chapters at Cut Points as well, both kinds are there." />
                                            <!-- 4.2B-2: the chapters as a YouTube description lists them, and what downloads do with SponsorBlock. -->
                                            <WrapPanel Margin="0,4">
                                                <Button Content="Copy YouTube Timestamps" Command="{Binding CopyYouTubeTimestampsCommand}" Margin="0,2,12,2" Padding="10,3"
                                                        AutomationProperties.Name="Copy YouTube Timestamps"
                                                        ToolTip="Copies '00:00 Intro', '01:24 Gameplay'... for a YouTube description: every marker at its time in the output, after the cuts (clip speeds included), and SponsorBlock chapters when they are kept. Always starts at 00:00." />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="SponsorBlock:" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox Margin="0" MinWidth="150" ItemsSource="{Binding SponsorBlockModes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                              SelectedValue="{Binding SponsorBlockMode}" AutomationProperties.Name="SponsorBlock Segments"
                                                              ToolTip="What the next download does with the SponsorBlock categories ticked in Settings (Downloads): cut them out of the file, keep them as named chapters (listed by Copy YouTube Timestamps), or leave SponsorBlock alone. With none ticked, cutting or keeping ticks sponsor, self-promotion and interaction reminders." />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Column 3: Audio & Output ===== -->
                        <Border Grid.Column="2" Style="{StaticResource ExportCard}" AutomationProperties.Name="Audio and Output">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Text="Audio &amp; Output" Style="{StaticResource ExportCardTitle}" />
                                <!-- The sound's encoding: its one home (5.4B: the Audio tab's copy of this row is gone). -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Audio Codec:" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Column="1" Margin="0,4">
                                        <ComboBox DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="78" ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrate}" IsEnabled="{Binding IsAudioReencoded}"
                                                  AutomationProperties.Name="Export Audio Bitrate" ToolTip="The bitrate of every re-encoded track that follows the default, and of the mix (FLAC and PCM, lossless, take none)." />
                                        <ComboBox ItemsSource="{Binding AudioEncoders}" SelectedItem="{Binding AudioEncoder}" AutomationProperties.Name="Export Audio Codec"
                                                  ToolTip="The codec of every track that follows the default (a track given one of its own keeps it), and of the mixed track when mixing: AAC, Opus, MP3, AC-3, FLAC (lossless) or PCM, or Copy." />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Sample Rate:" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AudioSampleRates}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding AudioSampleRate}"
                                              AutomationProperties.Name="Export Audio Sample Rate"
                                              ToolTip="The sample rate every encoded track is written at (-ar). Match Project Settings writes the project's sample rate (48 kHz unless its Project Settings say otherwise). Copied tracks are left as they are. Saved with the project and in presets." />
                                    <TextBlock Grid.Row="2" Text="Channels:" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AudioChannelChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding AudioChannels}"
                                              AutomationProperties.Name="Export Audio Channels"
                                              ToolTip="The channels of every encoded track (-ac). Stereo folds anything wider down to two and leaves stereo and mono tracks as they are; Mono makes one channel; Match Source keeps the source's. Copied tracks are left as they are." />
                                </Grid>
                                <CheckBox Content="Track Mix: mix the tracks into one" IsChecked="{Binding MergeAudioTracks}" Margin="0,4" AutomationProperties.Name="Export Mix Selected Tracks"
                                          ToolTip="On: every track that is not set to Ignore / Drop is mixed into one output track (the mix is always encoded). Off: per-track stems, each stream place an audio track of its own in the file. On to start with." />
                                <DockPanel Margin="0,4">
                                    <ComboBox DockPanel.Dock="Right" MinWidth="120" Margin="8,0,0,0" ItemsSource="{Binding LoudnessTargets}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding LoudnessTarget}" IsEnabled="{Binding NormalizeAudio}" AutomationProperties.Name="Normalize Target"
                                              ToolTip="The integrated loudness Normalize aims at: -16 LUFS (the default, the web's) or -14 LUFS (what the streaming platforms play at), with the peaks held under -1.5 dBTP." />
                                    <CheckBox Content="Normalize audio" IsChecked="{Binding NormalizeAudio}" VerticalAlignment="Center" AutomationProperties.Name="Export Normalize Audio"
                                              ToolTip="Evens out the loudness to the target beside it (EBU R128 measuring, the peaks held under -1.5 dBTP), applied to re-encoded and mixed tracks. Copied tracks are left as they are." />
                                </DockPanel>

                                <!--
                                    The source's own subtitle tracks (the Subtitles tab's until 4.4; the captions are on the timeline): each carried over
                                    into the output, burned into the picture or left out. Shown while the source has any.
                                -->
                                <StackPanel Margin="0,4" AutomationProperties.Name="Source Subtitle Tracks Card">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubtitleTracks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Source Subtitle Tracks" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}" Focusable="False" AutomationProperties.Name="Source Subtitle Tracks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <local:ReflowPanel Spacing="8" RowSpacing="2">
                                                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MinWidth="120" local:ReflowPanel.Fill="True" />
                                                    <local:SoftMinWidth Value="200" HorizontalAlignment="Left">
                                                        <ComboBox Margin="0,2" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" HorizontalAlignment="Stretch" MinWidth="0"
                                                                  AutomationProperties.Name="{Binding Description}" ToolTip="What the output does with this subtitle track: carry it over, burn it into the picture, or leave it out." />
                                                    </local:SoftMinWidth>
                                                </local:ReflowPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SubtitleTracksHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- The Live Encoded Preview (5.4B, the encode loopback: MainWindow.LoopbackPreview.cs; renamed and given the eye in 5.4D, as on the player bar): the player shows what the encoder would leave. -->
                                <ToggleButton IsChecked="{Binding IsExportQualityPreview}" AutomationProperties.Name="Live Encoded Preview" HorizontalAlignment="Left" Margin="0,8,0,4" Padding="10,5"
                                              IsEnabled="{Binding IsVideoExport}" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="The player shows each frame as the export's encoder would leave it (a fast approximation while it plays, the export's settings when it is paused): side by side with the original, encoded, or the difference x10. Never saved: off at every start. Off for an Audio Only file (FLAC, WAV, MP3), which has no picture.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Live Encoded Preview" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{Binding ExportQualityPreviewStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExportQualityPreviewStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- What the file will be: size, rate, colour, codecs, length and the estimated file size (built by UpdateProjectedOutput). -->
                                <TextBlock Text="Projected Output" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding OutputInfoRows}" ItemTemplate="{DynamicResource InfoRowTemplate}" AutomationProperties.Name="Projected Output" Focusable="False" />

                                <!-- Save As, Browse, Start Encode and Add to Queue: DestinationBar itself, moved in while this tab is shown (PlaceDestinationBar). -->
                                <Border x:Name="ExportBarSlot" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- What the source is (5.4A: from the retired Summary tab), folded away until asked for. -->
                    <Expander Header="Source Details" IsExpanded="False" Margin="0,10,0,0" AutomationProperties.Name="Source Details"
                              ToolTip="The source file's streams: its format, size, codecs, rates and tracks.">
                        <Border Style="{StaticResource ExportCard}" Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                            <ItemsControl ItemsSource="{Binding SourceInfoRows}" ItemTemplate="{DynamicResource InfoRowTemplate}" AutomationProperties.Name="Source Information" Focusable="False" />
                        </Border>
                    </Expander>

                    <!-- The Audio tab's content while that tab is hidden (MainWindow.Export.cs: one content, moved), with its button while there were more. -->
                    <StackPanel x:Name="ExportSections" Orientation="Horizontal" Margin="0,10,0,6" AutomationProperties.Name="Export Sections" />
                    <Border x:Name="ExportSectionHost" />
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                </DataTemplate>
                </TabItem.Tag>
            </TabItem>

            <!-- Off by default; switched on in Settings for those who want to read or edit the FFmpeg command. -->
            <TabItem Header="Command Preview" x:Name="CommandPreviewTab">
                <!-- Not built with the window: made when the tab is first opened, or once the window is idle (RealizeTab). -->
                <TabItem.Tag>
                <DataTemplate>
                <!--
                    The pane's height while it has room (the box scrolls itself, its caret kept in view), never less than a
                    usable box: in a pane shorter than that, the tab scrolls as a whole.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="200">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" VerticalAlignment="Top" Content="Regenerate" Command="{Binding RegenerateCommandCommand}" />
                        <TextBlock Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsCommandManuallyEdited, Converter={StaticResource BoolToVisibility}}"
                                   Text="Edited by hand: settings changes no longer update this command. Regenerate discards your edits." />
                    </DockPanel>
                    <TextBox FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="8" IsVisibleChanged="CommandPreviewBox_IsVisibleChanged"
                             Text="{Binding CommandPreview, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                </ScrollViewer>
                </DataTemplate>
                </TabItem.Tag>
            </TabItem>
        </TabControl>
        </Grid>

        <!--
            The bottom of the window: where the output goes, and the status bar under it. In a
            window wide enough for both, the two are one row (see UpdateBottomBar).
        -->
        <Grid Grid.Row="4" Grid.RowSpan="2" x:Name="BottomBar">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Destination: where the output goes, and the buttons that make it. One row at the bottom of the window; in the Export tab's
            Audio & Output card (5.4B), narrower, the path over the buttons (ReflowPanel).
        -->
        <Border Grid.ColumnSpan="2" x:Name="DestinationBar" Style="{StaticResource Panel}" Margin="0,1,0,0">
            <local:ReflowPanel Spacing="6" RowSpacing="6">
                <DockPanel MinWidth="260" local:ReflowPanel.Fill="True">
                    <TextBlock DockPanel.Dock="Left" Text="Save As:" Style="{StaticResource FieldLabel}" />
                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="BrowseDestination_Click" />
                    <TextBox VerticalContentAlignment="Center" AutomationProperties.Name="Destination Path"
                             Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Start Encode" FontWeight="SemiBold" Command="{Binding StartEncodeCommand}" />
                    <Button Content="Add to Queue" Margin="6,0,0,0" Command="{Binding AddToQueueCommand}"
                            ToolTip="Queue the command in the Command Preview box to run later. While editing a queued job, this adds a second job." />
                    <!-- Only while a queued job is loaded for editing -->
                    <Button Content="Update Queued Job" Margin="6,0,0,0" Command="{Binding UpdateQueuedJobCommand}"
                            Visibility="{Binding IsEditingQueuedJob, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Replace the queued job being edited with the current settings." />
                </StackPanel>
            </local:ReflowPanel>
        </Border>

        </Grid>

        <!--
            The drop overlay: while a file is dragged over the window, the window dims and offers targets to
            drop it on (Game Presets or encoding presets, by the mode, and the Social Squisher's). Only the targets
            take the drop; the dimming does not, so a file let go anywhere else lands on what is under it, as
            it always did. Filled from code, after the window is up: nothing of it is on the way to starting.
        -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="999" Visibility="Collapsed">
            <Grid.Resources>
                <DataTemplate x:Key="DropTargetSmall">
                    <Button Height="60" MinWidth="110" Margin="4" Padding="8,3" HorizontalAlignment="Stretch" AllowDrop="True" Background="{DynamicResource DropTargetBrush}" Focusable="False" FontSize="11.5"
                            DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="None" HorizontalAlignment="Center" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding IconData}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate x:Key="DropTargetTemplate">
                    <Button Height="112" Width="232" Margin="6" Padding="12,6" FontSize="14" AllowDrop="True" Background="{DynamicResource DropTargetBrush}" Focusable="False"
                            DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="None" HorizontalAlignment="Center" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding IconData}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </Grid.Resources>
            <Rectangle Fill="#C8000000" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The first and larger choice: open the file, with a preset. Which kind of preset is the mode's. -->
                <Border x:Name="DropPresetSection" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="10" Background="#38000000" Padding="16,10,16,12" HorizontalAlignment="Stretch">
                <StackPanel>
                <TextBlock x:Name="DropPresetTitle" Text="Open with a Game Preset" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" IsHitTestVisible="False" />
                <ItemsControl x:Name="DropPresetList" Focusable="False" ItemTemplate="{StaticResource DropTargetTemplate}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </StackPanel>
                </Border>
                <!-- The second, smaller: do not open it at all, squeeze it for somewhere. -->
                <Border x:Name="DropSquishSection" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="10" Background="#38000000" Padding="14,8,14,10" Margin="0,32,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                <TextBlock Text="Social Sharing Squisher" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" IsHitTestVisible="False" />
                <ItemsControl x:Name="DropSquishList" Focusable="False" ItemTemplate="{StaticResource DropTargetSmall}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
