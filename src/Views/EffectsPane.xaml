<UserControl x:Class="HandPegApp.Views.EffectsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HandPegApp"
             xmlns:docking="clr-namespace:HandPegApp.Docking"
             AutomationProperties.Name="Effects Pane">
    <!--
        The Effects pane: the effect stack of the selected clip, or of the Sequence Output. The title row
        holds the target, Add Effect (rest on it: the effects by category, with a search box), Bypass All and the stack
        menu. The cards are built in code (EffectsPane.xaml.cs): one per effect, dragged by their grip to reorder
        within their zone (ReorderBehavior), each value a slider and a number box (double-click resets).
    -->
    <DockPanel>
        <docking:PaneTitleRow DockPanel.Dock="Top" Margin="0,0,0,6">
            <docking:PaneTitleSlot PaneId="Effects" />
            <TextBlock x:Name="TargetLabel" Margin="10,0,6,0" MinWidth="40" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       docking:PaneTitleRow.Optional="True"
                       ToolTip="What the effects are on: the clip last selected on the timeline (or the main video), or the Sequence Output." />
            <ToggleButton x:Name="SequenceToggle" Content="Sequence Output" Padding="8,3" Margin="0,0,4,0" Click="SequenceToggle_Click"
                          AutomationProperties.Name="Sequence Output"
                          ToolTip="Sequence Output: the effects on the finished picture, after the Filters tab's colour, over the whole sequence. Off: the selected clip's effects." />
            <Grid x:Name="AddHost" Background="Transparent" Margin="0,0,4,0" MouseEnter="AddHost_MouseEnter" MouseLeave="AddFlyout_MouseLeave">
                <Button x:Name="AddButton" Padding="8,3" Click="AddButton_Click" AutomationProperties.Name="Add Effect" PreviewKeyDown="AddButton_PreviewKeyDown"
                        ToolTip="Add Effect: rest the pointer here (or press Down) for the effects by category, with a search box. A click opens the list too.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Add Effect" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="AddPopup" StaysOpen="True" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=AddHost}">
                    <Border x:Name="AddFlyoutPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6"
                            Margin="0,2,0,0" MouseLeave="AddFlyout_MouseLeave" PreviewKeyDown="AddFlyout_PreviewKeyDown">
                        <DockPanel TextElement.Foreground="{DynamicResource TextBrush}" Width="240">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBox x:Name="SearchBox" Padding="20,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search Effects"
                                         ToolTip="Type to find an effect by its name or category. Escape, or a click outside, closes the list." />
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
                            </Grid>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel x:Name="AddList" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
            <ToggleButton x:Name="BypassButton" Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="7,4" Margin="0,0,4,0" Click="BypassButton_Click"
                          AutomationProperties.Name="Bypass All Effects"
                          ToolTip="Bypass All: sets every effect of the stack aside at once, to compare with and without. Nothing is lost; click again to bring them back." />
            <Button x:Name="MoreButton" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="7,4" Click="MoreButton_Click"
                    AutomationProperties.Name="Effect Stack Menu"
                    ToolTip="Copy Stack, Paste Effects, Paste Selected Effects..., Save Effect Preset, Reset." />
        </docking:PaneTitleRow>
        <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="2,2,2,8" Foreground="{DynamicResource MutedTextBrush}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <StackPanel x:Name="CardsPanel" local:ReorderBehavior.IsEnabled="True" />
                <StackPanel x:Name="PinnedPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
