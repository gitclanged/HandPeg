<UserControl x:Class="HandPegApp.Views.SubtitleStudioPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HandPegApp.Views"
             xmlns:local="clr-namespace:HandPegApp"
             xmlns:docking="clr-namespace:HandPegApp.Docking"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             Focusable="True" FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="Subtitle Studio Pane">
    <!--
        The Subtitle Studio (5.4C, a dock pane; a modal window of its own until then): the subtitle track's cues on a strip of
        their own, its transport, and the selected cue's words and times. It has no clock and no preview of its own: its playhead is
        the main player's, and the main player draws the captions. Its narrow form (the Vertical & Shorts Studio's left column) wraps
        the transport and keeps the strip as tall as the pane allows.
    -->
    <DockPanel>
        <docking:PaneTitleRow DockPanel.Dock="Top" Margin="0,0,0,6">
            <docking:PaneTitleSlot PaneId="SubtitleStudio" />
            <TextBlock x:Name="SummaryText" Margin="10,0,0,0" MinWidth="40" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" docking:PaneTitleRow.Optional="True" />
        </docking:PaneTitleRow>

        <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" />

        <!-- The selected cue: its words, and its times to the millisecond. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CueText" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     TextChanged="CueText_TextChanged" LostKeyboardFocus="EditBox_LostKeyboardFocus" IsEnabled="False" AutomationProperties.Name="Subtitle Text" />
            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Start (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="StartBox" Grid.Column="1" Width="84" Margin="0,1" Padding="4,1" FontFamily="Consolas" IsEnabled="False" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="Subtitle Start" />
                <TextBlock Grid.Row="1" Text="End (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="EndBox" Grid.Row="1" Grid.Column="1" Width="84" Margin="0,1" Padding="4,1" FontFamily="Consolas" IsEnabled="False" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="Subtitle End" />
                <TextBlock Grid.Row="2" Text="Offset (ms):" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="The Global Offset of the whole track." />
                <TextBox x:Name="OffsetBox" Grid.Row="2" Grid.Column="1" Width="84" Margin="0,1" Padding="4,1" FontFamily="Consolas" LostFocus="OffsetBox_LostFocus" KeyDown="TimeBox_KeyDown" TextChanged="OffsetBox_TextChanged" AutomationProperties.Name="Global Offset"
                         ToolTip="Shifts every subtitle of the track as it is typed: later when positive, earlier when negative." />
            </Grid>
        </Grid>

        <!-- Transport, and what is done to the cues: one row while it fits, wrapped in a narrow pane. -->
        <WrapPanel x:Name="Transport" DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,5" Margin="0,2,0,2" Click="Play_Click"
                    ToolTip="Play or pause the player (Space)." AutomationProperties.Name="Play or Pause" />
            <local:TimeReadout Margin="8,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TimeText" Text="0:00.000" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="78" />
            </local:TimeReadout>
            <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="9,5" Margin="0,2,0,2" Click="Previous_Click" ToolTip="Go to the subtitle before." AutomationProperties.Name="Previous Subtitle" />
            <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="9,5" Margin="4,2,10,2" Click="Next_Click" ToolTip="Go to the next subtitle." AutomationProperties.Name="Next Subtitle" />
            <Button x:Name="AddButton" Content="Add Caption" Padding="10,5" Margin="0,2,4,2" Click="Add_Click" ToolTip="A new, blank caption of two seconds at the playhead. Over a clip whose captions follow it, it follows that clip too." />
            <Button x:Name="SplitButton" Content="Split" Padding="10,5" Margin="0,2,4,2" Click="Split_Click" ToolTip="Cuts the selected subtitle in two at the playhead: the words said before it stay, the rest become a subtitle of their own." />
            <Button x:Name="AddWordButton" Content="Add Word" Padding="10,5" Margin="0,2,4,2" Click="AddWord_Click" ToolTip="Adds a word to the end of the selected subtitle, ready to be typed over." />
            <Button x:Name="DeleteButton" Content="Delete" Padding="10,5" Margin="0,2,10,2" Click="Delete_Click" ToolTip="Deletes the word that is picked out in the selected subtitle; with no word picked out, the whole subtitle (Delete)." />
            <Button x:Name="UndoButton" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="9,5" Margin="0,2,4,2" Click="Undo_Click"
                    ToolTip="Undo (Ctrl+Z): the main history, where each change made here is a step." AutomationProperties.Name="Undo" />
            <Button x:Name="RedoButton" Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="9,5" Margin="0,2,0,2" Click="Redo_Click"
                    ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" />
        </WrapPanel>

        <!--
            The strip. Its two ends fade out: the mask is opaque across the middle and see-through at the edges, so the strip seems to
            come out of nothing on one side and go into it on the other.
        -->
        <Border MinHeight="56">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.09" Color="#FF000000" />
                    <GradientStop Offset="0.91" Color="#FF000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <views:SubtitleTimeline x:Name="Timeline" AutomationProperties.Name="Subtitle Timeline"
                                    ToolTip="Drag the strip to scrub the player; the mouse wheel zooms. Drag a subtitle to move it, or one of its ends to retime that end." />
        </Border>
    </DockPanel>
</UserControl>
