<UserControl x:Class="HandPegApp.Views.MediaBrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:docking="clr-namespace:HandPegApp.Docking"
             xmlns:views="clr-namespace:HandPegApp.Views"
             IsVisibleChanged="Pane_IsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="Shade" Color="#B0000000" />
        <!-- How wide a tile is wanted (its margins included), set from code for the size chosen; the panel stretches the columns to fill the pane. -->
        <sys:Double x:Key="TileWidth">208</sys:Double>

        <!--
            A tile: the picture (a frame of the video, which follows the pointer across it), the length in a corner,
            a line along the bottom for where the pointer is, and the name under it.
        -->
        <DataTemplate x:Key="TileTemplate">
            <!-- As wide as the panel's column (stretched to fill the pane, 5.3.1); the picture keeps 16:9 at that width. -->
            <StackPanel Margin="3" Background="Transparent">
                <views:AspectBox>
                <Grid Background="{DynamicResource InsetBrush}" ClipToBounds="True"
                      MouseMove="Picture_MouseMove" MouseLeave="Picture_MouseLeave">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Image Source="{Binding Shown}" Stretch="Uniform" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Padding="4,1" CornerRadius="3" Background="{StaticResource Shade}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Info}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScrubbing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Info}" FontSize="10.5" Foreground="White" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3,3,3,6" Padding="4,1" CornerRadius="3" Background="{StaticResource Shade}"
                            Visibility="{Binding IsScrubbing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding HoverText}" FontSize="10.5" Foreground="White" />
                    </Border>
                    <Rectangle Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5"
                               Visibility="{Binding IsScrubbing, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HoverFraction}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                </views:AspectBox>
                <!-- The path is the name's tooltip, not the picture's: over the picture it would hide the time being scrubbed. -->
                <TextBlock Text="{Binding Name}" Margin="1,3,1,0" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            </StackPanel>
        </DataTemplate>

        <!--
            The List view's columns (5.4C), as wide as the code sets them (a column dropped in a narrow pane is 0): the header and every
            row share them, so they line up under virtualization with no shared size groups.
        -->
        <GridLength x:Key="ColThumb">72</GridLength>
        <GridLength x:Key="ColResolution">84</GridLength>
        <GridLength x:Key="ColFramerate">66</GridLength>
        <GridLength x:Key="ColDuration">62</GridLength>
        <GridLength x:Key="ColCodec">58</GridLength>
        <GridLength x:Key="ColAudio">48</GridLength>
        <GridLength x:Key="ColSize">70</GridLength>

        <!-- A cell of the List view's details: muted, small, cut short with an ellipsis rather than spilling into the next column. -->
        <Style x:Key="DetailCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!--
            A row of the List view (5.4C): a small picture (which follows the pointer too), the name, then the details read once the row
            is in sight: resolution, frame rate, length, codec, sound streams, size.
        -->
        <DataTemplate x:Key="DetailRowTemplate">
            <Grid Background="Transparent" Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource ColThumb}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{DynamicResource ColResolution}" />
                    <ColumnDefinition Width="{DynamicResource ColFramerate}" />
                    <ColumnDefinition Width="{DynamicResource ColDuration}" />
                    <ColumnDefinition Width="{DynamicResource ColCodec}" />
                    <ColumnDefinition Width="{DynamicResource ColAudio}" />
                    <ColumnDefinition Width="{DynamicResource ColSize}" />
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="36" HorizontalAlignment="Left" Background="{DynamicResource InsetBrush}" ClipToBounds="True"
                      MouseMove="Picture_MouseMove" MouseLeave="Picture_MouseLeave">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Image Source="{Binding Shown}" Stretch="Uniform" />
                    <Rectangle Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5"
                               Visibility="{Binding IsScrubbing, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HoverFraction}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding ResolutionText}" Style="{StaticResource DetailCell}" />
                <TextBlock Grid.Column="3" Text="{Binding FrameRateText}" Style="{StaticResource DetailCell}" />
                <TextBlock Grid.Column="4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DetailCell}">
                            <Setter Property="Text" Value="{Binding DurationText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScrubbing}" Value="True">
                                    <Setter Property="Text" Value="{Binding HoverText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="5" Text="{Binding CodecText}" Style="{StaticResource DetailCell}" />
                <TextBlock Grid.Column="6" Text="{Binding AudioText}" Style="{StaticResource DetailCell}" />
                <TextBlock Grid.Column="7" Text="{Binding SizeText}" Style="{StaticResource DetailCell}" />
            </Grid>
        </DataTemplate>

        <!-- A row of the Filmstrip view's list (5.4C): a small picture, the name, and its resolution, frame rate and length under it. -->
        <DataTemplate x:Key="CompactRowTemplate">
            <DockPanel Margin="1" Background="Transparent">
                <Grid DockPanel.Dock="Left" Width="64" Height="36" Background="{DynamicResource InsetBrush}" ClipToBounds="True"
                      MouseMove="Picture_MouseMove" MouseLeave="Picture_MouseLeave">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Image Source="{Binding Shown}" Stretch="Uniform" />
                    <Rectangle Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5"
                               Visibility="{Binding IsScrubbing, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding HoverFraction}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding MetaLine}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScrubbing}" Value="True">
                                        <Setter Property="Text" Value="{Binding HoverText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- One side of the Project Media | Folder Browser switch: the side chosen is filled with the accent -->
        <Style x:Key="SwitchSide" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MediaSource" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!--
                        Each side is as wide as its words (no fixed width): the full name, or in a narrow pane the short one
                        kept in Tag (Project, Folder). Both are in the template and one is shown, so the title row measures
                        each form as it is, and gives the switch the whole width of the form it shows (it is never cut).
                    -->
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="side" CornerRadius="8" Padding="8,1,8,2" Background="Transparent">
                            <Grid>
                                <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="shortLabel" Text="{TemplateBinding Tag}" FontSize="11" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="docking:PaneTitleRow.IsCompact" Value="True">
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="shortLabel" Property="Visibility" Value="Visible" />
                                <Setter TargetName="side" Property="Padding" Value="7,1,7,2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="side" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Only the rows of tiles in view (and one more each side) are made: a folder of hundreds of videos stays light. -->
        <ItemsPanelTemplate x:Key="TilePanel">
            <views:VirtualizingTilePanel TileWidth="{DynamicResource TileWidth}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RowPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- The title, and against the right edge: what the files are sorted by, which way, how large they are shown, and Refresh -->
        <docking:PaneTitleRow DockPanel.Dock="Top" Margin="0,0,0,6">
            <docking:PaneTitleSlot PaneId="Media" HorizontalAlignment="Left" />
            <!--
                What the pane lists: the files the open project uses, or a folder on disk. "Project | Folder" when the pane is
                too narrow for the full names beside the sort and size controls (the row decides; it never cuts the names).
            -->
            <Border Margin="0,0,8,0" Padding="1" CornerRadius="9" VerticalAlignment="Center" Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" docking:PaneTitleRow.CanCompact="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ProjectSide" Style="{StaticResource SwitchSide}" Content="Project Media" Tag="Project" Checked="Source_Checked"
                                 AutomationProperties.Name="Project Media" ToolTip="Project Media: the project's own bin, saved with it: the files picked for it or dropped here, and every file a clip plays (kept after its clips are deleted, until you remove it)." />
                    <RadioButton x:Name="FolderSide" Style="{StaticResource SwitchSide}" Content="Folder Browser" Tag="Folder" Checked="Source_Checked"
                                 AutomationProperties.Name="Folder Browser" ToolTip="Folder Browser: the media files of a folder on disk, with its path above them." />
                    <RadioButton x:Name="LibrarySide" Style="{StaticResource SwitchSide}" Content="Clip Library" Tag="Library" Checked="Source_Checked"
                                 AutomationProperties.Name="Clip Library" ToolTip="Clip Library: your own clips kept across projects (a clip's menu, Save Clip to Personal Clip Library...), searched by title and tags." />
                </StackPanel>
            </Border>
            <ComboBox x:Name="SortBox" docking:PaneTitleRow.Optional="True" MinWidth="78" Margin="0" SelectionChanged="SortBox_SelectionChanged"
                      AutomationProperties.Name="Media Browser Sort" ToolTip="What the files are sorted by. Folders stay first.">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Date" />
                <ComboBoxItem Content="Size" />
                <ComboBoxItem Content="Type" />
            </ComboBox>
            <ToggleButton x:Name="SortDirectionButton" docking:PaneTitleRow.Optional="True" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="6,4" Margin="3,0,0,0"
                          Checked="SortDirection_Changed" Unchecked="SortDirection_Changed" AutomationProperties.Name="Sort Descending">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Content" Value="&#xE74A;" />
                        <Setter Property="ToolTip" Value="Ascending (A to Z, oldest, smallest first). Click for descending." />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="&#xE74B;" />
                                <Setter Property="ToolTip" Value="Descending (Z to A, newest, largest first). Click for ascending." />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <!--
                How the files are laid out (5.4C, in place of the size slider): Grid (tiles, their size in the tab's right-click menu), List
                (a table of each file's details, with a preview and cutter beside it once the pane is wide) or Filmstrip (a preview and
                sub-clip cutter beside a list). The sort box, its direction and the view are optional (4.2B-2): in a narrow column (a 150 %
                laptop) they leave before the Project | Folder switch could be cut. The view is also in the tab's right-click menu.
            -->
            <ComboBox x:Name="ViewBox" docking:PaneTitleRow.Optional="True" MinWidth="82" Margin="8,0,0,0" SelectionChanged="ViewBox_SelectionChanged"
                      AutomationProperties.Name="Media Browser View"
                      ToolTip="How the files are shown: Grid (tiles), List (a table of their details), or Filmstrip (a preview and sub-clip cutter beside the list).">
                <ComboBoxItem Content="Grid" />
                <ComboBoxItem Content="List" />
                <ComboBoxItem x:Name="FilmstripChoice" Content="Filmstrip" />
            </ComboBox>
            <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,4" Margin="8,0,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="Refresh Media Browser" ToolTip="Reads the folder (or the project's files) again." />
        </docking:PaneTitleRow>

        <!-- The folder: up a level, the path (type one and press Enter), Browse inside the box as in the Source pane. Folder Browser only. -->
        <Grid x:Name="FolderBar" DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,0" Margin="0,0,4,0" Click="Up_Click"
                    AutomationProperties.Name="Up One Folder" ToolTip="Up one folder (Backspace in the list)." />
            <TextBox Grid.Column="1" x:Name="PathBox" VerticalContentAlignment="Center" Padding="6,5,4,5" KeyDown="PathBox_KeyDown"
                     AutomationProperties.Name="Media Folder Path" ToolTip="The folder shown. Type or paste another and press Enter; leave it empty and press Enter for the drives." />
            <Button Grid.Column="2" Style="{DynamicResource InFieldButton}" Content="Browse" Padding="12,0" Margin="-1,0,0,0" Click="Browse_Click"
                    AutomationProperties.Name="Browse for Media Folder" ToolTip="Choose a folder." />
        </Grid>

        <!-- The Clip Library's search (5.2C): every word in the title or a tag. Clip Library only. -->
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,5,4,5" VerticalContentAlignment="Center" Visibility="Collapsed"
                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search Clip Library"
                 ToolTip="Search the Clip Library: every word typed in a clip's title or among its tags." />

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                   Text="Drag files onto the timeline or the player; double-click a folder to open it." />

        <!--
            The views share one list (5.4C): Grid and List fill the pane with it; List puts a preview beside it once the pane is 600 DIPs
            wide; Filmstrip puts the preview and cutter on the left and the list in a column on the right, a splitter between them. The
            preview, the cutter and the List view's header are made from code the first time they are needed, after the first frame.
        -->
        <Grid x:Name="ContentGrid" SizeChanged="ContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                <ColumnDefinition x:Name="SplitColumn" Width="0" />
                <ColumnDefinition x:Name="ListColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="PreviewHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" Background="{DynamicResource InsetBrush}" />
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Focusable="False" Visibility="Collapsed" DragCompleted="PreviewSplitter_DragCompleted"
                          PreviewMouseLeftButtonDown="PreviewSplitter_PreviewMouseLeftButtonDown"
                          AutomationProperties.Name="Media Browser List Width" ToolTip="Drag to make the list wider or narrower; double-click to put it back to 240 DIPs." />
            <DockPanel Grid.Column="2">
                <ContentControl x:Name="ListHeaderHost" DockPanel.Dock="Top" Focusable="False" IsTabStop="False" Visibility="Collapsed" />
                <!--
                    The files. Dragged out, they drop like files from Explorer: onto a track of the timeline, or on
                    the player. Double-click: a folder opens; a file is added at the playhead (or loaded,
                    when nothing is). Right-click for more.
                -->
                <ListBox x:Name="Items" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Media Files"
                         PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown" PreviewMouseMove="Items_PreviewMouseMove" PreviewMouseLeftButtonUp="Items_PreviewMouseLeftButtonUp"
                         PreviewMouseDown="Items_PreviewMouseDown" PreviewMouseUp="Items_PreviewMouseUp" PreviewKeyDown="Items_PreviewKeyDown"
                         LostMouseCapture="Items_LostMouseCapture"
                         KeyDown="Items_KeyDown" ContextMenuOpening="Items_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="1" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <EventSetter Event="MouseDoubleClick" Handler="Item_MouseDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
