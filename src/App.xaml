<Application x:Class="HandPegApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:HandPegApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            What a drop area shows: a video file (a page with its corner folded and a play triangle on it) and a link
            (two loops of a chain over its lower right): files or links. Drawn with a stroke, as the drop targets' icons are.
        -->
        <GeometryGroup x:Key="DropFileOrLinkIcon" FillRule="Nonzero">
            <PathGeometry Figures="M 36,33 L 36,12 L 27,3 L 8,3 L 8,44 L 29,44 M 27,3 L 27,12 L 36,12" />
            <PathGeometry Figures="M 17,18 L 28,24.5 L 17,31 Z" />
            <RectangleGeometry Rect="29.5,40 18,8" RadiusX="4" RadiusY="4">
                <RectangleGeometry.Transform>
                    <RotateTransform Angle="-45" CenterX="38.5" CenterY="44" />
                </RectangleGeometry.Transform>
            </RectangleGeometry>
            <RectangleGeometry Rect="37.5,32 18,8" RadiusX="4" RadiusY="4">
                <RectangleGeometry.Transform>
                    <RotateTransform Angle="-45" CenterX="46.5" CenterY="36" />
                </RectangleGeometry.Transform>
            </RectangleGeometry>
        </GeometryGroup>

        <!-- The Layout button: a window of panes (a large one, two beside it, a band under them), drawn with a stroke as the header's other drawn icon is. -->
        <GeometryGroup x:Key="LayoutIcon" FillRule="Nonzero">
            <RectangleGeometry Rect="2,3 20,18" RadiusX="2.5" RadiusY="2.5" />
            <PathGeometry Figures="M 2,14.5 L 22,14.5 M 14.5,3 L 14.5,14.5 M 14.5,8.75 L 22,8.75" />
        </GeometryGroup>

        <!--
            The palette. These are the dark colours; ThemeManager replaces the brushes at startup and whenever
            the theme or the Windows accent changes, which is why everything refers to them dynamically.
        -->
        <SolidColorBrush x:Key="InsetBrush" po:Freeze="True" Color="#181818" />
        <SolidColorBrush x:Key="OnAccentBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" po:Freeze="True" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBrush" po:Freeze="True" Color="#252525" />
        <SolidColorBrush x:Key="ControlBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ControlHoverBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ControlBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" po:Freeze="True" Color="#A0A0A0" />
        <SolidColorBrush x:Key="DisabledTextBrush" po:Freeze="True" Color="#6A6A6A" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="AccentHoverBrush" po:Freeze="True" Color="#1A8AE5" />
        <SolidColorBrush x:Key="AccentPressedBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="WarningTextBrush" po:Freeze="True" Color="#E0A040" />

        <!--
            The theme's look (Pass 4.1C, ThemeManager.LookDefaults and each palette): button faces, their outline and the
            light top-left edge that embosses them (transparent: flat), hover and chosen fills and edges, the line that
            traces the active tab, the cards' surface, and the rounding of controls, cards and boxed tabs. One set of
            templates reads them all; these are the dark defaults until the theme is applied. Since Pass 4.1C.2 also: the
            tabs not shown, the lists' wells, the sunken edge of wells and viewports, the raised edge of combo boxes and
            cards, and the thickness of that sunken edge on wells that have no border in a flat theme (0 there: nothing
            drawn, nothing moved). A theme may light an edge from the top left (ThemeManager.EdgeTokens): the token is then
            its top and left, and the same name with LowerBrush its bottom and right (null here: one colour all round),
            drawn as lines by the one element that faces the control (ButtonChrome, the time bars).
        -->
        <SolidColorBrush x:Key="CardBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ButtonFaceBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="ButtonTextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="ButtonBevelBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonHoverBrush" po:Freeze="True" Color="#1A8AE5" />
        <SolidColorBrush x:Key="ButtonPressedBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="NeutralButtonBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="NeutralButtonBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="HoverFillBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="HoverBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="SelectedFillBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="SelectedBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="SelectedTextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ActiveTabTraceBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="InactiveTabBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="TabEdgeBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="ActiveTabEdgeBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="TitleBarBrush" po:Freeze="True" Color="#1E1E1E" />
        <SolidColorBrush x:Key="KeyAccentBrush" po:Freeze="True" Color="Gold" />
        <SolidColorBrush x:Key="WellBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="WellBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="RaisedBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="SelectedRowBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="SelectedRowBorderBrush" po:Freeze="True" Color="#0078D7" />
        <!--
            4.2B-3: a ticked check box's fill, edge and mark (the accent filled with white in the flat themes; Reno and Reno Dark
            keep the sunken well and draw a dark or a light-blue mark in it), and the classic 1 px dotted rectangle drawn inside
            what is focused, checked or chosen (ButtonChrome.DottedOutlineBrush; transparent, so never drawn, in the flat themes).
        -->
        <SolidColorBrush x:Key="CheckedBoxBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="CheckedBoxBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="CheckMarkBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DottedFocusBrush" po:Freeze="True" Color="Transparent" />
        <x:Null x:Key="CheckedBoxBorderLowerBrush" />
        <x:Null x:Key="ButtonBorderLowerBrush" />
        <x:Null x:Key="NeutralButtonBorderLowerBrush" />
        <x:Null x:Key="RaisedBorderLowerBrush" />
        <x:Null x:Key="WellBorderLowerBrush" />
        <x:Null x:Key="TabEdgeLowerBrush" />
        <x:Null x:Key="ActiveTabEdgeLowerBrush" />
        <Thickness x:Key="WellEdgeThickness">0</Thickness>
        <Thickness x:Key="TabEdgeThickness">0</Thickness>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="TabCornerRadius">6,6,0,0</CornerRadius>

        <!--
            The keyboard focus rectangle of buttons, toggle buttons and check boxes (4.2B-3): WPF's own dotted rectangle, in the
            theme's text colour. ThemeFocusVisual is what the styles read: this one in the flat themes, and NoFocusVisual (draws
            nothing) in Reno and Reno Dark (ThemeManager.Apply), whose dotted rectangle is drawn by the control's own face instead.
            Not null: a resource set to null counts as missing to DynamicResource, and the control then falls back on WPF's
            default black dashed rectangle, a second ring around the whole control (Pass 4.2C).
        -->
        <Style x:Key="NoFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StandardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <StaticResource x:Key="ThemeFocusVisual" ResourceKey="StandardFocusVisual" />

        <!--
            A flyout's or a menu's surface (4.2B-3): the panel colour, raised by the theme's lit edge (RaisedBorderBrush over
            RaisedBorderLowerBrush) with the cards' rounding, drawn by one element as a button's face is. Every header flyout,
            the Views menu, the Add Effect and Add Layer flyouts and the right-click menus wear it.
        -->
        <Style x:Key="FlyoutChrome" TargetType="local:ButtonChrome">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RaisedBorderBrush}" />
            <Setter Property="LowerBorderBrush" Value="{DynamicResource RaisedBorderLowerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="OutlineTakesRoom" Value="True" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!--
            A button: the theme's face in a 1 px outline, with its bevel (a light top and left edge) just inside, drawn by
            one element (ButtonChrome). The outline and the bevel are drawn over the face, so they take no room: a button
            is as large as it always was. A button with BorderThickness 0 (a row of a flyout's menu) has neither.
        -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:ButtonChrome x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            LowerBorderBrush="{DynamicResource ButtonBorderLowerBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" BevelBrush="{DynamicResource ButtonBevelBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                                <Setter TargetName="chrome" Property="BevelBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="chrome" Property="DottedOutlineBrush" Value="{DynamicResource DottedFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource NeutralButtonBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{DynamicResource NeutralButtonBorderLowerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The caption buttons of a window that draws its own title bar (Minimize, Maximize / Restore): Windows' own glyphs,
            46 x 32, lit on hover. Here since 4.4, for the main window's title bar and the Settings screen's alike: one template.
        -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="hover">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="pressed">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Close: red under the pointer, as Windows' own. -->
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box" Background="Transparent">
                            <ContentPresenter x:Name="glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#F1707A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button that stays down: the chosen fill while on, the neutral embossed face while off; dotted inside while focused (Reno). -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <local:ButtonChrome x:Name="chrome" Background="{DynamicResource NeutralButtonBrush}" BorderBrush="{DynamicResource NeutralButtonBorderBrush}"
                                            LowerBorderBrush="{DynamicResource NeutralButtonBorderLowerBrush}"
                                            BevelBrush="{DynamicResource ButtonBevelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" OutlineTakesRoom="True"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                                <Setter TargetName="chrome" Property="BevelBrush" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="chrome" Property="DottedOutlineBrush" Value="{DynamicResource DottedFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <!-- Applied once, by the text view itself (4.2D): the template gives PART_ContentHost no margin of its own. -->
            <Setter Property="Padding" Value="6,5" />
            <!--
                One line of text sits in the middle of its box (4.2B-3), so the caret, the typed text and a hint laid over the box
                (the search boxes) share one centre line in a box taller than its text; a box of several lines starts at the top.
            -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- A sunken field: its edge the theme's well edge (WellBorderBrush over WellBorderLowerBrush). -->
                        <local:ButtonChrome x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" OutlineTakesRoom="True"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <!--
                                Centred unless the box says otherwise (VerticalContentAlignment: Center by default, Top for several lines).
                                No Margin or Padding here: the TextBox's text view insets the text by Padding already, so a margin bound to
                                it counted it twice (4.2C finding 3).
                            -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0" Padding="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="border" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="9,5" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <local:ButtonChrome x:Name="border" Background="{DynamicResource ControlBrush}"
                                                            BorderBrush="{DynamicResource RaisedBorderBrush}" LowerBorderBrush="{DynamicResource RaisedBorderLowerBrush}"
                                                            BorderThickness="1" OutlineTakesRoom="True"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" />
                                        </local:ButtonChrome>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="border" Property="LowerBorderBrush" Value="{x:Null}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,6,28,6" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!--
                            The box is a sunken well (WellBrush in the theme's well edge). Ticked, the flat themes fill it with the
                            accent and a white mark; Reno and Reno Dark keep the well and draw a crisp mark in it (CheckedBoxBrush,
                            CheckedBoxBorderBrush, CheckMarkBrush, 4.2B-3). Focused, the label is ringed by the dotted rectangle.
                        -->
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <local:ButtonChrome x:Name="box" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource WellBrush}" BorderBrush="{DynamicResource WellBorderBrush}"
                                                LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" BorderThickness="1" OutlineTakesRoom="True" SnapsToDevicePixels="True">
                                <Path x:Name="check" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,4 L3.5,7.5 L10,0" Stroke="{DynamicResource CheckMarkBrush}" StrokeThickness="2" />
                            </local:ButtonChrome>
                            <local:ButtonChrome x:Name="label" BorderThickness="0" DottedInset="0" Padding="2,1" Margin="6,-1,0,-1" VerticalAlignment="Center">
                                <ContentPresenter RecognizesAccessKey="True" />
                            </local:ButtonChrome>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource CheckedBoxBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckedBoxBorderBrush}" />
                                <Setter TargetName="box" Property="LowerBorderBrush" Value="{DynamicResource CheckedBoxBorderLowerBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="label" Property="DottedOutlineBrush" Value="{DynamicResource DottedFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="box" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" />
                            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="0,6,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- The tab shown is traced along its top edge (2 px, ActiveTabTraceBrush); the others keep the room for it.
                             Outlined where the theme gives tab edges (TabEdgeThickness, 4.1.1: Reno, Reno Dark). -->
                        <Border x:Name="edge" BorderBrush="{DynamicResource TabEdgeBrush}" BorderThickness="{DynamicResource TabEdgeThickness}"
                                CornerRadius="{DynamicResource TabCornerRadius}" Margin="0,0,2,0">
                            <Border x:Name="border" Background="{DynamicResource InactiveTabBrush}" CornerRadius="{DynamicResource TabCornerRadius}" BorderThickness="0,2,0,0"
                                    BorderBrush="Transparent" Padding="16,6,16,8">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ActiveTabTraceBrush}" />
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource ActiveTabEdgeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--
                            A 1 px edge kept for the chosen row's trace (SelectedBorderBrush), so choosing a row never moves it; the
                            chosen row (a track, a tile) of the list with the focus is also ringed by the theme's dotted rectangle just
                            inside it (4.2B-3, Reno).
                        -->
                        <local:ButtonChrome x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" OutlineTakesRoom="True"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" DottedInset="2" Padding="7,2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SelectedRowBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                            <!-- Ringed only while its list has the focus: the dotted rectangle is on one thing at a time, the last one clicked. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="DottedOutlineBrush" Value="{DynamicResource DottedFocusBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- A well: the theme's list colour, sunk by its edge where the theme lights one (WellBorderBrush over WellBorderLowerBrush). -->
                        <local:ButtonChrome Background="{DynamicResource WellBrush}" BorderBrush="{DynamicResource WellBorderBrush}"
                                            LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" OutlineTakesRoom="True"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="2">
                            <!-- Scrolling by item rather than by pixel is what allows the list to create only the rows in view. -->
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </local:ButtonChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!--
            A splitter that stays out of sight until the pointer is on it. The visible line is as thin as the
            splitter itself; the transparent area around it is wider, so it is still easy to grab.
        -->
        <Style x:Key="QuietSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Margin="-3">
                            <Border x:Name="line" Margin="3" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded container used for the main sections of the window. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <local:ButtonChrome BorderBrush="{DynamicResource RaisedBorderBrush}" LowerBorderBrush="{DynamicResource RaisedBorderLowerBrush}" BorderThickness="1"
                                            OutlineTakesRoom="True" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource CardBrush}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,8,12,0" TextElement.FontWeight="SemiBold" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </local:ButtonChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The number box that sits beside a slider: type a value, or drag it sideways (see NumericInput). -->
        <!-- Right-click menus, in the colours of the theme: the flyouts' raised surface (FlyoutChrome, 4.2B-3). -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RaisedBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <local:ButtonChrome Style="{StaticResource FlyoutChrome}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="3">
                            <StackPanel IsItemsHost="True" />
                        </local:ButtonChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <!--
                            The words, with (4.2B-3) a drawn icon before them when the item has one (Icon: a Path, e.g. a transition's
                            glyph), a tick in the left margin when the item is checked, and, for an item with items of its own, an
                            arrow and the submenu beside it on the flyouts' raised surface.
                        -->
                        <Border x:Name="back" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,6,22,6">
                            <Grid>
                                <Path x:Name="tick" Data="M0,3.5 L2.75,6.25 L8,0.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" Margin="-11,0,0,0" Visibility="Collapsed" />
                                <DockPanel>
                                    <ContentPresenter x:Name="icon" DockPanel.Dock="Left" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Path x:Name="arrow" DockPanel.Dock="Right" Data="M0,0 L3.5,3.5 L0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                          VerticalAlignment="Center" Margin="14,0,-12,0" Visibility="Collapsed" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                </DockPanel>
                                <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=back}" Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <local:ButtonChrome Style="{StaticResource FlyoutChrome}" Padding="3" TextElement.Foreground="{DynamicResource TextBrush}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </local:ButtonChrome>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource ControlBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="Drag sideways to adjust (Shift: fine, Ctrl: coarse). Click to type. Double-click to reset." />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!--
            Scrollbars, everywhere: a flat, rounded bar and nothing else. No arrow buttons; the track is empty and
            pages when clicked. How thick they are is one number, set in Settings (Interface) and changed live.
        -->
        <sys:Double x:Key="GlobalScrollBarThickness">10</sys:Double>
        <SolidColorBrush x:Key="ScrollThumbBrush" po:Freeze="True" Color="#7C8794" Opacity="0.55" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" po:Freeze="True" Color="#9AA6B4" Opacity="0.85" />

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bar" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="{DynamicResource GlobalScrollBarThickness}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="{DynamicResource GlobalScrollBarThickness}" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
