<Window x:Class="HandPegApp.LayerToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- One of three panels is shown. Bound straight to the clip: every change shows in the command, and in Live Preview, at once. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Filters of the clip's own: a view onto the clip's effects (Flip, LUT 3D, Denoise, Color Grade, Hue, Blur, Sharpen). -->
        <StackPanel x:Name="FiltersPanel" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}"
                   Text="These are effects of the clip's effect stack, set here for this clip alone. The Effects pane shows the whole stack in order, with more effects, per clip." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Contrast:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2" VerticalAlignment="Center"
                    Value="{Binding FilterContrast}" AutomationProperties.Name="Clip Contrast" local:NumericInput.Default="1"
                    ToolTip="1 leaves the contrast as it is." />
            <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterContrast, StringFormat={}{0:0.00}}"
                     AutomationProperties.Name="Clip Contrast Value" local:NumericInput.Default="1" local:NumericInput.DragStep="0.005" local:NumericInput.Decimals="2"
                     local:NumericInput.Minimum="0" local:NumericInput.Maximum="2" />
            <TextBlock Grid.Row="1" Text="Brightness:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" VerticalAlignment="Center"
                    Value="{Binding FilterBrightness}" AutomationProperties.Name="Clip Brightness" local:NumericInput.Default="0"
                    ToolTip="0 leaves the brightness as it is." />
            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterBrightness, StringFormat={}{0:0.00}}"
                     AutomationProperties.Name="Clip Brightness Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.005" local:NumericInput.Decimals="2"
                     local:NumericInput.Minimum="-1" local:NumericInput.Maximum="1" />
            <TextBlock Grid.Row="2" Text="Saturation:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" VerticalAlignment="Center"
                    Value="{Binding FilterSaturation}" AutomationProperties.Name="Clip Saturation" local:NumericInput.Default="1"
                    ToolTip="1 leaves the colors as they are; 0 is black and white." />
            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterSaturation, StringFormat={}{0:0.00}}"
                     AutomationProperties.Name="Clip Saturation Value" local:NumericInput.Default="1" local:NumericInput.DragStep="0.005" local:NumericInput.Decimals="2"
                     local:NumericInput.Minimum="0" local:NumericInput.Maximum="3" />
            <TextBlock Grid.Row="3" Text="Gamma:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.1" Maximum="3" VerticalAlignment="Center"
                    Value="{Binding FilterGamma}" AutomationProperties.Name="Clip Gamma" local:NumericInput.Default="1"
                    ToolTip="1 leaves the midtones as they are; higher lifts them." />
            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterGamma, StringFormat={}{0:0.00}}"
                     AutomationProperties.Name="Clip Gamma Value" local:NumericInput.Default="1" local:NumericInput.DragStep="0.005" local:NumericInput.Decimals="2"
                     local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="3" />
            <TextBlock Grid.Row="4" Text="Hue:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" VerticalAlignment="Center"
                    Value="{Binding FilterHue}" AutomationProperties.Name="Clip Hue" local:NumericInput.Default="0"
                    ToolTip="Turns every color round the color wheel, in degrees." />
            <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterHue, StringFormat={}{0:0}}"
                     AutomationProperties.Name="Clip Hue Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="0"
                     local:NumericInput.Minimum="-180" local:NumericInput.Maximum="180" />
            <TextBlock Grid.Row="5" Text="Sharpen:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                    Value="{Binding FilterSharpen}" AutomationProperties.Name="Clip Sharpen" local:NumericInput.Default="0"
                    ToolTip="Contrast-adaptive sharpening of this clip alone." />
            <TextBox Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterSharpen, StringFormat={}{0:0.00}}"
                     AutomationProperties.Name="Clip Sharpen Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.005" local:NumericInput.Decimals="2"
                     local:NumericInput.Minimum="0" local:NumericInput.Maximum="1" />
            <TextBlock Grid.Row="6" Text="Blur:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="50" VerticalAlignment="Center"
                    Value="{Binding FilterBlur}" AutomationProperties.Name="Clip Blur" local:NumericInput.Default="0"
                    ToolTip="Blurs this clip alone: how far, in pixels of a frame 1080 wide." />
            <TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FilterBlur, StringFormat={}{0:0.0}}"
                     AutomationProperties.Name="Clip Blur Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1"
                     local:NumericInput.Minimum="0" local:NumericInput.Maximum="50" />
        </Grid>
            <CheckBox Content="Denoise" IsChecked="{Binding FilterDenoise}" Margin="0,8,0,0" ToolTip="Takes noise out of this clip alone (hqdn3d)." />
            <TextBlock Text="LUT (.cube) for this clip:" Margin="0,10,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" Click="ClearLut_Click" />
                <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="BrowseLut_Click" />
                <TextBox Text="{Binding FilterLut, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="Clip LUT"
                         ToolTip="A 3D LUT whose look is given to this clip only." />
            </DockPanel>
        </StackPanel>

        <!-- Where it is, how large, and how it is turned -->
        <StackPanel x:Name="MaskPanel" Visibility="Collapsed">
            <CheckBox Content="Use a mask" IsChecked="{Binding CustomMask}"
                      ToolTip="Cuts the clip to a shape: a black-and-white picture, which shows where it is white and is see-through where it is black." />
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="BrowseMask_Click" />
                <TextBox Text="{Binding MaskPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="Clip Mask File"
                         ToolTip="A .png or .jpg in black and white (white shows), or a .png with transparency (what is painted shows, in any colour, and what is see-through is cut away): of the whole video frame, or stretched to the size of the clip." />
            </DockPanel>
            <CheckBox x:Name="MaskFrameBox" Content="The mask is of the whole video frame" IsChecked="{Binding MaskFrame}" Margin="0,6,0,0" AutomationProperties.Name="Mask Covers the Whole Frame"
                      ToolTip="Ticked, the mask is a picture of the whole frame, white over every HUD element at once: this clip takes the part of it under its own area, as it takes the picture, so one mask serves every Cutout of the video, and redrawing a Cutout's area keeps the mask where it is. Cleared, the mask is stretched over the clip." />
            <StackPanel x:Name="FrameMaskButtons" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Draw Custom Shape..." Padding="12,4" Click="DrawShape_Click" AutomationProperties.Name="Draw Custom Shape"
                        ToolTip="Opens a still of the video at the playhead: click around a HUD element, point by point, to draw its outline; the lines join up, and clicking the first point closes the shape. Draw as many shapes as you like. They become a mask of the whole frame, for this clip or for every Cutout of the video." />
                <Button x:Name="ShareMaskButton" Content="Use This Mask for All Cutouts" Padding="12,4" Margin="6,0,0,0" Click="ShareMask_Click" AutomationProperties.Name="Use Mask for All Cutouts"
                        ToolTip="Gives every Cutout of the video this mask of the whole frame: each one cuts its own part out of it, and stays a clip of its own." />
            </StackPanel>
            <Button x:Name="MaskLayersButton" Content="Make Cutouts from This Mask..." Padding="12,4" Margin="0,6,0,0" HorizontalAlignment="Left" Click="MaskLayers_Click"
                    AutomationProperties.Name="Make Cutouts from This Mask"
                    ToolTip="Takes this mask of the whole frame apart into one Cutout per HUD element it shows (patches close together are one element), all sharing the mask." />
            <TextBlock Text="Ready-made shapes (stretched over the clip):" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Soft Rectangle" Padding="12,4" Tag="Soft" Click="Shape_Click" ToolTip="A rectangle whose edges fade out all the way round." />
                <Button Content="Ellipse" Padding="12,4" Margin="6,0,0,0" Tag="Ellipse" Click="Shape_Click" ToolTip="A circle or oval with a soft edge: a round radar, an ultimate meter." />
                <Button Content="Slant" Padding="12,4" Margin="6,0,0,0" Tag="Slant" Click="Shape_Click" ToolTip="A bar leaning to the right, as slanted health bars do." />
                <Button Content="No Mask" Padding="12,4" Margin="6,0,0,0" Click="NoMask_Click" ToolTip="Takes the mask off: the clip is its whole rectangle again." />
            </StackPanel>

            <TextBlock Text="Mask options:" Margin="0,14,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Grow / Shrink:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="-40" Maximum="40" VerticalAlignment="Center"
                    Value="{Binding MaskGrow}" AutomationProperties.Name="Mask Grow" local:NumericInput.Default="0"
                    ToolTip="Grows what the mask shows outwards (to the right), to take in a glow or a border round a HUD element, or shrinks it inwards (to the left), to trim one off. In pixels of the finished video." />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding MaskGrow, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Mask Grow Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0"
                         local:NumericInput.Minimum="-40" local:NumericInput.Maximum="40" />
                <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Mask Offset X (%):" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="50" VerticalAlignment="Center"
                    Value="{Binding MaskOffsetX}" AutomationProperties.Name="Mask Offset X" local:NumericInput.Default="0"
                    ToolTip="Moves the mask picture left (negative) or right across the clip, as a percentage of its width: one HUD mask nudged to fit a variation of the HUD, without drawing it again. What it uncovers at the far edge is hidden. Double-click to put it back to 0." />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding MaskOffsetX, StringFormat={}{0:0.0}}"
                         AutomationProperties.Name="Mask Offset X Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="-50" local:NumericInput.Maximum="50" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Mask Offset Y (%):" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="-50" Maximum="50" VerticalAlignment="Center"
                    Value="{Binding MaskOffsetY}" AutomationProperties.Name="Mask Offset Y" local:NumericInput.Default="0"
                    ToolTip="Moves the mask picture up (negative) or down across the clip, as a percentage of its height. What it uncovers at the far edge is hidden. Double-click to put it back to 0." />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding MaskOffsetY, StringFormat={}{0:0.0}}"
                         AutomationProperties.Name="Mask Offset Y Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="-50" local:NumericInput.Maximum="50" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
            <CheckBox Content="Invert mask" IsChecked="{Binding MaskInvert}" Margin="0,4,0,0" AutomationProperties.Name="Invert Mask"
                      ToolTip="The clip shows where the mask is black instead of where it is white." />

            <TextBlock Text="Crop (cuts the picture's edges; the box keeps its width and takes the cut picture's shape):" Margin="0,14,0,2" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Left:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="95" VerticalAlignment="Center"
                    Value="{Binding CropLeftPercent}" AutomationProperties.Name="Crop Left" local:NumericInput.Default="0"
                    ToolTip="How much of the clip's left edge is cut away, as a percentage of its width. Use it to take out a part of a HUD Cutout you do not want, such as an empty ability slot." />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding CropLeftPercent, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Crop Left Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Right:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="95" VerticalAlignment="Center"
                    Value="{Binding CropRightPercent}" AutomationProperties.Name="Crop Right" local:NumericInput.Default="0"
                    ToolTip="How much of the clip's right edge is cut away, as a percentage of its width." />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding CropRightPercent, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Crop Right Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Top:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="95" VerticalAlignment="Center"
                    Value="{Binding CropTopPercent}" AutomationProperties.Name="Crop Top" local:NumericInput.Default="0"
                    ToolTip="How much of the clip's top edge is cut away, as a percentage of its height." />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding CropTopPercent, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Crop Top Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Bottom:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="95" VerticalAlignment="Center"
                    Value="{Binding CropBottomPercent}" AutomationProperties.Name="Crop Bottom" local:NumericInput.Default="0"
                    ToolTip="How much of the clip's bottom edge is cut away, as a percentage of its height." />
            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding CropBottomPercent, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Crop Bottom Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="1"
                         local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

            <TextBlock Text="Outline:" Margin="0,14,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Corner Radius:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="50" VerticalAlignment="Center"
                    Value="{Binding CornerRadius}" AutomationProperties.Name="Mask Corner Radius" local:NumericInput.Default="0"
                    ToolTip="Rounds the corners of the clip's rectangle, as a percentage of its shorter side." />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding CornerRadius, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Mask Corner Radius Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="0"
                         local:NumericInput.Minimum="0" local:NumericInput.Maximum="50" />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Soft Edge:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="80" VerticalAlignment="Center"
                    Value="{Binding FeatherRadius}" AutomationProperties.Name="Mask Soft Edge" local:NumericInput.Default="12"
                    ToolTip="How wide the soft edge is, in pixels, while Soft Edges is ticked." />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource ValueBox}" Width="56" Margin="8,0,0,0" Text="{Binding FeatherRadius, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Mask Soft Edge Value" local:NumericInput.Default="12" local:NumericInput.DragStep="0.25" local:NumericInput.Decimals="0"
                         local:NumericInput.Minimum="1" local:NumericInput.Maximum="80" />
                <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
            <CheckBox Content="Soft Edges" IsChecked="{Binding Feather}" Margin="0,6,0,0" AutomationProperties.Name="Soft Edges"
                      ToolTip="Lets the edges fade out over the width set above: the mask's outline and the crop's when there is a mask, otherwise the edges of the clip itself." />
            <Button x:Name="RedrawButton" Content="Redraw Area on Video..." Padding="12,5" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Redraw_Click"
                    ToolTip="Closes this window and lets you drag a new rectangle on the video: what this clip cuts out of it. Use it when the game's HUD sits a little differently in your recording." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="UndoButton" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,4" Click="Undo_Click" IsEnabled="False"
                    ToolTip="Undo (Ctrl+Z)" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Undo" />
            <Button x:Name="RedoButton" Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,4" Margin="4,0,14,0" Click="Redo_Click" IsEnabled="False"
                    ToolTip="Redo (Ctrl+Y)" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Redo" />
            <Button Content="Reset" MinWidth="88" Click="Reset_Click" ToolTip="Puts what this window sets back to how a new clip has it." />
            <Button Content="Close" MinWidth="88" Margin="6,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
