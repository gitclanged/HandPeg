<Window x:Class="HandPegApp.PrivacyPolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Policy" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ListTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Item" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <!-- An item's mark: a cross for what is never collected, a tick for what a report holds (Segoe MDL2 glyphs). -->
        <Style x:Key="Mark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <!-- Scrolls on a screen too short for all of it; the window is never taller than the work area. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="20">
            <TextBlock Text="Crash reports and your privacy" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"
                       Text="When HandPeg falls over, it writes a crash report: a small text file that helps find and fix what went wrong. It is kept on this PC, in your crash reports folder, and is never sent anywhere by HandPeg: to share one, attach it to an issue on HandPeg's GitHub page. Nothing is written while the box below is clear." />

            <!-- The switch itself (AppSettings.SendCrashReports), saved as soon as it is changed. -->
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="SendBox" Content="Save anonymous crash reports" FontWeight="SemiBold"
                              Checked="SendBox_Changed" Unchecked="SendBox_Changed" AutomationProperties.Name="Save anonymous crash reports"
                              ToolTip="On: crash reports are written to this PC (never sent). Off: none is written, and the watcher process does not run. Saved at once." />
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="22,4,0,0" FontSize="12"
                               Text="Uses 0% CPU during normal editing, 20 KB of shared memory, and a ~6.8 MB idle background sentinel process." />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- What is never collected -->
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Never collected" Style="{StaticResource ListTitle}" />
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="File names and folder paths" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Your Windows user name, or this PC's name" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Web addresses, such as the links you load" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="What is in your media: its pictures and sound" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="The words of subtitles, captions and text layers, and titles" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Your projects, presets and settings" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE711;" Style="{StaticResource Mark}" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Serial numbers, or any ID that tells this PC apart from another of the same model" Margin="0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- What a crash report holds -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="What a crash report holds" Style="{StaticResource ListTitle}" />
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="HandPeg's version and the Windows version" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="The processor's model, its cores and threads (whether SMT is on), and the memory installed with its speed" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Each graphics card's model, driver version and video memory" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="The main display's resolution, scale and refresh rate; HandPeg's theme; Windows' power plan and whether Efficiency mode is on" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="The versions of FFmpeg, libmpv, whisper.cpp and yt-dlp, and the memory HandPeg was using" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="The stack trace: the names of the parts of HandPeg that were running, and the error" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Anonymized breadcrumbs: HandPeg's last few steps, such as &quot;media opened&quot; or &quot;export started&quot;" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="Media as kinds and numbers: container, codecs, resolution, frame rate and duration" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mark}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Item}" Text="For a crash in a library or a driver: the error code and the file it happened in, such as libmpv-2.dll" Margin="0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Switch crash reports off with the box above, or in Settings, on the General tab under Diagnostics. Switched off, none is written, and the small watcher process that catches crashes in libraries and drivers does not run. A report is plain text: open one in any text editor to see exactly what it says before sharing it." />
            <TextBlock x:Name="FolderText" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />

            <DockPanel Margin="0,18,0,0">
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="88" IsCancel="True" IsDefault="True" />
                <Button Content="Open Local Crash Logs Folder" HorizontalAlignment="Left" Padding="12,4" Click="OpenFolder_Click"
                        AutomationProperties.Name="Open Local Crash Logs Folder"
                        ToolTip="Opens the folder the crash reports are kept in (made now if there is none yet)." />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
