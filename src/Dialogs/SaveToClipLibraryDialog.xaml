<Window x:Class="HandPegApp.SaveToClipLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Clip to Personal Clip Library" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- A clip's span kept in the user's own library (Services/ClipLibrary.cs): its title, its tags, and what is kept. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="WhatText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
        <TextBlock Text="Title:" Margin="0,0,0,4" />
        <TextBox x:Name="TitleBox" Padding="6,5" MaxLength="80" AutomationProperties.Name="Clip Title" TextChanged="TitleBox_TextChanged"
                 ToolTip="What the clip is called in the Clip Library (and its file's name there)." />
        <TextBlock Text="Tags (separated by commas):" Margin="0,12,0,4" />
        <TextBox x:Name="TagsBox" Padding="6,5" MaxLength="200" AutomationProperties.Name="Clip Tags"
                 ToolTip="Words to find it by in the Clip Library's search: reaction, win, funny, sound effect..." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Save to Library" MinWidth="120" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" MinWidth="88" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
