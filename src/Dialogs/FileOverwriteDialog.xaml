<Window x:Class="HandPegApp.FileOverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Already Exists" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="A file with this name already exists:" />
        <TextBlock x:Name="ExistingPathText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,14" />

        <TextBlock Text="Save under a new name instead:" Margin="0,0,0,4" />
        <TextBox x:Name="NewNameBox" TextChanged="NewNameBox_TextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Overwrite" MinWidth="96" Click="Overwrite_Click" ToolTip="Replace the existing file." />
            <Button Content="Rename" MinWidth="96" Margin="6,0,0,0" IsDefault="True" Click="Rename_Click"
                    ToolTip="Keep the existing file and write to the name above." />
            <Button Content="Cancel" MinWidth="96" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
