<Window x:Class="HandPegApp.CombinatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Combinator" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Joins two videos into one: Video A, then Video B. Both are scaled to fit the chosen frame, with black bars where their shape differs, and re-encoded as H.264 with AAC sound. The first audio track of each is used." />

        <Grid x:Name="InputPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Video A:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" x:Name="PathABox" Margin="0,4" AllowDrop="True" PreviewDragOver="PathBox_PreviewDragOver" Drop="PathBox_Drop"
                     TextChanged="PathBox_TextChanged" AutomationProperties.Name="Video A" ToolTip="The video that plays first. A file can be dropped here." />
            <Button Grid.Column="2" Content="Browse..." Margin="6,4,0,4" Tag="{Binding ElementName=PathABox}" Click="Browse_Click" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoAText" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,6" />

            <TextBlock Grid.Row="2" Text="Video B:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PathBBox" Margin="0,4" AllowDrop="True" PreviewDragOver="PathBox_PreviewDragOver" Drop="PathBox_Drop"
                     TextChanged="PathBox_TextChanged" AutomationProperties.Name="Video B" ToolTip="The video that plays second. A file can be dropped here." />
            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="6,4,0,4" Tag="{Binding ElementName=PathBBox}" Click="Browse_Click" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoBText" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,6" />

            <TextBlock Grid.Row="4" Text="Resolution Match:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ResolutionBox" HorizontalAlignment="Left" MinWidth="220" Margin="0,4"
                      SelectionChanged="Choice_SelectionChanged" AutomationProperties.Name="Resolution Match"
                      ToolTip="The frame both videos are brought to. A video of another shape is fitted inside it, with black bars." />

            <TextBlock Grid.Row="5" Text="Transition Type:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TransitionBox" HorizontalAlignment="Left" MinWidth="220" Margin="0,4"
                      SelectionChanged="Choice_SelectionChanged" AutomationProperties.Name="Transition Type"
                      ToolTip="Hard Splice: B starts on the frame after A ends. Crossfade: A fades into B over one second, picture and sound. Dip to Black: A fades to black and B fades in from it, over one second." />
        </Grid>

        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" />
        <ProgressBar x:Name="Progress" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="1" AutomationProperties.Name="Combinator Progress" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="Combinator Status" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ExportButton" Content="Export to File..." MinWidth="120" Click="Export_Click"
                    ToolTip="Join the two videos and save the result where you choose." />
            <Button x:Name="SendButton" Content="Send to Editor" MinWidth="120" Margin="6,0,0,0" Click="Send_Click"
                    ToolTip="Join the two videos into a temporary file and load it straight into HandPeg. The file is kept until HandPeg closes, so encode from it before then." />
            <Button x:Name="CloseButton" Content="Close" MinWidth="88" Margin="6,0,0,0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
