<Window x:Class="HandPegApp.CombinatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Combinator" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Joins up to five videos into one, in the order listed. Each is scaled to fit the chosen frame, with black bars where its shape differs, and re-encoded as H.264 with AAC sound. Every audio track is kept: a video with fewer tracks than the others gets silence for the ones it lacks." />

        <StackPanel x:Name="InputPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The videos, in playing order. Files can be dropped on the list. -->
                <ListBox x:Name="FileList" Height="186" AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop"
                         SelectionChanged="FileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Videos to Combine">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1" ToolTip="{Binding Path}">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding FileName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="AddButton" Content="Add Videos..." MinWidth="120" Click="Add_Click"
                            ToolTip="Choose one video or several at once (hold Ctrl or Shift in the file dialog). They are added in name order, up to five in all." />
                    <Button x:Name="RemoveButton" Content="Remove" Margin="0,6,0,0" Click="Remove_Click" ToolTip="Take the selected video out of the list." />
                    <Button x:Name="UpButton" Content="Move Up" Margin="0,6,0,0" Click="MoveUp_Click" ToolTip="Play the selected video earlier." />
                    <Button x:Name="DownButton" Content="Move Down" Margin="0,6,0,0" Click="MoveDown_Click" ToolTip="Play the selected video later." />
                    <Button x:Name="ClearButton" Content="Clear" Margin="0,6,0,0" Click="Clear_Click" ToolTip="Empty the list." />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Resolution Match:" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" x:Name="ResolutionBox" MinWidth="200" Margin="0"
                          SelectionChanged="Choice_SelectionChanged" AutomationProperties.Name="Resolution Match"
                          ToolTip="The frame every video is brought to. A video of another shape is fitted inside it, with black bars." />
                <TextBlock Grid.Column="2" Text="Transition Type:" VerticalAlignment="Center" Margin="24,0,12,0" />
                <ComboBox Grid.Column="3" x:Name="TransitionBox" MinWidth="170" Margin="0"
                          SelectionChanged="Choice_SelectionChanged" AutomationProperties.Name="Transition Type"
                          ToolTip="Between each video and the next. Hard Splice: the next starts on the frame after the last ends. Crossfade: one fades into the other over one second, picture and every audio track. Dip to Black: fades to black and in again, over one second." />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="Combinator Summary" />
        <ProgressBar x:Name="Progress" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="1" AutomationProperties.Name="Combinator Progress" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="Combinator Status" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ExportButton" Content="Export to File..." MinWidth="120" Click="Export_Click"
                    ToolTip="Join the videos and save the result where you choose." />
            <Button x:Name="SendButton" Content="Send to Editor" MinWidth="120" Margin="6,0,0,0" Click="Send_Click"
                    ToolTip="Join the videos into a temporary file and load it straight into HandPeg. The file is kept until HandPeg closes, so encode from it before then." />
            <Button x:Name="CloseButton" Content="Close" MinWidth="88" Margin="6,0,0,0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
