<Window x:Class="HandPegApp.VoiceoverStudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        Title="Voiceover Studio" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:DecibelToScaleConverter x:Key="DecibelToScale" />
        <!-- The three transport buttons: round, with a drawn shape in the middle -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <!-- Bound straight to the main window's settings: the voiceover made here is part of the next encode. -->
    <StackPanel Margin="16">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Record a voiceover while the video plays in the main window, or bring one in from a file. It is added to the encode as a second input and mixed into the first audio track, after any cuts." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Microphone:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                      AutomationProperties.Name="Microphone" />
            <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Padding="10,5" Margin="6,0,0,0"
                    Command="{Binding RefreshMicrophonesCommand}" ToolTip="Look for microphones again" AutomationProperties.Name="Refresh Microphones" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource TransportButton}" Command="{Binding RecordVoiceoverCommand}" AutomationProperties.Name="Record"
                    ToolTip="Record. After a pause, carries the same recording on.">
                <Ellipse Width="16" Height="16" Fill="#EF5350" />
            </Button>
            <Button Style="{StaticResource TransportButton}" Command="{Binding PauseVoiceoverCommand}" AutomationProperties.Name="Pause"
                    ToolTip="Pause the recording. Record carries on from here.">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="5" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Width="5" Height="16" Margin="4,0,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TransportButton}" Command="{Binding StopVoiceoverCommand}" AutomationProperties.Name="Stop"
                    ToolTip="Stop: finishes the recording and makes it the voiceover.">
                <Rectangle Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Content="Import Audio File..." Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center" Click="Import_Click"
                    ToolTip="Use an existing audio file as the voiceover instead of recording one." />
            <Button Content="Remove Voiceover" Padding="12,5" Margin="6,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveVoiceoverCommand}"
                    IsEnabled="{Binding HasVoiceover}" />
        </StackPanel>

        <TextBlock Text="{Binding VoiceoverStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.Name="Voiceover Status" />

        <!-- The voiceover itself: its waveform, with handles for the part to keep -->
        <StackPanel Visibility="{Binding HasVoiceover, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
            <Border Height="84" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding VoiceoverWaveform}" Stretch="Fill" Margin="5,0" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Voiceover Waveform">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleY="{Binding VoiceoverGainDb, Converter={StaticResource DecibelToScale}}" />
                        </Image.RenderTransform>
                    </Image>
                    <local:RangeSlider Minimum="0" Maximum="{Binding VoiceoverDuration}"
                                       LowerValue="{Binding VoiceoverTrimStart}" UpperValue="{Binding VoiceoverTrimEnd}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding VoiceoverTrimText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Gain (dB):" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Minimum="-24" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Value="{Binding VoiceoverGainDb}" AutomationProperties.Name="Voiceover Gain" local:NumericInput.Default="0" />
                <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Width="48" Text="{Binding VoiceoverGainDb, StringFormat={}{0:0}}"
                         AutomationProperties.Name="Voiceover Gain Value"
                         local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-24" local:NumericInput.Maximum="24" />
                <TextBlock Grid.Column="3" Text="Starts At (s):" VerticalAlignment="Center" Margin="20,0,0,0"
                           ToolTip="How far into the finished video the voiceover begins." />
                <TextBox Grid.Column="4" Style="{StaticResource ValueBox}" Text="{Binding VoiceoverStartSeconds, StringFormat={}{0:0.00}}"
                         AutomationProperties.Name="Voiceover Starts At"
                         local:NumericInput.Default="0" local:NumericInput.DragStep="0.05" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0" local:NumericInput.Maximum="86400" />
            </Grid>

            <CheckBox Content="Mix voiceover into the output" IsChecked="{Binding MixVoiceover}" Margin="0,10,0,0"
                      ToolTip="Off keeps the voiceover for captions only. It is always mixed in when the captions are made from it." />
        </StackPanel>

        <Button Content="Close" MinWidth="88" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
    </StackPanel>
</Window>
