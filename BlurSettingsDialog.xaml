<Window x:Class="HandPegApp.BlurSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        Title="Blur Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Bound straight to the main window's settings: every change shows in the command at once. -->
    <StackPanel Margin="16">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="The background of the Frame &amp; Layer Engine: a copy of the video, zoomed to fill the frame, blurred and darkened. Use Render Preview to see the result." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <TextBlock Text="Blur Radius:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="1" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding BlurRadius}" AutomationProperties.Name="Blur Radius" local:NumericInput.Default="20"
                    ToolTip="How far the blur reaches, in pixels. Larger is softer." />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding BlurRadius, StringFormat={}{0:0}}" AutomationProperties.Name="Blur Radius Value" local:NumericInput.Default="20" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0" local:NumericInput.Minimum="5" local:NumericInput.Maximum="50" /></StackPanel>

            <TextBlock Grid.Row="1" Text="Blur Passes:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding BlurPasses}" AutomationProperties.Name="Blur Passes" local:NumericInput.Default="2"
                    ToolTip="How many times the blur is applied. More passes are smoother, and slower to encode." />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding BlurPasses, StringFormat={}{0:0}}" AutomationProperties.Name="Blur Passes Value" local:NumericInput.Default="2" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0" local:NumericInput.Minimum="1" local:NumericInput.Maximum="5" /></StackPanel>

            <TextBlock Grid.Row="2" Text="Background Dimming:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="-0.5" Maximum="0" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding BackgroundDim}" AutomationProperties.Name="Background Dimming" local:NumericInput.Default="-0.15"
                    ToolTip="Darkens the background so the sharp video stands out. 0 leaves it as bright as the video." />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding BackgroundDim, StringFormat={}{0:0.00}}" AutomationProperties.Name="Background Dimming Value" local:NumericInput.Default="-0.15" local:NumericInput.DragStep="0.002" local:NumericInput.Decimals="2" local:NumericInput.Minimum="-0.5" local:NumericInput.Maximum="0" /></StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset to Defaults" Command="{Binding ResetBlurSettingsCommand}" />
            <Button Content="Close" MinWidth="88" Margin="6,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
