<Application x:Class="HandPegApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:HandPegApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            What a drop area shows: a video file (a page with its corner folded and a play triangle on it) and a link
            (two loops of a chain over its lower right): files or links. Drawn with a stroke, as the drop targets' icons are.
        -->
        <GeometryGroup x:Key="DropFileOrLinkIcon" FillRule="Nonzero">
            <PathGeometry Figures="M 36,33 L 36,12 L 27,3 L 8,3 L 8,44 L 29,44 M 27,3 L 27,12 L 36,12" />
            <PathGeometry Figures="M 17,18 L 28,24.5 L 17,31 Z" />
            <RectangleGeometry Rect="29.5,40 18,8" RadiusX="4" RadiusY="4">
                <RectangleGeometry.Transform>
                    <RotateTransform Angle="-45" CenterX="38.5" CenterY="44" />
                </RectangleGeometry.Transform>
            </RectangleGeometry>
            <RectangleGeometry Rect="37.5,32 18,8" RadiusX="4" RadiusY="4">
                <RectangleGeometry.Transform>
                    <RotateTransform Angle="-45" CenterX="46.5" CenterY="36" />
                </RectangleGeometry.Transform>
            </RectangleGeometry>
        </GeometryGroup>

        <!-- The Layout button: a window of panes (a large one, two beside it, a band under them), drawn with a stroke as the header's other drawn icon is. -->
        <GeometryGroup x:Key="LayoutIcon" FillRule="Nonzero">
            <RectangleGeometry Rect="2,3 20,18" RadiusX="2.5" RadiusY="2.5" />
            <PathGeometry Figures="M 2,14.5 L 22,14.5 M 14.5,3 L 14.5,14.5 M 14.5,8.75 L 22,8.75" />
        </GeometryGroup>

        <!--
            The palette. These are the dark colours; ThemeManager replaces the brushes at startup and whenever
            the theme or the Windows accent changes, which is why everything refers to them dynamically.
        -->
        <SolidColorBrush x:Key="InsetBrush" po:Freeze="True" Color="#181818" />
        <SolidColorBrush x:Key="OnAccentBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" po:Freeze="True" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBrush" po:Freeze="True" Color="#252525" />
        <SolidColorBrush x:Key="ControlBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ControlHoverBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ControlBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" po:Freeze="True" Color="#A0A0A0" />
        <SolidColorBrush x:Key="DisabledTextBrush" po:Freeze="True" Color="#6A6A6A" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="AccentHoverBrush" po:Freeze="True" Color="#1A8AE5" />
        <SolidColorBrush x:Key="AccentPressedBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="WarningTextBrush" po:Freeze="True" Color="#E0A040" />

        <!--
            The theme's look (Pass 4.1C, ThemeManager.LookDefaults and each palette): button faces, their outline and the
            light top-left edge that embosses them (transparent: flat), hover and chosen fills and edges, the line that
            traces the active tab, the cards' surface, and the rounding of controls, cards and boxed tabs. One set of
            templates reads them all; these are the dark defaults until the theme is applied. Since Pass 4.1C.2 also: the
            tabs not shown, the lists' wells, the sunken edge of wells and viewports, the raised edge of combo boxes and
            cards, and the thickness of that sunken edge on wells that have no border in a flat theme (0 there: nothing
            drawn, nothing moved). A theme may light an edge from the top left (ThemeManager.EdgeTokens): the token is then
            its top and left, and the same name with LowerBrush its bottom and right (null here: one colour all round),
            drawn as lines by the one element that faces the control (ButtonChrome, the time bars).
        -->
        <SolidColorBrush x:Key="CardBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ButtonFaceBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="ButtonTextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="ButtonBevelBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonHoverBrush" po:Freeze="True" Color="#1A8AE5" />
        <SolidColorBrush x:Key="ButtonPressedBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="NeutralButtonBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="NeutralButtonBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="HoverFillBrush" po:Freeze="True" Color="#3A3A3A" />
        <SolidColorBrush x:Key="HoverBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="SelectedFillBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="SelectedBorderBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="SelectedTextBrush" po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ActiveTabTraceBrush" po:Freeze="True" Color="#0078D7" />
        <SolidColorBrush x:Key="InactiveTabBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="TabEdgeBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="ActiveTabEdgeBrush" po:Freeze="True" Color="Transparent" />
        <SolidColorBrush x:Key="TitleBarBrush" po:Freeze="True" Color="#1E1E1E" />
        <SolidColorBrush x:Key="KeyAccentBrush" po:Freeze="True" Color="Gold" />
        <SolidColorBrush x:Key="WellBrush" po:Freeze="True" Color="#2D2D2D" />
        <SolidColorBrush x:Key="WellBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="RaisedBorderBrush" po:Freeze="True" Color="#3F3F3F" />
        <SolidColorBrush x:Key="SelectedRowBrush" po:Freeze="True" Color="#005A9E" />
        <SolidColorBrush x:Key="SelectedRowBorderBrush" po:Freeze="True" Color="#0078D7" />
        <x:Null x:Key="ButtonBorderLowerBrush" />
        <x:Null x:Key="NeutralButtonBorderLowerBrush" />
        <x:Null x:Key="RaisedBorderLowerBrush" />
        <x:Null x:Key="WellBorderLowerBrush" />
        <x:Null x:Key="TabEdgeLowerBrush" />
        <x:Null x:Key="ActiveTabEdgeLowerBrush" />
        <Thickness x:Key="WellEdgeThickness">0</Thickness>
        <Thickness x:Key="TabEdgeThickness">0</Thickness>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="TabCornerRadius">6,6,0,0</CornerRadius>

        <!--
            A button: the theme's face in a 1 px outline, with its bevel (a light top and left edge) just inside, drawn by
            one element (ButtonChrome). The outline and the bevel are drawn over the face, so they take no room: a button
            is as large as it always was. A button with BorderThickness 0 (a row of a flyout's menu) has neither.
        -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:ButtonChrome x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            LowerBorderBrush="{DynamicResource ButtonBorderLowerBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" BevelBrush="{DynamicResource ButtonBevelBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                                <Setter TargetName="chrome" Property="BevelBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource NeutralButtonBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{DynamicResource NeutralButtonBorderLowerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button that stays down: the chosen fill while on, the neutral embossed face while off. -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <local:ButtonChrome x:Name="chrome" Background="{DynamicResource NeutralButtonBrush}" BorderBrush="{DynamicResource NeutralButtonBorderBrush}"
                                            LowerBorderBrush="{DynamicResource NeutralButtonBorderLowerBrush}"
                                            BevelBrush="{DynamicResource ButtonBevelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" OutlineTakesRoom="True"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter TargetName="chrome" Property="LowerBorderBrush" Value="{x:Null}" />
                                <Setter TargetName="chrome" Property="BevelBrush" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- A sunken field: its edge the theme's well edge (WellBorderBrush over WellBorderLowerBrush). -->
                        <local:ButtonChrome x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" OutlineTakesRoom="True"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </local:ButtonChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="border" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="9,5" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <local:ButtonChrome x:Name="border" Background="{DynamicResource ControlBrush}"
                                                            BorderBrush="{DynamicResource RaisedBorderBrush}" LowerBorderBrush="{DynamicResource RaisedBorderLowerBrush}"
                                                            BorderThickness="1" OutlineTakesRoom="True"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" />
                                        </local:ButtonChrome>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="border" Property="LowerBorderBrush" Value="{x:Null}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,6,28,6" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <local:ButtonChrome x:Name="box" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource WellBorderBrush}"
                                                LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" BorderThickness="1" OutlineTakesRoom="True" SnapsToDevicePixels="True">
                                <Path x:Name="check" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,4 L3.5,7.5 L10,0" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" />
                            </local:ButtonChrome>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="box" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="box" Property="LowerBorderBrush" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" />
                            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="0,6,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- The tab shown is traced along its top edge (2 px, ActiveTabTraceBrush); the others keep the room for it.
                             Outlined where the theme gives tab edges (TabEdgeThickness, 4.1.1: Reno, Reno Dark). -->
                        <Border x:Name="edge" BorderBrush="{DynamicResource TabEdgeBrush}" BorderThickness="{DynamicResource TabEdgeThickness}"
                                CornerRadius="{DynamicResource TabCornerRadius}" Margin="0,0,2,0">
                            <Border x:Name="border" Background="{DynamicResource InactiveTabBrush}" CornerRadius="{DynamicResource TabCornerRadius}" BorderThickness="0,2,0,0"
                                    BorderBrush="Transparent" Padding="16,6,16,8">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ActiveTabTraceBrush}" />
                                <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource ActiveTabEdgeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- A 1 px edge kept for the chosen row's trace (SelectedBorderBrush), so choosing a row never moves it. -->
                        <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="7,2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SelectedRowBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- A well: the theme's list colour, sunk by its edge where the theme lights one (WellBorderBrush over WellBorderLowerBrush). -->
                        <local:ButtonChrome Background="{DynamicResource WellBrush}" BorderBrush="{DynamicResource WellBorderBrush}"
                                            LowerBorderBrush="{DynamicResource WellBorderLowerBrush}" OutlineTakesRoom="True"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="2">
                            <!-- Scrolling by item rather than by pixel is what allows the list to create only the rows in view. -->
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </local:ButtonChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!--
            A splitter that stays out of sight until the pointer is on it. The visible line is as thin as the
            splitter itself; the transparent area around it is wider, so it is still easy to grab.
        -->
        <Style x:Key="QuietSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Margin="-3">
                            <Border x:Name="line" Margin="3" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="line" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded container used for the main sections of the window. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <local:ButtonChrome BorderBrush="{DynamicResource RaisedBorderBrush}" LowerBorderBrush="{DynamicResource RaisedBorderLowerBrush}" BorderThickness="1"
                                            OutlineTakesRoom="True" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource CardBrush}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,8,12,0" TextElement.FontWeight="SemiBold" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </local:ButtonChrome>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The number box that sits beside a slider: type a value, or drag it sideways (see NumericInput). -->
        <!-- Right-click menus, in the colours of the theme -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="3">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="back" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,6,22,6">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource ControlBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="Drag sideways to adjust (Shift: fine, Ctrl: coarse). Click to type. Double-click to reset." />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!--
            Scrollbars, everywhere: a flat, rounded bar and nothing else. No arrow buttons; the track is empty and
            pages when clicked. How thick they are is one number, set in Settings (Interface) and changed live.
        -->
        <sys:Double x:Key="GlobalScrollBarThickness">10</sys:Double>
        <SolidColorBrush x:Key="ScrollThumbBrush" po:Freeze="True" Color="#7C8794" Opacity="0.55" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" po:Freeze="True" Color="#9AA6B4" Opacity="0.85" />

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bar" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="{DynamicResource GlobalScrollBarThickness}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="{DynamicResource GlobalScrollBarThickness}" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
