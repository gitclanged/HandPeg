<UserControl x:Class="HandPegApp.DependencyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <StackPanel>
        <!-- The tools: one row each, with what is installed and, while it is being installed, how far along -->
        <ItemsControl x:Name="ToolList" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="{Binding StatusLabel}" />
                        <ProgressBar Grid.Column="2" Height="10" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                                     Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The speech models: large, and only needed for auto-captions, so each is a choice -->
        <TextBlock Text="Speech models for auto-captions (optional)" FontWeight="SemiBold" Margin="0,10,0,2" />
        <ItemsControl x:Name="ModelList" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1,14,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0"
                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,6,0"
                                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="{Binding StatusLabel}" />
                        <ProgressBar Grid.Column="2" Height="10" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                                     Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="InstallButton" Content="Install / Update All Dependencies" Click="Install_Click"
                    ToolTip="Installs whatever is missing and replaces whatever has a newer release, one after the other. Each download is checked and tested before it takes the place of the copy in use." />
            <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Margin="6,0,0,0" IsEnabled="False" Click="Cancel_Click"
                    AutomationProperties.Name="Cancel Dependency Install"
                    ToolTip="Stops the download that is running. What was installed before stays as it was." />
            <Button Grid.Column="2" x:Name="UseExistingButton" Content="Use an Existing FFmpeg..." Margin="6,0,0,0" Visibility="Collapsed"
                    Click="UseExisting_Click"
                    ToolTip="Point HandPeg at an ffmpeg.exe you already have instead of downloading one. An ffprobe.exe beside it is used too." />
            <ProgressBar Grid.Column="3" x:Name="OverallBar" Height="14" Margin="14,0,0,0" Minimum="0" Maximum="1" VerticalAlignment="Center"
                         AutomationProperties.Name="Overall Dependency Progress" />
        </Grid>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
