<Project>

  <!--
      Build settings shared by every HandPeg project (the app, its NativeAOT bootstrapper and thumbnail handler, and the tools).
      Each project imports this file explicitly after its first PropertyGroup. It is deliberately not a Directory.Build.props:
      MSBuild would apply that to every project below the repository root, including stale copies of the projects kept under
      local\ that were never meant to build with these rules.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Every warning fails the build. A warning then leaves no output behind, so the next incremental build compiles again and
         fails again: an incremental build can never report "0 warnings" for code it did not compile. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability advisories stay warnings: an advisory published for a referenced package must not break an unchanged tree. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Pinned rather than "latest", so a newer SDK cannot add analyzer warnings (errors, above) to an unchanged tree. -->
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>

  <!--
      The processor of a .NET (non-NativeAOT) build: x64, or ARM64 when the build targets win-arm64 or names no runtime on an ARM64
      machine, so the app and the tools run natively on an ARM64 PC without an x64 .NET beside the ARM64 one. NativeAOT projects take
      theirs from the runtime identifier they are published for.
  -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64')">ARM64</PlatformTarget>
  </PropertyGroup>

</Project>
