<Window x:Class="HandPegApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HandPegApp.ViewModels"
        xmlns:local="clr-namespace:HandPegApp"
        xmlns:models="clr-namespace:HandPegApp.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="HandPeg" Height="1030" Width="1280" MinHeight="800" MinWidth="1100"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <!-- Carries encode progress on the taskbar button. Its state is None until an encode sets it. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>
    <!-- Saving, from wherever the keyboard is. Save As is Ctrl+Alt+S: Ctrl+Shift+S belongs, on many computers, to the graphics driver's overlay, which takes it before any program sees it. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectNowCommand}" />
        <KeyBinding Modifiers="Ctrl+Alt" Key="S" Command="{Binding SaveProjectAsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- A deleted clip in the recycle bin: a picture of it, what it was and when it was on, and the way back. -->
        <DataTemplate x:Key="BinItemTemplate">
            <Grid Margin="0,3" Width="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InsetBrush}" CornerRadius="3" Height="34" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Restore" Padding="10,3" VerticalAlignment="Center" Click="RestoreDeleted_Click"
                        ToolTip="Puts this clip back on the timeline where it was." />
            </Grid>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:FractionToOffsetConverter x:Key="FractionToOffset" />
        <local:EncoderPresetLabelConverter x:Key="EncoderPresetLabel" />
        <local:DecibelToScaleConverter x:Key="DecibelToScale" />

        <!-- The parts of a slider's track either side of the thumb: there to be clicked, not seen. -->
        <Style x:Key="BareRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The timeline's scrubber: no track of its own (the waveform, I-frame lines and segment bar behind it
            are the track), and a playhead that is an arrow pointing down with a line dropping to the bar.
            The thumb is 11 wide, which the code that places the hover preview and the segment marks relies on.
        -->
        <Style x:Key="TimelineSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource BareRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BareRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource TextBrush}" />
                                                    <Path Data="M0,0 L11,0 L5.5,9 Z" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="0.75" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The bar where presets are chosen and saved. Shown in the Summary tab or above the tabs, as set in Settings. -->
        <DataTemplate x:Key="PresetBar">
            <Border Style="{StaticResource Panel}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Encoding Presets:" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox MinWidth="260" Margin="0" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              AutomationProperties.Name="Encoding Presets"
                              ToolTip="Applies the preset's size, filters, layout, video, audio and caption settings." />
                    <TextBlock Text="Name:" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <TextBox Width="240" VerticalContentAlignment="Center" AutomationProperties.Name="Preset Name"
                             Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name to save the current settings under. An existing name is replaced." />
                    <Button Content="Save Preset" Margin="6,0,0,0" Command="{Binding SavePresetCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The handle on a layer's corner, dragged to resize it. Drawn by ResizeAdorner. -->
        <Style x:Key="LayerGrip" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" BorderBrush="#FF0078D7" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The sharp centre video as it is dragged around the frame. -->
        <Style x:Key="CenterThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#50FFFFFF" BorderBrush="White" BorderThickness="1">
                            <TextBlock Text="Center Video" Foreground="White" FontSize="11" Margin="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The caption box as it is dragged around the frame. -->
        <Style x:Key="CaptionThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#B0C08020" BorderBrush="#FFFFC060" BorderThickness="1">
                            <TextBlock Text="Subtitles" Foreground="White" FontSize="11" Margin="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A layer (a piece of the video, or an image) as it is dragged around the frame: a tinted box carrying its name. -->
        <Style x:Key="LayerThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#990078D7" BorderBrush="White" BorderThickness="1">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" Margin="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play while paused, pause while playing: one button whose symbol follows the player. -->
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="Play (Space)" />
            <Setter Property="AutomationProperties.Name" Value="Play" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="ToolTip" Value="Pause (Space)" />
                    <Setter Property="AutomationProperties.Name" Value="Pause" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The other buttons of the transport row -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!--
            A button that is the right end of a text box: laid over the box, as tall as the inside of it and
            against the inside of its right border, with that end's corners rounded as the box's are (the box's
            are 4, so one pixel in they are 3) and the other end square.
        -->
        <Style x:Key="InFieldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1,1,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0,3,3,0"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Player with timeline, splitter, settings tabs: the two star rows share what the splitter divides. -->
            <RowDefinition Height="46*" MinHeight="290" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="38*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Source, and the buttons that open the other windows. Encoder Mode's: in Editor Mode the row is not
            there at all, the player has its height, and the buttons are at the top of the side column instead
            (see EditorHeader), over a Source pane of its own (see SourcePane).
        -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10"
                Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source URL / File Path:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" x:Name="SourceTextBox" VerticalContentAlignment="Center"
                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SourceTextBox_KeyDown"
                         ToolTip="Type or paste a path or URL, or drop a video file anywhere on the window." />
                <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="BrowseSource_Click" />
                <Button Grid.Column="3" Content="Load" Margin="6,0,0,0" Command="{Binding LoadSourceCommand}" />
                <TextBlock Grid.Column="4" Text="Download Resolution:" Style="{StaticResource FieldLabel}" Margin="18,0,8,0" />
                <ComboBox Grid.Column="5" MinWidth="100" Margin="0"
                          ItemsSource="{Binding DownloadResolutions}"
                          SelectedItem="{Binding DownloadResolution}"
                          ToolTip="Maximum height requested from yt-dlp when the source is a URL." />
                <Button Grid.Column="6" Content="Project" Margin="12,0,0,0" Click="OpenProjects_Click"
                        ToolTip="Save the current source, cuts and settings as a project, or open a saved one." />
                <Button Grid.Column="7" Content="{Binding QueueButtonText}" Margin="6,0,0,0" MinWidth="86" Click="OpenQueue_Click"
                        ToolTip="Show the batch queue. The number is how many jobs are waiting." />
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="10,6" Margin="6,0,0,0"
                            Click="OpenCombinator_Click" AutomationProperties.Name="Video Combinator"
                            ToolTip="Video Combinator: join up to five videos into one, stitched as they are or re-encoded with a transition" />
                    <!-- The mode in use, and the way to the other one. Each mode keeps its own interface settings. -->
                    <Button Margin="6,0,0,0" Padding="12,6" MinWidth="84" FontWeight="SemiBold" Click="ToggleMode_Click" AutomationProperties.Name="Switch Mode"
                            ToolTip="Switches between Encoder Mode (the lean front end for converting and trimming) and Editor Mode (layers, captions, the full timeline). Each mode remembers its own layout: timeline height, which tabs show, the playback controls.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" FontWeight="Normal" />
                            <TextBlock Text="{Binding ModeButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="9" Margin="6,0,0,0">
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="10,6"
                            Click="OpenSettings_Click" ToolTip="Settings: dependencies, tool paths, update sources and automation"
                            AutomationProperties.Name="Settings" />
                    <!-- Badge: yt-dlp or FFmpeg is missing or has a newer release -->
                    <Ellipse Width="11" Height="11" Fill="#FF8C00" Stroke="{DynamicResource PanelBrush}" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"
                             Visibility="{Binding IsDependencyUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Dependency update available" />
                </Grid>
            </Grid>
        </Border>

        <!--
            The Views menu: which panes are open and where each of them is. Opened by the Views button of the
            transport row in Encoder Mode and by the one in the side panes' header in Editor Mode; which of the
            two it opens beside is set from code (see PlaceViewsPopup). It takes no room here.
        -->
        <Popup x:Name="ViewsPopup" StaysOpen="False"
               AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=ViewsButton, Mode=TwoWay}"
               Opened="ViewsPopup_Opened" Closed="ViewsPopup_Closed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <StackPanel TextElement.Foreground="{DynamicResource TextBrush}" MinWidth="250">
                    <!-- The timeline's checkboxes, while the playback bar has no room for them. -->
                    <StackPanel x:Name="ViewsPlaybackOptions" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <CheckBox Content="Snap cuts to I-frames" IsChecked="{Binding SnapToIFrames}" Margin="0,2"
                                  ToolTip="Cut points move onto I-frames, which is what a stream copy needs for the output to match the times listed." />
                        <CheckBox Content="Play only cut segments" IsChecked="{Binding PlayOnlySegments}" Margin="0,2"
                                  ToolTip="Playback jumps over everything outside the cut segments, so what plays is what the encode will keep." />
                        <CheckBox Content="Show I-frames" IsChecked="{Binding ShowIFrames}" Margin="0,2"
                                  ToolTip="Draws a thin line on the timeline at every I-frame." />
                    </StackPanel>
                    <TextBlock Text="Panes" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <!-- Editor Mode's: the layout pane arranges layers, which Encoder Mode has none of. -->
                    <CheckBox Content="Layout Pane" IsChecked="{Binding IsArrangeActive}" IsEnabled="{Binding CanEditLayout}" Margin="0,2"
                              Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Layout Pane"
                              ToolTip="The layout pane beside the video: the output frame with the main video, the layers and the caption box. Drag to move, drag a corner handle to resize, double-click to center." />
                    <!-- Editor Mode's too: Encoder Mode has the source in its top bar. -->
                    <CheckBox Content="Source" IsChecked="{Binding ShowSourcePane}" Margin="0,2"
                              Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Source Pane"
                              ToolTip="The Source pane at the top of the side column: the box for a file path or a web address, and the download resolution. With it closed, a video is still opened by dropping it on the window." />
                    <CheckBox Content="Cut Segments" IsChecked="{Binding ShowCutSegmentsPane}" Margin="0,2"
                              ToolTip="The list of cut segments beside the player." />
                    <CheckBox Content="Keyframes" IsChecked="{Binding ShowKeyframesPane}" Margin="0,2"
                              ToolTip="The selected clip's keyframes on a timeline of their own, with the keyframe controls and its place, size and rotation at the playhead." />
                    <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <!-- What the editor's player shows: the originals, or proxies of one size or the other -->
                    <StackPanel Margin="0,2,0,6" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Preview Quality" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PreviewQualityChoices}" SelectedItem="{Binding PreviewQualityChoice}" AutomationProperties.Name="Preview Quality"
                                  ToolTip="High: the player reads the original files, as an export does; the truest picture and the heaviest. Medium: 720-line proxies, made in the background. Low: 360-line proxies at half the bitrate, for the smoothest scrubbing on slower hardware. Exports always read the originals, whatever is chosen here." />
                    </StackPanel>
                    <Button Content="Render Timeline Proxy" Command="{Binding RenderTimelineProxyCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8" AutomationProperties.Name="Render Timeline Proxy"
                            Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Renders the whole picture of the timeline, every layer composed, into one silent file, which the player then plays in place of composing it live: scrubbing is as light as a single video. The sound is still mixed live. It is discarded the moment anything on the timeline is changed. Settings (Performance) can have it rendered by itself when the timeline is left alone." />
                    <CheckBox Content="Sync Master Timeline Stretch" IsChecked="{Binding SyncMasterTimeline}" Margin="0,2" AutomationProperties.Name="Sync Master Timeline Stretch"
                              Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="The layer and audio time bars are zoomed with Ctrl + wheel and moved along with Shift + wheel or a middle-button drag. On: the master timeline is stretched and moved with them. Off: it always shows the whole sequence." />
                    <CheckBox Content="Keyframe diamonds on clips" IsChecked="{Binding ShowClipKeyframes}" Margin="0,2"
                              ToolTip="Draws a diamond on a clip's block at each of its keyframes." />
                    <!-- Where the panes are. Each button says where its pane would go; the borders between panes are dragged to resize them. -->
                    <TextBlock Text="Arrange" FontWeight="SemiBold" Margin="0,8,0,4"
                               ToolTip="Each pane can be moved to the other side. A pane's title can also be dragged there, and the thin lines between panes are dragged to resize them." />
                    <Button x:Name="MoveLayoutPaneButton" Tag="Layout" Click="MovePane_Click" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left"
                            Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Move Layout Pane" />
                    <Button x:Name="MoveSidePanesButton" Tag="Side" Click="MovePane_Click" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Move Side Panes" />
                    <Button x:Name="SwapSidePanesButton" Tag="Order" Click="MovePane_Click" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Swap Keyframes and Cut Segments" />
                    <Button x:Name="MoveTimelineButton" Tag="Timeline" Click="MovePane_Click" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Move Master Timeline" />
                    <Button Content="Reset Panes Layout" Click="ResetPanesLayout_Click" Padding="10,4" Margin="0,8,0,0" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Reset Panes Layout"
                            ToolTip="Puts every pane back where this mode starts with it, at the size it starts with: the side panes on the right, the layout pane right of the video, the timeline underneath." />
                </StackPanel>
            </Border>
        </Popup>

        <!--
            Player area: video beside the side panes, with the timeline underneath both. That is where the panes
            start out: which row and column each is in, and how large, is set from code (see ApplyPaneLayout),
            because the panes can be moved: the side panes to the left of the player, the layout pane to the
            left of the video, the timeline above the player, the two side panes over each other either way round.
        -->
        <Grid Grid.Row="1" x:Name="PlayerArea" SizeChanged="PlayerArea_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
                The left cell: the player with its transport row, and beside it, while Edit Layout is on, the
                layout pane. A splitter between the two; the splitter further right divides all of this from the cut list.
            -->
            <Grid x:Name="PlayerCell">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Drag to share the space between the video and the layout -->
            <GridSplitter Grid.Column="1" Grid.RowSpan="2" x:Name="LayoutSplitter" Width="2" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="24" Visibility="Collapsed"
                          Style="{StaticResource QuietSplitter}" Cursor="SizeWE" DragCompleted="PaneSplitter_DragCompleted"
                          ToolTip="Drag to resize the video and the layout" AutomationProperties.Name="Resize layout" />

            <!-- Edit Layout: the output frame with its layers, to drag into place -->
            <Border Grid.Column="2" Grid.RowSpan="2" x:Name="LayoutPane" Style="{StaticResource Panel}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Layout" FontWeight="SemiBold" Margin="0,0,0,2" Background="Transparent" Cursor="SizeAll" Tag="Layout"
                               MouseLeftButtonDown="PaneTitle_MouseLeftButtonDown" MouseMove="PaneTitle_MouseMove" MouseLeftButtonUp="PaneTitle_MouseLeftButtonUp"
                               ToolTip="Drag this title to the other side of the video to move the pane there." />
                    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Drag a layer to move it, its corner handle to resize it. Double-click to center." />
                    <!-- The decorator gives the canvas an adorner layer of its own, where the resize handles are drawn. -->
                    <AdornerDecorator ClipToBounds="True">
                        <Canvas x:Name="LayoutCanvas" Background="{DynamicResource InsetBrush}" ClipToBounds="True" SizeChanged="LayoutCanvas_SizeChanged" />
                    </AdornerDecorator>
                </DockPanel>
            </Border>

            <!-- Video player -->
            <Border x:Name="VideoBorder" Background="Black" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <local:VideoSurface x:Name="VideoView">
                    <!--
                        Drawn in the transparent window the surface keeps above the video, which is how WPF content
                        can appear over the native video window. The crop canvas is only present while Interactive
                        Crop is on; its faint fill is what lets it receive the mouse (fully transparent pixels let clicks through).
                    -->
                    <Grid>
                        <!--
                            Shown while no video is loaded, and solid, so it reads the same whatever is behind it.
                            This window lies over the player, so what is dropped on it is passed on to the main
                            window's own drop handling; a click opens Browse.
                        -->
                        <Grid x:Name="DropHint" Background="#FF0E0E0E" AllowDrop="True" Cursor="Hand"
                              DragOver="Window_DragOver" Drop="Window_Drop" MouseLeftButtonUp="DropHint_MouseLeftButtonUp"
                              AutomationProperties.Name="Drag and Drop Video File Here">
                            <Rectangle Margin="36" RadiusX="14" RadiusY="14" Stroke="#66FFFFFF" StrokeThickness="2" StrokeDashArray="6 5" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="#88FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="Drag &amp; Drop Video File Here" FontSize="26" FontWeight="SemiBold" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="or click to browse, or paste a path or URL into the source box" FontSize="13" Foreground="#77FFFFFF"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- Shown while the player itself is being downloaded, the first time: says what is going on in the empty space -->
                        <Border x:Name="EngineNotice" Visibility="Collapsed" Background="#F0101010" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                                <TextBlock x:Name="EngineNoticeTitle" Text="Downloading Video Engine..." FontSize="22" FontWeight="SemiBold" Foreground="#DDFFFFFF" HorizontalAlignment="Center" />
                                <ProgressBar x:Name="EngineProgress" Height="8" Width="320" Margin="0,14,0,0" Minimum="0" Maximum="1" />
                                <TextBlock x:Name="EngineNoticeText" FontSize="13" Foreground="#99FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="Engine Notice" />
                            </StackPanel>
                        </Border>
                        <AdornerDecorator ClipToBounds="True">
                            <Canvas x:Name="CropCanvas" Background="#01000000" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                                    MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown" MouseMove="CropCanvas_MouseMove"
                                    MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp" SizeChanged="CropCanvas_SizeChanged">
                                <Rectangle x:Name="CropRectangle" Stroke="Red" StrokeThickness="2" Fill="#18FF0000" IsHitTestVisible="False" />
                            </Canvas>
                        </AdornerDecorator>
                    </Grid>
                </local:VideoSurface>
            </Border>

            <!--
                Advanced transport, centred under the player when switched on in Settings:
                previous I-frame, back one frame, play/pause, forward one frame, next I-frame.
            -->
            <Grid Grid.Row="1" x:Name="TransportRow" Margin="0,8,0,0" Visibility="{Binding ShowAdvancedPlayback, Converter={StaticResource BoolToVisibility}}">
                <!-- The buttons sit in the middle while there is room; in a narrow player they give way to the volume -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <!--
                    Editor Mode: the timeline's three checkboxes, here beside the transport instead of under the timeline.
                    When the row is too narrow for them they are not wrapped: they fold into one button, which opens them as a small menu.
                -->
                <DockPanel x:Name="TimelineOptionsBar" Margin="0,0,10,0" LastChildFill="True" IsVisibleChanged="TimelineOptionsBar_IsVisibleChanged"
                           Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                    <!-- Views: the panes, and (when the row is too narrow for them) the checkboxes that otherwise follow it. Its icon is geometry: an eye. -->
                    <ToggleButton x:Name="EditorViewsButton" DockPanel.Dock="Left" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsChecked, ElementName=ViewsButton, Mode=TwoWay}" AutomationProperties.Name="Views"
                                  ToolTip="Views: show or hide the Source, Layout, Cut Segments and Keyframes panes, move them around the player, and put them back where they started. When the window is narrow, the timeline's checkboxes are in here too.">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="12" Stretch="None" VerticalAlignment="Center" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M 1,6 C 4,1 14,1 17,6 C 14,11 4,11 1,6 Z M 11.5,6 A 2.5,2.5 0 1 1 6.5,6 A 2.5,2.5 0 1 1 11.5,6 Z" />
                            <TextBlock Text="Views" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                <Grid x:Name="TimelineOptionsHost" ClipToBounds="True" SizeChanged="TimelineOptionsHost_SizeChanged">
                    <StackPanel x:Name="TimelineOptionsInline" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox Content="Snap cuts to I-frames" IsChecked="{Binding SnapToIFrames}" Margin="0"
                                  ToolTip="Cut points move onto I-frames, which is what a stream copy needs for the output to match the times listed. It does not change the encoders: pick Copy or a codec in the Video and Audio tabs." />
                        <CheckBox Content="Play only cut segments" IsChecked="{Binding PlayOnlySegments}" Margin="14,0,0,0"
                                  ToolTip="Playback jumps over everything outside the cut segments, so what plays is what the encode will keep. While on, what is skipped is shaded on the timeline." />
                        <CheckBox Content="Show I-frames" IsChecked="{Binding ShowIFrames}" Margin="14,0,0,0"
                                  ToolTip="Draws a thin line on the timeline at every I-frame. Settings (Timeline) can tie timeline snapping to this box." />
                    </StackPanel>
                </Grid>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Content="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,7" Margin="3,0" IsChecked="{Binding LivePreview}"
                              AutomationProperties.Name="Enable Live Preview" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Enable Live Preview: runs the export's own FFmpeg filters on the picture as it plays, so crop, layout, color, LUT and the rest are seen as you set them, with nothing rendered to disk. The picture is built at the size the player shows it. The filters themselves run on the processor, so a very heavy layout may not keep up at full speed. Off, the player shows the source as it is." />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE72C;" Margin="3,0,14,0" Click="ReloadPlayer_Click"
                            ToolTip="Use if timeline is stuck" AutomationProperties.Name="Reload Player" />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Click="PreviousIFrame_Click"
                            ToolTip="Previous I-Frame" AutomationProperties.Name="Previous I-Frame" />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE76B;" Click="StepBack_Click"
                            ToolTip="Step Back One Frame (Left)" AutomationProperties.Name="Step Back One Frame" />
                    <Button Style="{StaticResource PlayPauseButton}" Padding="20,7" Margin="3,0" Click="PlayPause_Click" />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE76C;" Click="StepForward_Click"
                            ToolTip="Step Forward One Frame (Right)" AutomationProperties.Name="Step Forward One Frame" />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Click="NextIFrame_Click"
                            ToolTip="Next I-Frame" AutomationProperties.Name="Next I-Frame" />
                    <Button Style="{StaticResource TransportButton}" Content="&#xE7B3;" Margin="14,0,3,0" Command="{Binding RenderPreviewCommand}"
                            AutomationProperties.Name="Render Preview" Visibility="Collapsed"
                            ToolTip="Render Preview: encode a few seconds with the current crop, scaling and filters at reduced size, and play the result. Length and size are set in Settings." />
                    <!-- Views: which panes are open, where each of them is, and whether clips show their keyframes. Encoder Mode's: Editor Mode has the button in the side panes' header. -->
                    <ToggleButton x:Name="ViewsButton" Content="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,7" Margin="3,0"
                                  Visibility="{Binding IsEditorMode, Converter={StaticResource InverseBoolToVisibility}}"
                                  AutomationProperties.Name="Views and Panes"
                                  ToolTip="Views / Panes: show or hide the Layout, Cut Segments and Keyframes panes, move them around the player, and put them back where they started." />
                </StackPanel>
                <!-- Volume and speed, beside the transport buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- How tall the master timeline is -->
                    <TextBlock Text="&#xE1D8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" ToolTip="Timeline height" />
                    <Slider Width="64" Margin="6,0,12,0" VerticalAlignment="Center" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5"
                            IsMoveToPointEnabled="True" Value="{Binding MasterTimelineHeight}" AutomationProperties.Name="Timeline Height"
                            ToolTip="Timeline height: how tall the master timeline is, from a slim bar to room for a readable waveform. Double-click to reset." />
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" ToolTip="Volume" />
                    <Slider Width="64" Margin="6,0,8,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="5" LargeChange="20" IsMoveToPointEnabled="True" ToolTip="Volume. Double-click to reset."
                            Value="{Binding Volume}" AutomationProperties.Name="Volume" local:NumericInput.Default="100" />
                    <ComboBox MinWidth="64" Margin="0" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed}"
                              ToolTip="Playback Speed" AutomationProperties.Name="Playback Speed" />
                </StackPanel>
            </Grid>
            </Grid>

            <!-- Drag to change the width of the cut list -->
            <GridSplitter Grid.Column="1" x:Name="SideSplitter" Width="2" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="24"
                          Style="{StaticResource QuietSplitter}" Cursor="SizeWE" DragCompleted="PaneSplitter_DragCompleted"
                          ToolTip="Drag to resize the side panes" AutomationProperties.Name="Resize side panes" />

            <!--
                The side column. In Editor Mode it starts with a row of buttons that is always there, the ones
                Encoder Mode has in its top bar, and under it the Source pane. Then the side panes, the Keyframes
                pane and under it the Cut Segments pane. All three panes are shown and hidden from the Views menu.
                In Encoder Mode, with neither of its two panes open, the column closes and the player has the width.
            -->
            <Grid Grid.Column="2" x:Name="SidePanes">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Editor Mode's header: the buttons that open the other windows, as they are in Encoder Mode's top
                bar, held against the right edge. It is not a pane: it cannot be closed or dragged off, and goes
                where the side column goes. The buttons are always on the one row: the column is never narrower
                than they are together (see UpdateSideColumnMinWidth).
            -->
            <StackPanel x:Name="EditorHeader" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2" SizeChanged="EditorHeader_SizeChanged"
                        Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Project" Margin="6,0,0,6" Click="OpenProjects_Click"
                        ToolTip="Save the current source, cuts and settings as a project, or open a saved one." />
                <!-- The mode in use, and the way to the other one. Each mode keeps its own interface settings. -->
                <Button Margin="6,0,0,6" Padding="12,6" MinWidth="84" FontWeight="SemiBold" Click="ToggleMode_Click" AutomationProperties.Name="Switch Mode"
                        ToolTip="Switches between Encoder Mode (the lean front end for converting and trimming) and Editor Mode (layers, captions, the full timeline). Each mode remembers its own layout: timeline height, which tabs show, the playback controls.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" FontWeight="Normal" />
                        <TextBlock Text="{Binding ModeButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!--
                    Settings; and, while the pointer rests on it, a small flyout under it with the batch queue and
                    the Video Combinator, which used to be buttons of this row.
                -->
                <Grid Margin="6,0,0,6" x:Name="SettingsHost" MouseEnter="SettingsHost_MouseEnter" MouseLeave="SettingsFlyout_MouseLeave">
                    <Popup x:Name="SettingsFlyout" PlacementTarget="{Binding ElementName=SettingsHost}" Placement="Bottom" HorizontalOffset="-150" VerticalOffset="-2"
                           AllowsTransparency="True" StaysOpen="True">
                        <Border x:Name="SettingsFlyoutPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6"
                                Margin="0,4,0,0" MouseLeave="SettingsFlyout_MouseLeave">
                            <StackPanel MinWidth="180">
                                <StackPanel.Resources>
                                    <!-- A row of a menu: its words start at the left, where the ordinary button would put them in the middle. -->
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>
                                <!-- Autosave first: its name on the left like the rest, its box at the right-hand end of the row -->
                                <DockPanel Margin="10,5,8,6" Background="Transparent"
                                           ToolTip="Writes the open project to a file named after it (Name.autosave.hproj) every few minutes, in the background. The interval is in Settings, Behavior.">
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutosaveEnabled}" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Autosave" />
                                    <TextBlock Text="Autosave" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Button Content="{Binding QueueButtonText}" Click="FlyoutQueue_Click" AutomationProperties.Name="Queue"
                                        ToolTip="Show the batch queue. The number is how many jobs are waiting." />
                                <Button Content="Social Squisher" Click="FlyoutSquisher_Click" AutomationProperties.Name="Social Squisher"
                                        ToolTip="Opens the startup dialog with the Social Sharing Squisher: drop a video on a preset to squeeze it under that size." />
                                <Button Content="Video Combinator" Click="FlyoutCombinator_Click" AutomationProperties.Name="Video Combinator"
                                        ToolTip="Video Combinator: join up to five videos into one, stitched as they are or re-encoded with a transition" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="10,6"
                            Click="OpenSettings_Click" ToolTip="Settings: dependencies, tool paths, update sources and automation. Rest the pointer here for the Queue and the Video Combinator."
                            AutomationProperties.Name="Settings" />
                    <!-- Badge: yt-dlp or FFmpeg is missing or has a newer release -->
                    <Ellipse Width="11" Height="11" Fill="#FF8C00" Stroke="{DynamicResource WindowBackgroundBrush}" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"
                             Visibility="{Binding IsDependencyUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Dependency update available" />
                </Grid>
            </StackPanel>

            <!--
                Source, in Editor Mode: one box as wide as the pane for a path or a URL, with the one button that
                acts on it resting inside its right end. With the box empty the button browses for a file; with
                something in it, it loads that.
            -->
            <Border Grid.Row="1" x:Name="SourcePane" Style="{StaticResource Panel}" Margin="0,0,0,8"
                    Visibility="{Binding IsSourcePaneVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <!-- The pane's title, and against the right edge, level with it, the resolution asked of yt-dlp for a URL. -->
                    <DockPanel Margin="0,0,0,6">
                        <ComboBox DockPanel.Dock="Right" MinWidth="92" Margin="0" VerticalAlignment="Center" ItemsSource="{Binding DownloadResolutions}" SelectedItem="{Binding DownloadResolution}"
                                  AutomationProperties.Name="Download Resolution" ToolTip="Maximum height requested from yt-dlp when the source is a URL." />
                        <TextBlock DockPanel.Dock="Right" Text="Download Resolution:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <!--
                            The box and its button are two columns: the box has all the width the button does not
                            take, and ends where the button begins. Nothing lies over the text, so what is typed is
                            seen right up to the button, whatever the button says and however wide that makes it.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePaneBox" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="6,6,4,6" KeyDown="SourcePaneBox_KeyDown"
                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source URL or File Path"
                                 ToolTip="Type or paste a path or URL and press Enter, or drop a video file anywhere on the window. A web address is downloaded with yt-dlp." />
                        <Button x:Name="SourceActionButton" Grid.Column="1" Style="{StaticResource InFieldButton}" Content="{Binding SourceActionText}" HorizontalAlignment="Stretch" Margin="-1,0,0,0" Padding="12,0"
                                Click="SourceAction_Click" AutomationProperties.Name="Browse or Load Source"
                                ToolTip="Browse: opens the file browser, while the box is empty. Load: loads the path or URL in the box (Enter does the same)." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The panes themselves: one over the other, either way round, with a border between them to drag. -->
            <Grid Grid.Row="2" x:Name="SidePaneStack" SizeChanged="SidePaneStack_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Drag to share the height between the two side panes -->
            <GridSplitter Grid.Row="1" x:Name="SidePaneSplitter" Height="2" Margin="0,4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16"
                          Style="{StaticResource QuietSplitter}" Cursor="SizeNS" DragCompleted="PaneSplitter_DragCompleted"
                          ToolTip="Drag to resize the Keyframes and Cut Segments panes" AutomationProperties.Name="Resize side panes height" />

            <!-- Keyframes: the selected clip's keyframes on a timeline of their own, and the clip as it is at the playhead. -->
            <Border x:Name="KeyframesPane" Style="{StaticResource Panel}"
                    Visibility="{Binding ShowKeyframesPane, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Keyframes" FontWeight="SemiBold" Background="Transparent" Cursor="SizeAll" Tag="Keyframes"
                                   MouseLeftButtonDown="PaneTitle_MouseLeftButtonDown" MouseMove="PaneTitle_MouseMove" MouseLeftButtonUp="PaneTitle_MouseLeftButtonUp"
                                   ToolTip="Drag this title above or below the Cut Segments pane to swap the two, or across the player to move the side panes to its other side." />
                        <TextBlock Text="{Binding ActiveKeyLayer.Name}" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="The clip whose keyframes are shown: the one last selected on the Layers tab, or the main video." />
                    </DockPanel>
                    <!-- The same span as the master timeline: a diamond at each keyframe, the clip's stretch shaded, the playhead. Drawn from code. -->
                    <local:KeyTimelineBar x:Name="KeyTimeline" Height="34" Background="{DynamicResource InsetBrush}" ClipToBounds="True" Cursor="Hand"
                            SizeChanged="KeyTimeline_SizeChanged" MouseLeftButtonDown="KeyTimeline_MouseLeftButtonDown" MouseMove="KeyTimeline_MouseMove" MouseLeftButtonUp="KeyTimeline_MouseLeftButtonUp"
                            AutomationProperties.Name="Keyframe Timeline" ToolTip="The selected clip's keyframes. Click or drag to move the playhead; click a diamond to go to that keyframe." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,5" Margin="0,0,4,0" Click="PreviousKeyframe_Click"
                                AutomationProperties.Name="Previous Keyframe" ToolTip="Previous Keyframe: moves the playhead to the keyframe before it." />
                        <Button Content="&#x2666;" FontSize="14" Padding="14,3" Margin="0,0,4,0" Click="ToggleKeyframe_Click" Foreground="Gold"
                                AutomationProperties.Name="Add or Remove Keyframe" ToolTip="Add / Remove Keyframe: sets a keyframe at the playhead holding the clip's place, size and rotation as they are there; on a keyframe, removes it." />
                        <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,5" Margin="0,0,10,0" Click="NextKeyframe_Click"
                                AutomationProperties.Name="Next Keyframe" ToolTip="Next Keyframe: moves the playhead to the keyframe after it." />
                        <Button Content="Clear" Padding="10,4" Click="ClearKeyframes_Click" AutomationProperties.Name="Clear Keyframes"
                                ToolTip="Removes every keyframe of this clip: it stays as it is at the playhead." />
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Enable keyframes" IsChecked="{Binding KeyframesEnabled}" Margin="0,2,14,2"
                                  ToolTip="On: moving, resizing or turning a clip (in the layout pane, or with the numbers) writes a keyframe. Off: a clip with keyframes takes its whole motion with it when it is moved." />
                        <RadioButton Content="Create new on move" GroupName="KeyframeModePane" IsChecked="{Binding KeyframesCreate}" Margin="0,2,14,2" IsEnabled="{Binding KeyframesEnabled}"
                                     ToolTip="A move sets a new keyframe at the playhead." />
                        <RadioButton Content="Snap to nearest" GroupName="KeyframeModePane" IsChecked="{Binding KeyframesSnap}" Margin="0,2" IsEnabled="{Binding KeyframesEnabled}"
                                     ToolTip="A move changes the keyframe nearest the playhead, and makes no new ones." />
                    </WrapPanel>
                    <!-- How the clip moves on from the keyframe the playhead is on, to the next one -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Easing: how the clip gets from the selected keyframe to the next one. Linear moves at one speed; the others start or end slowly. The selected keyframe is the one the playhead is on: step onto one with the previous and next keyframe buttons.">
                        <TextBlock Text="Easing:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox MinWidth="140" Margin="0" ItemsSource="{Binding EasingChoices}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                  SelectedValue="{Binding SelectedKeyEasing}" IsEnabled="{Binding HasSelectedKeyframe}" AutomationProperties.Name="Keyframe Easing" />
                    </StackPanel>
                    <!-- The clip as it is at the playhead: between two keyframes these run from one to the other as the playhead moves. -->
                    <WrapPanel Margin="0,6,0,0" ToolTip="The clip at the playhead. Between keyframes the numbers follow the motion; changing one moves the clip (and, with keyframes enabled, writes a keyframe).">
                        <TextBlock Text="X %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.PositionXPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe X"
                                 local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                        <TextBlock Text="Y %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.PositionYPercent, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe Y"
                                 local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                        <TextBlock Text="Scale %" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,10,2" Text="{Binding ActiveKeyLayer.SizePercent}" AutomationProperties.Name="Keyframe Scale"
                                 local:NumericInput.DragStep="0.25" local:NumericInput.Minimum="1" local:NumericInput.Maximum="400" />
                        <TextBlock Text="Rot &#176;" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Style="{StaticResource ValueBox}" Width="50" Margin="0,2,0,2" Text="{Binding ActiveKeyLayer.Rotation, StringFormat={}{0:0}}" AutomationProperties.Name="Keyframe Rotation"
                                 local:NumericInput.Default="0" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-360" local:NumericInput.Maximum="360" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Cut segments: selecting one seeks the player to its start. -->
            <Border Grid.Row="2" x:Name="CutSegmentsPane" Style="{StaticResource Panel}" Visibility="{Binding ShowCutSegmentsPane, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cut Segments" FontWeight="SemiBold" Margin="0,0,0,8" Background="Transparent" Cursor="SizeAll" Tag="CutSegments"
                               MouseLeftButtonDown="PaneTitle_MouseLeftButtonDown" MouseMove="PaneTitle_MouseMove" MouseLeftButtonUp="PaneTitle_MouseLeftButtonUp"
                               ToolTip="Drag this title above or below the Keyframes pane to swap the two, or across the player to move the side panes to its other side." />
                    <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ToolTip" Value="Click to jump to the start of this segment" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SegmentItem_PreviewMouseLeftButtonUp" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="row" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Skip / Restore" Click="SegmentSkip_Click" ToolTip="A skipped segment stays on the timeline, greyed out, and is left out of the output." />
                                            <MenuItem Header="Delete" Click="SegmentDelete_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock x:Name="segmentText" Text="{Binding Display}" Style="{StaticResource TimeText}" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Remove" Padding="10,2" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                        <Setter TargetName="segmentText" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                    <!-- Flashes when snapping to I-frames has changed this segment's times. -->
                                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            </Grid>
            </Grid>

            <!--
                Drag to make the master timeline taller or shorter. What it changes is the timeline's height
                setting (the slider beside the volume), so the two always agree; see TimelineSplitter_DragDelta.
            -->
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" x:Name="TimelineSplitter" Height="2" Margin="0,4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="8"
                          Style="{StaticResource QuietSplitter}" Cursor="SizeNS"
                          DragStarted="TimelineSplitter_DragStarted" DragDelta="TimelineSplitter_DragDelta" DragCompleted="TimelineSplitter_DragCompleted"
                          PreviewKeyDown="TimelineSplitter_PreviewKeyDown"
                          ToolTip="Drag to resize the master timeline" AutomationProperties.Name="Resize master timeline" />

            <!-- Timeline and cut controls -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" x:Name="TimelinePane" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- With the advanced transport on, its play/pause button takes over from this one -->
                        <Button Grid.Column="0" Style="{StaticResource PlayPauseButton}" MinWidth="56" Click="PlayPause_Click"
                                Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" ToolTip="Volume"
                                    Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Slider Width="90" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                    SmallChange="5" LargeChange="20" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume}" AutomationProperties.Name="Volume" local:NumericInput.Default="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                    Visibility="{Binding ShowSimplePlayback, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="9,6" Margin="3,0" IsChecked="{Binding LivePreview}"
                                  AutomationProperties.Name="Enable Live Preview" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Enable Live Preview: runs the export's own FFmpeg filters on the picture as it plays, so crop, layout, color, LUT and the rest are seen as you set them, with nothing rendered to disk. The picture is built at the size the player shows it. The filters themselves run on the processor, so a very heavy layout may not keep up at full speed. Off, the player shows the source as it is." />
                            <Button Style="{StaticResource TransportButton}" Content="&#xE72C;" Padding="9,6" Click="ReloadPlayer_Click"
                                    ToolTip="Use if timeline is stuck" AutomationProperties.Name="Reload Player" />
                            <Button Style="{StaticResource TransportButton}" Content="&#xE7B3;" Padding="9,6" Command="{Binding RenderPreviewCommand}"
                                    AutomationProperties.Name="Render Preview" Visibility="Collapsed"
                                    ToolTip="Render Preview: encode a few seconds with the current crop, scaling and filters at reduced size, and play the result. Length and size are set in Settings." />
                        </StackPanel>
                        <TextBlock Grid.Column="3" x:Name="PositionTextBlock" Text="{Binding PositionText}" Style="{StaticResource TimeText}" Margin="12,0"
                                   Background="Transparent" Cursor="Hand" ToolTip="Click to copy the current time"
                                   MouseLeftButtonUp="PositionText_MouseLeftButtonUp" />
                        <!--
                            The timeline, as tall as the Timeline Height setting makes it. From the back: the bar of
                            kept segments along the bottom, the I-frame lines running down to it, the waveform of
                            the mixed audio, and on top the playhead. The side margins line everything up with
                            the travel of the playhead, which stops half its width short of each end.
                        -->
                        <!-- The viewport cuts off what a stretched timeline has outside it; unstretched, the timeline simply fills it. -->
                        <Border Grid.Column="4" x:Name="MasterTimelineViewport" ClipToBounds="True" VerticalAlignment="Center" SizeChanged="MasterTimelineViewport_SizeChanged">
                        <Grid x:Name="MasterTimelineContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Height="{Binding TimelineAreaHeight}">
                            <!-- At the very back: a strip of pictures from the video, cut from the same sheet as the hover previews, dimmed so the waveform reads on top of it. Filled in from code. -->
                            <ItemsControl x:Name="FilmstripList" Margin="5,0,5,6" Opacity="0.5" IsHitTestVisible="False" Focusable="False"
                                          Visibility="Collapsed" ClipToBounds="True" SizeChanged="FilmstripList_SizeChanged"
                                          AutomationProperties.Name="Timeline Thumbnails">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border ClipToBounds="True" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="0,0,1,0">
                                            <Image Source="{Binding}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="6" Margin="5,0" VerticalAlignment="Bottom" Background="{DynamicResource ControlBorderBrush}">
                                <Canvas x:Name="SegmentCanvas" ClipToBounds="True" SizeChanged="SegmentCanvas_SizeChanged" />
                            </Border>
                            <!-- A line at every I-frame. Each item is a fraction of the timeline, turned into an offset here. -->
                            <ItemsControl x:Name="IFrameMarkList" Margin="5,0" ItemsSource="{Binding IFrameMarks}" IsHitTestVisible="False" Focusable="False"
                                          Visibility="{Binding ShowIFrames, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas ClipToBounds="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource FractionToOffset}">
                                                    <Binding />
                                                    <Binding Path="ActualWidth" ElementName="IFrameMarkList" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1" Height="{Binding ActualHeight, ElementName=IFrameMarkList}"
                                                   Fill="{DynamicResource MutedTextBrush}" Opacity="0.55" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Image Source="{Binding TimelineWaveform}" Stretch="Fill" Margin="5,0,5,6" Opacity="0.75"
                                   IsHitTestVisible="False" AutomationProperties.Name="Timeline Waveform" />
                            <!-- What playback skips, shaded while Play only cut segments is on; and the stretch a right-drag is marking. Drawn from code. -->
                            <Canvas x:Name="ShadeCanvas" Margin="5,0,5,6" ClipToBounds="True" IsHitTestVisible="False" SizeChanged="SegmentCanvas_SizeChanged" />
                            <Slider x:Name="TimelineSlider" Style="{StaticResource TimelineSlider}" Minimum="0" Maximum="{Binding TimelineMaximum}"
                                    Value="{Binding PositionMs}" SmallChange="1000" LargeChange="5000"
                                    IsMoveToPointEnabled="True" AutomationProperties.Name="Timeline"
                                    ValueChanged="TimelineSlider_ValueChanged"
                                    Thumb.DragStarted="TimelineSlider_DragStarted"
                                    Thumb.DragCompleted="TimelineSlider_DragCompleted"
                                    MouseMove="TimelineSlider_MouseMove" MouseLeave="TimelineSlider_MouseLeave"
                                    PreviewMouseRightButtonDown="TimelineSlider_RightButtonDown" PreviewMouseRightButtonUp="TimelineSlider_RightButtonUp"
                                    LostMouseCapture="TimelineSlider_LostMouseCapture"
                                    ToolTipService.InitialShowDelay="1200"
                                    ToolTip="Click or drag anywhere to scrub. Drag with the right mouse button to mark a new cut segment." />                            <!-- Thumbnail of the moment under the pointer, cut from the sheet made when the video loaded -->
                            <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=TimelineSlider}" Placement="Relative"
                                   AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Image x:Name="PreviewImage" Stretch="Fill" />
                                        <TextBlock x:Name="PreviewTime" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        </Grid>
                        </Border>
                        <TextBlock Grid.Column="5" Text="{Binding DurationText}" Style="{StaticResource TimeText}" Margin="12,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ShowTimelineOptionsBelow, Converter={StaticResource BoolToVisibility}}">
                        <!-- The cut buttons: here in Encoder Mode; in Editor Mode they are on the Layers tab, with the rest of the editing tools. -->
                        <Button x:Name="AddStartButton" Content="Add Start Point" Command="{Binding AddStartPointCommand}"
                                Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Add Stop Point" Command="{Binding AddStopPointCommand}" Margin="6,0,0,0"
                                Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Available whenever a start point could be added: that is, once a video is loaded. -->
                        <Button Content="Manual Cut Entry" Margin="6,0,0,0" Click="ManualCut_Click"
                                IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Type the start and stop of a cut." />
                        <Button x:Name="RemoveDeadAirButton" Content="Remove Dead Air..." Margin="6,0,0,0" Click="RemoveDeadAir_Click"
                                IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Find the silent stretches of the first audio track and replace the cut list with everything in between. Opens a small dialog to set how quiet counts as silence." />
                        <TextBlock Text="{Binding PendingStartText}" Style="{StaticResource TimeText}" Margin="12,0,0,0" />
                        <CheckBox Content="Snap cuts to I-frames" IsChecked="{Binding SnapToIFrames}" Margin="24,0,0,0"
                                  ToolTip="Cut points move onto I-frames, which is what a stream copy needs for the output to match the times listed. It does not change the encoders: pick Copy or a codec in the Video and Audio tabs." />
                        <CheckBox Content="Play only cut segments" IsChecked="{Binding PlayOnlySegments}" Margin="16,0,0,0"
                                  ToolTip="Playback jumps over everything outside the cut segments, so what plays is what the encode will keep. While on, what is skipped is shaded on the timeline." />
                        <CheckBox Content="Show I-frames" IsChecked="{Binding ShowIFrames}" Margin="16,0,0,0"
                                  ToolTip="Draws a thin line on the timeline at every I-frame. Settings (Timeline) can tie timeline snapping to this box." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drag (or focus and use the arrow keys) to trade space between the player and the settings -->
        <GridSplitter Grid.Row="2" Height="2" Margin="0,4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="24"
                      Style="{StaticResource QuietSplitter}" Cursor="SizeNS"
                      ToolTip="Drag to resize the player and the settings" AutomationProperties.Name="Resize player and settings" />

        <!-- Presets and settings tabs -->
        <DockPanel Grid.Row="3">
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource PresetBar}" Focusable="False" Margin="0,0,0,10"
                        Visibility="{Binding ShowPresetBarAtTop, Converter={StaticResource BoolToVisibility}}" />
        <Grid>
        <TabControl x:Name="SettingsTabs" Padding="16,8">
            <TabItem Header="Summary">
                <DockPanel>
                <!-- Encoder Mode: the preset bar, here or above the tabs as the settings have it -->
                <Border DockPanel.Dock="Top" Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetBar}" Focusable="False" Margin="0,0,0,10"
                                    Visibility="{Binding ShowPresetBarInSummary, Converter={StaticResource BoolToVisibility}}" />
                </Border>
                <!-- Encoder Mode's: the files lately worked on in Editor Mode, to open one here without looking for it again -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Recent Editor Files:" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                    <ComboBox MinWidth="380" MaxWidth="640" ItemsSource="{Binding RecentEditorFiles}" SelectedItem="{Binding SelectedRecentEditorFile}" AutomationProperties.Name="Recent Editor Files"
                              ToolTip="Videos, pictures and sounds lately opened or put on the timeline in Editor Mode. Choosing one opens it here as the source." />
                </StackPanel>
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <DataTemplate x:Key="InfoRowTemplate">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>

                    <!-- Left, in Encoder Mode: the output format, and the style presets as two buttons -->
                    <Grid VerticalAlignment="Top" Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The format stays available during a stream copy: only the container changes. -->
                        <TextBlock Text="Format:" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                        <CheckBox Content="Web Optimized" IsChecked="{Binding WebOptimized}" Margin="0,4,0,0"
                                  ToolTip="Puts the index at the front of an .mp4, .mov or .m4v file, so that it starts playing in a browser before it has downloaded." />
                        <CheckBox Content="Vertical Video" IsChecked="{Binding UseVerticalResolution}" Margin="0,2,0,0"
                                  ToolTip="One click from a wide video to a tall one: the frame is turned on its side, the picture sits across its middle, and a blurred copy of it fills the rest. Zoom and place it on the Layers tab. Settings can make this the default." />
                        </StackPanel>

                        <!-- Copy passes the picture through: said here, in yellow, when that leaves layers or filters out -->
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding CopyBypassWarning}" Foreground="{DynamicResource WarningTextBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" Margin="0,14,0,0"
                                   AutomationProperties.AutomationId="Copy Warning" />

                        <!-- Layout files: the Frame & Layer Engine's layers, with the color and blur settings that go with them -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <TextBlock Text="Style Presets" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Style Preset" Padding="12,6" Click="ExportLayout_Click"
                                        ToolTip="Saves the parts you tick as one .hpstyle file: layers with their masks inside, color filters, blur settings, subtitle settings. Styles saved in the Styles folder are offered in the launch window." />
                                <Button Content="Import Style Preset" Padding="12,6" Margin="6,0,0,0" Click="ImportLayout_Click"
                                        ToolTip="Loads a .hpstyle file. You choose which of its parts to take; its masks are unpacked into the Masks folder." />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--
                        Left, in Editor Mode: what the output is, and under it the three things that can be swapped whole, each in
                        a block of its own: the encoding preset, the style preset and the project. A block is a
                        list to choose from, and under the list what can be done with it.
                    -->
                    <StackPanel VerticalAlignment="Top" Width="300" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel.Resources>
                            <Style x:Key="SummaryBlock" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="12,9,12,10" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </StackPanel.Resources>

                        <Border Style="{StaticResource SummaryBlock}">
                            <StackPanel>
                                <TextBlock Text="Output" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <!-- The format stays available during a stream copy: only the container changes. -->
                                <DockPanel>
                                    <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" AutomationProperties.Name="Format" />
                                </DockPanel>
                                <CheckBox Content="Web Optimized" IsChecked="{Binding WebOptimized}" Margin="0,6,0,0"
                                          ToolTip="Puts the index at the front of an .mp4, .mov or .m4v file, so that it starts playing in a browser before it has downloaded." />
                                <CheckBox Content="Vertical Video" IsChecked="{Binding UseVerticalResolution}" Margin="0,2,0,0"
                                          ToolTip="One click from a wide video to a tall one: the frame is turned on its side, the picture sits across its middle, and a blurred copy of it fills the rest. Zoom and place it on the Layers tab." />
                                <!-- Copy passes the picture through: said here, in yellow, when that leaves layers or filters out -->
                                <TextBlock Text="{Binding CopyBypassWarning}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="Copy Warning">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,8,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CopyBypassWarning}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Encoding presets: size, filters, video and audio settings -->
                        <Border Style="{StaticResource SummaryBlock}">
                            <StackPanel>
                                <TextBlock Text="Encoding Preset" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.Name="Encoding Presets"
                                          ToolTip="Applies the preset's size, filters, layout, video, audio and caption settings." />
                                <Button Content="Import / Export / Save..." Padding="12,4" Margin="0,6,0,0" HorizontalAlignment="Left" Click="ManagePresets_Click"
                                        AutomationProperties.Name="Manage Encoding Presets"
                                        ToolTip="Opens the encoding preset dialog: save the settings as they are now to the list under a name, bring a preset in from a file, or save one to a file." />
                            </StackPanel>
                        </Border>

                        <!-- Style presets: the Frame & Layer Engine's layers, with the color, blur and subtitle settings that go with them -->
                        <Border Style="{StaticResource SummaryBlock}">
                            <StackPanel>
                                <TextBlock Text="Style Preset" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StylePresets}" SelectedItem="{Binding SelectedStylePreset}" DropDownOpened="StylePresets_DropDownOpened"
                                          AutomationProperties.Name="Style Presets"
                                          ToolTip="The style presets in the Styles folder. Choosing one applies all of it: layers with their masks, color, blur and subtitle settings. A double-click on a slider goes back to its values." />
                                <Button Content="Import / Export / Save..." Padding="12,4" Margin="0,6,0,0" HorizontalAlignment="Left" Click="ManageStyles_Click"
                                        AutomationProperties.Name="Manage Style Presets"
                                        ToolTip="Opens the style preset dialog: load a .hpstyle file (you choose which of its parts to take), or save the layers, color, blur and subtitle settings as one." />
                            </StackPanel>
                        </Border>

                        <!-- The project that is open, and the way to another -->
                        <Border Style="{StaticResource SummaryBlock}">
                            <StackPanel>
                                <TextBlock Text="Swap Project" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}" DropDownOpened="RecentProjects_DropDownOpened"
                                          SelectionChanged="RecentProjects_SelectionChanged" AutomationProperties.Name="Swap Project"
                                          ToolTip="The saved projects, the most recently saved first. Choosing one opens it in place of what is open now, without restarting." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: what the source is, and what the output will be -->
                    <Border Grid.Column="2" Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Source Information" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SourceInfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Projected Output" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OutputInfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Video">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <!-- Output size and crop: what used to be the Dimensions tab -->
                    <GroupBox Header="Resolution &amp; Cropping" IsEnabled="{Binding IsVideoReencoded}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,4">
                            <ComboBox Margin="0,0,0,4" ItemsSource="{Binding ResolutionPresets}" SelectedItem="{Binding ResolutionPreset}"
                                      AutomationProperties.Name="Resolution Preset"
                                      ToolTip="Common sizes. Choosing one fills in Width and Height, on their side when Use Vertical Resolution is ticked. Custom is whatever is typed below." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Width:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Width="96" HorizontalAlignment="Left" Margin="0,3" AutomationProperties.Name="Output Width"
                                         local:NumericInput.Default="" local:NumericInput.DragStep="2" local:NumericInput.Minimum="16" local:NumericInput.Maximum="16384"
                                         Text="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceSizeText}" />
                                <TextBlock Grid.Row="1" Text="Height:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Width="96" HorizontalAlignment="Left" Margin="0,3" AutomationProperties.Name="Output Height"
                                         local:NumericInput.Default="" local:NumericInput.DragStep="2" local:NumericInput.Minimum="16" local:NumericInput.Maximum="16384"
                                         Text="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceSizeText}" />
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <CheckBox Content="Keep Aspect Ratio" IsChecked="{Binding KeepAspectRatio}" Margin="0,4,0,2"
                                              ToolTip="Fill in the other dimension automatically from the shape of the cropped source, turned on its side with Use Vertical Resolution." />
                                    <CheckBox Content="Use Vertical Resolution" IsChecked="{Binding UseVerticalResolution}" Margin="0,2"
                                              ToolTip="Turns the shape of the output on its side: 16:9 becomes 9:16, and Width and Height swap. Use the Frame &amp; Layer Engine (Filters tab) to fill the new shape without stretching the picture." />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" IsEnabled="{Binding CanSetPixelAspect}">
                                    <TextBlock Text="Pixel Aspect:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                    <ComboBox MinWidth="118" ItemsSource="{Binding PixelAspectRatios}" SelectedItem="{Binding PixelAspectRatio}" />
                                    <TextBox Width="56" Margin="6,4,0,4" ToolTip="Custom ratio, for example 8:9"
                                             Visibility="{Binding IsCustomPixelAspectRatio, Converter={StaticResource BoolToVisibility}}"
                                             Text="{Binding CustomPixelAspectRatio, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>

                            <!-- Crop: the four boxes sit where their edges are -->
                            <StackPanel Margin="0,0,0,4">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Column="1" Width="60" Margin="0,2" HorizontalContentAlignment="Center"
                                             Text="{Binding CropTop, UpdateSourceTrigger=PropertyChanged}" ToolTip="Percent of the source cut from the top. Being relative, the same crop fits a source of any resolution." AutomationProperties.Name="Crop Top"
                                             local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                                    <TextBox Grid.Row="1" Width="60" Margin="0,2" HorizontalContentAlignment="Center"
                                             Text="{Binding CropLeft, UpdateSourceTrigger=PropertyChanged}" ToolTip="Percent of the source cut from the left. Being relative, the same crop fits a source of any resolution." AutomationProperties.Name="Crop Left"
                                             local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                                    <Border Grid.Row="1" Grid.Column="1" Margin="6,2" MinWidth="60" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="Crop %" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Row="1" Grid.Column="2" Width="60" Margin="0,2" HorizontalContentAlignment="Center"
                                             Text="{Binding CropRight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Percent of the source cut from the right. Being relative, the same crop fits a source of any resolution." AutomationProperties.Name="Crop Right"
                                             local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="60" Margin="0,2" HorizontalContentAlignment="Center"
                                             Text="{Binding CropBottom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Percent of the source cut from the bottom. Being relative, the same crop fits a source of any resolution." AutomationProperties.Name="Crop Bottom"
                                             local:NumericInput.Default="0" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="95" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="Reset Crop" Padding="10,5" Command="{Binding ResetCropCommand}" />
                                    <ToggleButton Content="Interactive Crop" Padding="10,5" Margin="6,0,0,0" IsChecked="{Binding IsInteractiveCropActive}"
                                                  ToolTip="Drag a rectangle over the video to set the crop. Double-click inside it to centre it." />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>

                    <!-- Editor Mode: the chapter options, which have a tab of their own in Encoder Mode only -->
                    <GroupBox Header="Chapters" Margin="0,8,0,0"
                              Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <CheckBox Content="Create chapter markers" IsChecked="{Binding ChapterMarkers}" Margin="0,2,24,2"
                                      ToolTip="Carries the source's chapters over. Only for uncut encodes: once sections are removed, the source's chapter times no longer fit." />
                            <CheckBox Content="Generate Chapters at Cut Points" IsChecked="{Binding ChaptersAtCuts}" Margin="0,2,0,2"
                                      ToolTip="Gives the output one chapter per kept segment, so a player can jump from cut to cut." />
                        </WrapPanel>
                    </GroupBox>
                    </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: what to encode with, and how much data to spend -->
                    <TextBlock Text="Video Encoder:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" MinWidth="280" ItemsSource="{Binding VideoEncoders}" SelectedItem="{Binding VideoEncoder}" />

                    <TextBlock Grid.Row="1" Text="Framerate (FPS):" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsVideoReencoded}">
                        <ComboBox ItemsSource="{Binding Framerates}" SelectedItem="{Binding Framerate}" />
                        <TextBox Width="90" Margin="8,4,0,4" ToolTip="Custom frame rate, for example 360 or 119.88"
                                 IsEnabled="{Binding IsCustomFramerate}"
                                 Visibility="{Binding IsCustomFramerate, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding CustomFramerate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Colorspace:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="200" ItemsSource="{Binding Colorspaces}"
                              SelectedItem="{Binding Colorspace}" IsEnabled="{Binding IsVideoReencoded}"
                              ToolTip="HDR to SDR converts PQ or HLG video to standard BT.709. Only use it on HDR sources." />

                    <TextBlock Grid.Row="3" Text="Rate Control:" Style="{StaticResource FieldLabel}" />
                    <!-- The one rate control box: its list is the selected encoder's own, and what is chosen is stored as one of the same three modes whichever encoder it was chosen for. -->
                    <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="200" ItemsSource="{Binding RateControlChoices}"
                              SelectedItem="{Binding RateControlChoice}" IsEnabled="{Binding HasRateControl}" AutomationProperties.Name="Rate Control"
                              ToolTip="How the data is spent, under the selected encoder's names. The first holds the picture at the Constant Quality value: CRF (x264, x265, SVT-AV1, VP9), CQ (NVENC), CQP (AMF and QuickSync, a fixed quantizer) or ICQ (QuickSync, a quality aimed for). CBR holds the Target Bitrate; VBR averages it and lets busy scenes take more." />

                    <TextBlock Grid.Row="4" Text="Constant Quality:" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsConstantQuality, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Quality or bitrate on the left; the file size that bitrate gives, tied to it, on the right -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" IsEnabled="{Binding HasRateControl}">
                        <StackPanel Orientation="Horizontal" Margin="0,4"
                                    Visibility="{Binding IsConstantQuality, Converter={StaticResource BoolToVisibility}}">
                            <Slider Width="240" Minimum="0" Maximum="51"
                                    VerticalAlignment="Center" Value="{Binding Crf}" AutomationProperties.Name="Constant Quality" local:NumericInput.Default="22" />
                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding Crf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Constant Quality Value"
                                     local:NumericInput.Default="22" local:NumericInput.DragStep="0.1" local:NumericInput.Minimum="0" local:NumericInput.Maximum="51" />
                        </StackPanel>
                        <TextBox Width="110" Margin="0,4" AutomationProperties.Name="Target Bitrate" local:NumericInput.Default="5000" local:NumericInput.DragStep="25" local:NumericInput.Minimum="50" local:NumericInput.Maximum="500000" local:NumericInput.Decimals="0"
                                 Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding TargetBitrate, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Video bitrate in kbps. Changing it updates Target File Size, and the other way round." />
                        <TextBlock Text="Target File Size (MB):" Style="{StaticResource FieldLabel}" Margin="24,0,8,0" />
                        <TextBox Width="90" Margin="0,4" AutomationProperties.Name="Target File Size" local:NumericInput.Default="" local:NumericInput.DragStep="0.1" local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="100000" local:NumericInput.Decimals="1"
                                 Text="{Binding TargetFileSize, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type a size and the bitrate is worked out from the length of the output and the audio bitrate. Typing here switches Constant Quality to a bitrate mode." />
                        <TextBlock Text="{Binding TargetSizeHint}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   MaxWidth="170" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Target Bitrate (kbps):" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        Right: the speed step, whose list is the selected encoder's own, and the options that only
                        some encoders have. Tune is x264's and x265's, or, while an NVENC encoder is selected, NVIDIA's.
                    -->
                    <TextBlock Grid.Column="3" Text="Encoder Preset:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding EncoderPresets}" SelectedItem="{Binding EncoderPreset}"
                              IsEnabled="{Binding HasEncoderPresets}" AutomationProperties.Name="Encoder Preset"
                              ToolTip="Speed against quality. The steps offered are the selected encoder's own: ultrafast to veryslow for x264 and x265, veryfast to veryslow for QuickSync, Speed, Balanced and Quality for AMF, p1 (fastest) to p7 (highest quality) for NVENC.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EncoderPresetLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Tune:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Tunes}" SelectedItem="{Binding Tune}"
                              IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}"
                              Visibility="{Binding IsNvencEncoder, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding NvencTunes}" SelectedItem="{Binding NvencTune}" AutomationProperties.Name="NVENC Tuning"
                              Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="What the encoder aims for (-tune). High Quality suits files; the low latency ones are for streaming. Lossless keeps every pixel and ignores Rate Control: the files are very large." />

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Profile:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}"
                              IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}" />

                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Level:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="4" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"
                              IsEnabled="{Binding AreSoftwareEncoderOptionsEnabled}" />

                    <!--
                        What only some encoders have, in one row of the same panel: each control is there while an
                        encoder that has it is selected, and the row takes no room when none of them is.
                    -->
                    <WrapPanel Grid.Row="5" Grid.ColumnSpan="5" Margin="0,2,0,0" IsEnabled="{Binding IsVideoReencoded}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Multipass:" Style="{StaticResource FieldLabel}" />
                            <ComboBox MinWidth="190" ItemsSource="{Binding NvencMultipasses}" SelectedItem="{Binding NvencMultipass}" AutomationProperties.Name="NVENC Multipass"
                                      ToolTip="NVENC: a first look at each frame before it is encoded (-multipass), at a quarter of the resolution or all of it. Spends the bitrate better, at some cost in speed." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" Visibility="{Binding IsAmfEncoder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Usage:" Style="{StaticResource FieldLabel}" />
                            <ComboBox MinWidth="250" ItemsSource="{Binding AmfUsages}" SelectedItem="{Binding AmfUsage}" AutomationProperties.Name="AMF Usage"
                                      ToolTip="AMF: what the encoder is set up for (-usage). Transcoding suits files; High Quality spends more time on each frame and needs a recent FFmpeg and driver; the low latency ones and Webcam are for streaming." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" Visibility="{Binding HasLookahead, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Lookahead (frames):" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding Lookahead, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lookahead"
                                     local:NumericInput.Default="0" local:NumericInput.DragStep="1" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="100"
                                     ToolTip="How many frames ahead the rate control looks; 0 turns it off. NVENC looks up to 32 ahead (-rc-lookahead) and a larger number is taken as 32; QuickSync up to 100 (-look_ahead_depth), with VBR and ICQ." />
                        </StackPanel>
                        <CheckBox Content="Spatial AQ" IsChecked="{Binding NvencSpatialAq}" Margin="0,4,24,4" VerticalAlignment="Center"
                                  Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="NVENC: spends more of the bitrate on flat areas, where blocking shows first (-spatial-aq 1)." />
                        <CheckBox Content="Temporal AQ" IsChecked="{Binding NvencTemporalAq}" IsEnabled="{Binding CanNvencTemporalAq}" Margin="0,4,24,4" VerticalAlignment="Center"
                                  Visibility="{Binding IsNvencEncoder, Converter={StaticResource BoolToVisibility}}" ToolTipService.ShowOnDisabled="True"
                                  ToolTip="NVENC: spends more of the bitrate on what stays still from frame to frame (-temporal-aq 1). Greyed out when this graphics card cannot do it for the selected encoder." />
                        <CheckBox Content="10-bit" IsChecked="{Binding TenBit}" IsEnabled="{Binding CanTenBit}" Margin="0,4,0,4" VerticalAlignment="Center"
                                  Visibility="{Binding HasTenBit, Converter={StaticResource BoolToVisibility}}" ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Encodes in 10 bits instead of 8, which shows less banding in gradients (-pix_fmt p010le for a hardware encoder, yuv420p10le for a software one). Greyed out when this graphics card cannot do it for the selected encoder: neither AMF nor QuickSync has 10-bit H.264." />
                    </WrapPanel>

                    <CheckBox Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Content="Enable Hardware Decoding (-hwaccel auto)"
                              IsChecked="{Binding HardwareDecoding}" IsEnabled="{Binding IsVideoReencoded}"
                              ToolTip="Let the GPU decode the source. Speeds up most encodes; turn it off if an encode fails to start." />

                    <!-- Bottom: free-form encoder options, and what was detected -->
                    <TextBlock Grid.Row="6" Text="Extra Options:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" FontFamily="Consolas" IsEnabled="{Binding IsVideoReencoded}"
                             Text="{Binding ExtraVideoArguments, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Added after the encoder's own options, for example -g 1 -keyint_min 1 or -profile:v 0." />
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding HardwareEncoderStatusText}" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding HdrStatusText}" Foreground="{DynamicResource WarningTextBrush}" Margin="24,0,0,0" />
                    </StackPanel>
                </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Everything that is done to the picture as a whole: the standard filters, the look, and the color grading. -->
            <TabItem Header="Filters" x:Name="AdvancedTab">
                <DockPanel IsEnabled="{Binding IsVideoReencoded}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Live Frame Preview" Click="LiveFramePreview_Click"
                                ToolTip="Shows one frame of the video with these settings applied, updated as the controls move, with an optional histogram." />
                        <Button Content="Reset Colors" Margin="6,0,0,0" Command="{Binding ResetColorCommand}" ToolTip="Puts every color control back where it changes nothing."
                                Visibility="{Binding ShowAdvancedFiltersTab, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox Content="Deinterlace (yadif)" IsChecked="{Binding Deinterlace}" Margin="0,4,24,4" />
                                <CheckBox Content="Denoise (hqdn3d)" IsChecked="{Binding Denoise}" Margin="0,4,24,4" />
                                <CheckBox Content="Audio/Video Fade In (1s)" IsChecked="{Binding FadeIn}" Margin="0,4,24,4"
                                          ToolTip="Fades the picture and every encoded audio track in from black and silence." />
                                <CheckBox Content="Audio/Video Fade Out (1s)" IsChecked="{Binding FadeOut}" Margin="0,4,24,4"
                                          ToolTip="Fades the last second of the output to black and silence." />
                            </WrapPanel>
                            <DockPanel Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" Width="760">
                                <TextBlock DockPanel.Dock="Left" Text="LUT (.cube):" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button DockPanel.Dock="Right" Content="Clear" Margin="6,4,0,4" Click="ClearLut_Click" />
                                <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,4,0,4" Click="BrowseLut_Click" />
                                <TextBox Margin="0,4" Text="{Binding LutPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A 3D lookup table applied to the colours (lut3d). Leave blank for none." />
                            </DockPanel>
                            <!-- Color grading and sharpening. Can be hidden in Settings; values set here keep applying while it is. -->
                            <local:ColorControls Margin="0,10,0,0" Visibility="{Binding ShowAdvancedFiltersTab, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!--
                Editor Mode only. The picture as a stack of layers: the list sits flush against the top of the tab,
                and what adds to it and places the main video is underneath.
            -->
            <TabItem Header="Layers" x:Name="LayersTab" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel IsEnabled="{Binding IsVideoReencoded}">
                        <!--
                            Everything below the layers in one panel: what adds a layer, and the editing tools.
                            On one row when the window is wide enough; wrapping when it is not.
                        -->
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" x:Name="LayerAddBar" SizeChanged="LayerAddBar_SizeChanged">
                            <!--
                                One button adds a layer of any kind: it opens a menu of the kinds. Its icon is drawn
                                from geometry: two sheets, one over the other, and a plus.
                            -->
                            <ToggleButton x:Name="AddLayerButton" Padding="10,5" Margin="0,2,0,2" AutomationProperties.Name="Add Layer"
                                          ToolTip="Add a layer: a video, an image, text, or a piece of the main video.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="18" Height="16" Stretch="None" VerticalAlignment="Center" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          Data="M 1,6 L 8,2.5 L 15,6 L 8,9.5 Z M 1,9.5 L 8,13 L 11,11.5 M 14.5,10 L 14.5,16 M 11.5,13 L 17.5,13" />
                                    <TextBlock Text="Add Layer" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="AddLayerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Top" VerticalOffset="-4"
                                   PlacementTarget="{Binding ElementName=AddLayerButton}" IsOpen="{Binding IsChecked, ElementName=AddLayerButton, Mode=TwoWay}"
                                   Opened="AddLayerPopup_Opened" Closed="AddLayerPopup_Closed">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}" MinWidth="190">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Margin" Value="0,1" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Button Content="Video" Tag="Video" Click="AddLayerMenu_Click"
                                                ToolTip="A video from a file: it plays alongside the main video and starts again when it runs out." />
                                        <Button Content="Image" Tag="Image" Click="AddLayerMenu_Click"
                                                ToolTip="A .png or .jpg picture: a logo, a watermark, a frame." />
                                        <Button Content="Text" Tag="Text" Click="AddLayerMenu_Click"
                                                ToolTip="Words: a title or a label. Its words, font and colors are set under Text Settings while the layer is selected." />
                                        <Button Content="Region of Main Video" Tag="Region" Click="AddLayerMenu_Click"
                                                ToolTip="A piece of the source video (a minimap, an ammo counter) lifted onto the frame. Mark it with Draw Target." />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Content="HUD Masks" Padding="12,5" Margin="6,2,0,2" Click="HudMasks_Click"
                                    ToolTip="Takes a game's HUD apart into layers (killfeed, health, radar, abilities), each cut out with its own mask, so each can be moved on its own. For Overwatch 2, Counter-Strike 2, Apex Legends and Marvel Rivals." />
                            <!-- The editing tools, as icons: each works on whatever block is selected on a time bar -->
                            <Button Content="[" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Padding="11,5" Margin="18,0,4,0" Command="{Binding AddStartPointCommand}"
                                    AutomationProperties.Name="Add Start Point" ToolTip="Add Start Point (I): a new cut segment of the main video begins at the playhead." />
                            <Button Content="]" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Padding="11,5" Margin="0,0,4,0" Command="{Binding AddStopPointCommand}"
                                    AutomationProperties.Name="Add Stop Point" ToolTip="Add Stop Point (O): the segment begun with the start point ends at the playhead." />
                            <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="ManualCut_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Manual Cut Entry" ToolTip="Manual Cut Entry: type the start and stop of a cut." />
                            <Button Content="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="SplitClip_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Split at Playhead" ToolTip="Split at Playhead (S): cuts the selected block in two at the playhead. A layer becomes two layers, a cut segment two segments, an audio track two parts. With nothing selected, the main video is split." />
                            <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="TrimStart_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Trim Start to Playhead" ToolTip="Trim Start to Playhead: the selected layer or segment begins at the playhead; what came before goes." />
                            <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="TrimEnd_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Trim End to Playhead" ToolTip="Trim End to Playhead: the selected layer or segment ends at the playhead; what came after goes." />
                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="DeleteClip_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Delete Selected" ToolTip="Delete (Del): removes the selected layer or cut segment, or silences the selected part of an audio track." />
                            <Button Content="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="RemoveDeadAir_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    AutomationProperties.Name="Remove Dead Air" ToolTip="Remove Dead Air: finds the silences in the selected track (a video layer, an audio track, or otherwise the main video) and either marks them as skipped or removes them." />
                            <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="10,0,4,0" Click="Undo_Click"
                                    AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z): takes back the last change to the cuts, the layers or the audio. Twenty steps are kept." />
                            <Button Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="Redo_Click"
                                    AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y): does again what was just undone." />
                            <ToggleButton Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="10,0,4,0" IsChecked="{Binding AudioLinked, Mode=OneWay}" Checked="LinkAudio_Click" Unchecked="LinkAudio_Click"
                                          AutomationProperties.Name="Link Audio and Video" ToolTip="Link Audio and Video: linked, sound follows its picture and is cut with it. Unlinked, an audio block can be dragged on its own; linking again offers to snap it back." />
                            <CheckBox Content="Show linked audio" IsChecked="{Binding ShowLinkedAudio}" Margin="10,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Draws the waveform of the sound that belongs to a picture over its block: the main video's own audio over its segments, and a video layer's over its clips. While audio and video are unlinked, a video layer's sound has a bar of its own instead, so that it can be dragged." />
                            <!-- The recycle bin: deleted clips wait here, and are put back from here. -->
                            <ToggleButton x:Name="LayersBinButton" Padding="10,6" Margin="10,0,4,0" AutomationProperties.Name="Recycle Bin"
                                          ToolTip="Recycle Bin: the clips that were deleted from the timeline. Nothing of them is rendered; any of them can be put back where it was.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RecycleBinText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=LayersBinButton}" Placement="Top" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=LayersBinButton, Mode=TwoWay}" Opened="BinPopup_Opened" Closed="BinPopup_Closed" Tag="{Binding ElementName=LayersBinButton}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Empty" Padding="10,3" Click="EmptyBin_Click" IsEnabled="{Binding HasDeleted}"
                                                    ToolTip="Throws away everything in the bin. (Ctrl+Z still brings it back.)" />
                                            <TextBlock Text="Recycle Bin" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Nothing has been deleted." Foreground="{DynamicResource MutedTextBrush}" Width="380"
                                                   Visibility="{Binding HasDeleted, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding RecycleBin}" ItemTemplate="{StaticResource BinItemTemplate}" Focusable="False" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <!--
                                The keyframe controls, for the clip that is selected: as icons while the bar has room for
                                them, and behind one button, with their names written out, while it has not.
                            -->
                            <StackPanel x:Name="KeyBarInline" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,6" Margin="0,0,4,0" Click="PreviousKeyframe_Click"
                                        AutomationProperties.Name="Previous Keyframe (Bar)" ToolTip="Previous Keyframe of the selected clip." />
                                <Button Content="&#x2666;" FontSize="14" Padding="12,4" Margin="0,0,4,0" Click="ToggleKeyframe_Click" Foreground="Gold"
                                        AutomationProperties.Name="Add or Remove Keyframe (Bar)" ToolTip="Add / Remove Keyframe: sets a keyframe for the selected clip at the playhead, or removes the one that is there." />
                                <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,6" Margin="0,0,4,0" Click="NextKeyframe_Click"
                                        AutomationProperties.Name="Next Keyframe (Bar)" ToolTip="Next Keyframe of the selected clip." />
                                <ToggleButton Content="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" IsChecked="{Binding KeyframesEnabled}"
                                              AutomationProperties.Name="Enable Keyframes (Bar)" ToolTip="Enable Keyframes: while on, moving, resizing or turning a clip writes a keyframe." />
                                <ToggleButton Content="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" IsChecked="{Binding KeyframesSnap}" IsEnabled="{Binding KeyframesEnabled}"
                                              AutomationProperties.Name="Snap to Nearest Keyframe (Bar)" ToolTip="Snap to Nearest: a move changes the keyframe nearest the playhead. Off, it sets a new keyframe at the playhead." />
                            </StackPanel>
                            <ToggleButton x:Name="KeyBarButton" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="11,7" Margin="10,0,0,0" Visibility="Collapsed"
                                          AutomationProperties.Name="Keyframe Controls" ToolTip="Keyframe controls for the selected clip." />
                            <Popup x:Name="KeyBarPopup" PlacementTarget="{Binding ElementName=KeyBarButton}" Placement="Top" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=KeyBarButton, Mode=TwoWay}" Opened="BinPopup_Opened" Closed="BinPopup_Closed" Tag="{Binding ElementName=KeyBarButton}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                        <Button Content="Previous Keyframe" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left" Click="PreviousKeyframe_Click" />
                                        <Button Content="Add / Remove Keyframe" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left" Click="ToggleKeyframe_Click" />
                                        <Button Content="Next Keyframe" Padding="10,4" Margin="0,2" HorizontalContentAlignment="Left" Click="NextKeyframe_Click" />
                                        <CheckBox Content="Enable keyframes" IsChecked="{Binding KeyframesEnabled}" Margin="0,6,0,2" />
                                        <RadioButton Content="Create new on move" GroupName="KeyframeModeBar" IsChecked="{Binding KeyframesCreate}" Margin="0,2" IsEnabled="{Binding KeyframesEnabled}" />
                                        <RadioButton Content="Snap to nearest" GroupName="KeyframeModeBar" IsChecked="{Binding KeyframesSnap}" Margin="0,2" IsEnabled="{Binding KeyframesEnabled}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <!-- How tall each track's time bar is -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" ToolTip="Layer height: how tall each track's time bar is.">
                                <TextBlock Text="&#xE1D8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider Width="70" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                                        Value="{Binding LayerTrackHeight}" AutomationProperties.Name="Layer Height" local:NumericInput.Default="25" />
                            </StackPanel>
                            <TextBlock Text="{Binding PendingStartText}" Style="{StaticResource TimeText}" Margin="14,0,18,0" />
                        </WrapPanel>

                        <!--
                            Text Settings: the words of the text layer that is selected (its row here, or its block on
                            the timeline), and how they are drawn. Not there while anything else is selected.
                        -->
                        <GroupBox DockPanel.Dock="Bottom" Header="Text Settings" Margin="0,6,0,0" x:Name="TextSettingsPanel"
                                  Visibility="{Binding IsTextLayerSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid DataContext="{Binding SelectedTextLayer}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140" MaxWidth="420" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="72" VerticalContentAlignment="Top"
                                         AutomationProperties.Name="Text Content"
                                         ToolTip="The words. Enter starts a new line; the lines are centered. The layer's box follows what is typed." />
                                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,4">
                                        <TextBlock Text="Font:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                        <ComboBox Width="190" ItemsSource="{Binding DataContext.SystemFonts, ElementName=LayersList}" SelectedItem="{Binding FontFamily}"
                                                  IsTextSearchEnabled="True" AutomationProperties.Name="Font"
                                                  ToolTip="The font, from those installed on this computer.">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,4"
                                                ToolTip="The font's size, in pixels of the output frame. The layer's own Size, and its Scale keyframes, scale the words from there.">
                                        <TextBlock Text="Size:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                        <Slider Width="110" VerticalAlignment="Center" Minimum="8" Maximum="300" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                                Value="{Binding FontSize}" AutomationProperties.Name="Font Size" local:NumericInput.Default="48" />
                                        <TextBox Style="{StaticResource ValueBox}" Width="50" Text="{Binding FontSize, StringFormat={}{0:0}}" AutomationProperties.Name="Font Size Value"
                                                 local:NumericInput.Default="48" local:NumericInput.DragStep="1" local:NumericInput.Decimals="0" local:NumericInput.Minimum="8" local:NumericInput.Maximum="400" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,4">
                                        <TextBlock Text="Color:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                        <Button Width="26" Height="22" Padding="0" Background="{Binding FontColor}" Click="TextColor_Click" Tag="Font" Cursor="Hand"
                                                AutomationProperties.Name="Pick Font Color" ToolTip="Click to pick the color of the letters." />
                                        <TextBox Width="74" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Center" FontFamily="Consolas" MaxLength="7"
                                                 Text="{Binding FontColor, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Font Color"
                                                 ToolTip="The color of the letters, as #RRGGBB." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,4">
                                        <TextBlock Text="Outline:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                        <Button Width="26" Height="22" Padding="0" Background="{Binding OutlineColor}" Click="TextColor_Click" Tag="Outline" Cursor="Hand"
                                                AutomationProperties.Name="Pick Outline Color" ToolTip="Click to pick the color of the line around the letters." />
                                        <TextBox Width="74" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Center" FontFamily="Consolas" MaxLength="7"
                                                 Text="{Binding OutlineColor, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Outline Color"
                                                 ToolTip="The color of the line around the letters, as #RRGGBB." />
                                        <Slider Width="80" Margin="10,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2" TickFrequency="1"
                                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding OutlineThickness}" AutomationProperties.Name="Outline Thickness"
                                                local:NumericInput.Default="2" ToolTip="How thick the line around the letters is, in pixels at the font's size; 0 for none." />
                                        <TextBox Style="{StaticResource ValueBox}" Width="40" Text="{Binding OutlineThickness}" AutomationProperties.Name="Outline Thickness Value"
                                                 local:NumericInput.Default="2" local:NumericInput.DragStep="0.1" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="20" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!--
                            One row per layer, the front one first: the caption box (while auto-captions are on), the layers
                            added by hand with the main video among them, and the blurred background at the bottom.
                            The main video is a row like the others, named after its file.
                        -->
                        <ListBox ItemsSource="{Binding LayerRows}" x:Name="LayersList" SizeChanged="TrackList_SizeChanged" AllowDrop="True" SelectionChanged="LayersList_SelectionChanged"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Layers">
                            <ListBox.Resources>
                                <!--
                                    A layer's controls: what it is (its buttons) on a first line, where it sits (size, X, Y,
                                    turn) under it. No wider than this; what does not fit on a line goes onto the next. Shown
                                    in the layer's row, or, when the window is too narrow for that, in a flyout from the row.
                                -->
                                <DataTemplate x:Key="LayerControls">
                                    <StackPanel MaxWidth="226" VerticalAlignment="Center" TextElement.FontSize="11.5">
                                            <WrapPanel HorizontalAlignment="Right">

                                            <!-- The background: its blur, here where it is in the stack -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsBackground, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Blur Radius:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="60" Minimum="5" Maximum="50" VerticalAlignment="Center"
                                                        Value="{Binding DataContext.BlurRadius, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        AutomationProperties.Name="Background Blur Radius" local:NumericInput.Default="20"
                                                        ToolTip="How far the blur of the background reaches, in pixels. Larger is softer. The background shows wherever the main video does not cover the frame." />
                                                <TextBox Style="{StaticResource ValueBox}" Width="46"
                                                         Text="{Binding DataContext.BlurRadius, RelativeSource={RelativeSource AncestorType=ListBox}, StringFormat={}{0:0}}"
                                                         AutomationProperties.Name="Background Blur Radius Value"
                                                         local:NumericInput.Default="20" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0" local:NumericInput.Minimum="5" local:NumericInput.Maximum="50" />
                                                <Button Content="More..." Padding="7,1" Margin="8,0,0,0" Click="BlurSettings_Click"
                                                        ToolTip="Blur passes and how much the background is darkened." />
                                            </StackPanel>
                                            <!-- Only a piece of the video has a place in the source to mark -->
                                            <Button Grid.Column="3" Content="Draw Target" Padding="7,1"
                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Drag a rectangle on the video to mark what this layer shows."
                                                    Command="{Binding DataContext.DrawTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- A video from a file runs at a speed of its own -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Speed: how many times as fast as recorded this clip runs, from 0.1 to 10. Its block on the timeline gets shorter as it gets faster, and longer as it gets slower. On a track with several clips this is the first one; right-click a clip for its own.">
                                                <TextBlock Text="Speed x" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Style="{StaticResource ValueBox}" Width="48" Text="{Binding ClipSpeed, StringFormat={}{0:0.##}}" AutomationProperties.Name="Clip Speed"
                                                         local:NumericInput.Default="1" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="10" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="Properties" Padding="7,1" Margin="4,0,0,2" Click="LayerProperties_Click"
                                                    Visibility="{Binding HasStyle, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Opacity, rounded corners, soft edges and a drop shadow, for every layer including the subtitles; and for pictures and videos, a chroma key and a custom mask. The captions' font and colors are under Caption Style Settings on the Subtitles tab." />
                                            <Button Grid.Column="5" Content="Remove" Padding="7,1" Margin="4,0,0,2" Click="RemoveTrack_Click"
                                                    Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Removes this track: the layer, and every clip it was split into." />
                                            </WrapPanel>
                                        <WrapPanel Margin="0,3,0,0" HorizontalAlignment="Right" Visibility="{Binding HasPlacement, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Size %" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource ValueBox}" Width="46" Margin="0"
                                                         Text="{Binding SizePercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Layer Size"
                                                         local:NumericInput.DragStep="0.25" local:NumericInput.Minimum="1" local:NumericInput.Maximum="400"
                                                         ToolTip="Width of the layer as a percentage of the frame's width. The layer grows and shrinks about its middle. Drag sideways to adjust, or click to type." />
                                                <!-- A layer that is not held to its shape (and so always the caption box) has a height of its own -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFreeHeight, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="H %" VerticalAlignment="Center" Margin="6,0,4,0" />
                                                    <TextBox Style="{StaticResource ValueBox}" Width="46" Margin="0"
                                                             Text="{Binding SizeHeightPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Layer Height"
                                                             local:NumericInput.DragStep="0.25" local:NumericInput.Minimum="1" local:NumericInput.Maximum="200"
                                                             ToolTip="Height of the layer as a percentage of the frame's height. For the caption box, a taller box makes the words larger." />
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="Lock Aspect" IsChecked="{Binding LockAspectRatio}" Margin="10,0,0,0"
                                                      Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="On: the layer keeps its own shape. Off: its width and height can be stretched separately with the corner handle in the Layout Pane." />
                                            <TextBlock Grid.Column="3" Text="X %" VerticalAlignment="Center" Margin="8,0,4,0" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource ValueBox}" Width="48" Text="{Binding PositionXPercent, StringFormat={}{0:0.#}}"
                                                         AutomationProperties.Name="Layer X Value"
                                                         local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="6" Text="Y %" VerticalAlignment="Center" Margin="8,0,4,0" />
                                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource ValueBox}" Width="48" Text="{Binding PositionYPercent, StringFormat={}{0:0.#}}"
                                                         AutomationProperties.Name="Layer Y Value"
                                                         local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-200" local:NumericInput.Maximum="200" />
                                            </StackPanel>
                                            <!-- Every picture but the caption box can be turned -->
                                            <StackPanel Grid.Column="9" Orientation="Horizontal" Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Rot &#176;" VerticalAlignment="Center" Margin="8,0,4,0" />
                                                <TextBox Style="{StaticResource ValueBox}" Width="48" Text="{Binding Rotation, StringFormat={}{0:0.#}}"
                                                         AutomationProperties.Name="Layer Rotation"
                                                         local:NumericInput.Default="0" local:NumericInput.DragStep="0.5" local:NumericInput.Decimals="1" local:NumericInput.Minimum="-360" local:NumericInput.Maximum="360"
                                                         ToolTip="Degrees the layer is turned clockwise about its middle." />
                                            </StackPanel>
                                        </WrapPanel>
                                                                            </StackPanel>
                                </DataTemplate>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        A layer's row, laid out as a sound's is on the Audio tab: what it is on the left, its
                                        time bar across the middle, taking the row's height, and its controls in a block on the right.
                                    -->
                                    <Grid x:Name="layerRow" Background="Transparent" ContextMenuOpening="LayerRow_ContextMenuOpening" ToolTip="X and Y place the layer's top-left corner, and Size sets its width, all as a share of the output frame, so the layout holds at any resolution. The Layout Pane does the same by dragging.">
                                        <Grid.ContextMenu>
                                            <ContextMenu />
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="232" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: the order buttons, the kind of thing it is, its name, and the arrow that folds its controls away -->
                                        <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <!-- Up is towards the front. The captions are always in front and the background always behind. -->
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,6,0" Width="58">
                                                <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="7,4" AutomationProperties.Name="Move Layer Up"
                                                        Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Move this layer up, towards the front: it is drawn over the layers below it."
                                                        Command="{Binding DataContext.MoveLayerUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="7,4" Margin="3,0,0,0" AutomationProperties.Name="Move Layer Down"
                                                        Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Move this layer down, towards the back: the layers above it are drawn over it."
                                                        Command="{Binding DataContext.MoveLayerDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="layerExpand" DockPanel.Dock="Right" IsChecked="True" Padding="6,4" Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                          AutomationProperties.Name="Show Layer Controls" ToolTip="Shows or folds away this layer's controls on the right, leaving more room for its time bar.">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                        <Setter Property="Content" Value="&#xE76C;" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Content" Value="&#xE70D;" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <!-- Sheets one over another, as geometry: a layer -->
                                            <Path DockPanel.Dock="Left" Width="18" Height="16" Stretch="None" VerticalAlignment="Center" Margin="0,0,8,0" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  Stroke="{DynamicResource MutedTextBrush}" Data="M 1,6 L 9,2 L 17,6 L 9,10 Z M 1,10 L 9,14 L 17,10" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        </DockPanel>

                                        <!-- Middle: the time bar, as tall as the Layer Height slider makes it -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!--
                                            The track in time: a bar as long as the video, with the layer as a block on it from
                                            when it appears to when it goes; a layer that was split is two blocks on the same bar.
                                            The Main Video's bar shows the cut segments. A block is dragged to move it and by its
                                            right edge to change how long it stays; a click on the bar moves the playhead there.
                                            A video layer's block is drawn with frames from its file. Drawn from code.
                                        -->
                                        <local:TimelineTrack Height="{Binding DataContext.LayerBarHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0,1,0,1" Background="{DynamicResource InsetBrush}" ClipToBounds="True" Cursor="Hand"
                                                Loaded="ClipTrack_Loaded" Unloaded="ClipTrack_Unloaded" SizeChanged="ClipTrack_Changed" DataContextChanged="ClipTrack_DataContextChanged"
                                                MouseLeftButtonDown="ClipTrack_MouseLeftButtonDown" AutomationProperties.Name="Layer Timeline" />
                                        <!-- A video layer's own sound, on a bar of its own while audio and video are unlinked; linked, it is drawn on the block above -->
                                        <local:TimelineTrack Height="16" Margin="0,1,0,1" Background="{DynamicResource InsetBrush}" ClipToBounds="True" Tag="audio" Visibility="Collapsed"
                                                Loaded="ClipTrack_Loaded" Unloaded="ClipTrack_Unloaded" SizeChanged="ClipTrack_Changed" DataContextChanged="ClipTrack_DataContextChanged"
                                                MouseLeftButtonDown="ClipTrack_MouseLeftButtonDown" AutomationProperties.Name="Layer Audio Timeline" />
                                        </StackPanel>

                                        <!-- Right: the layer's controls, in a block of their own (folded away by the arrow, or by a narrow window) -->
                                        <ContentControl Grid.Column="2" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource LayerControls}" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=layerExpand}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.CompactTrackControls, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>

                                        <!--
                                            With the window too narrow for a time bar of any use beside them, the controls are
                                            taken out of the row and offered from this one button instead, in a flyout.
                                        -->
                                        <ToggleButton Grid.Column="2" x:Name="layerControlsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Layer Controls" ToolTip="This layer's controls: its buttons, size, place and turn. They are here because the window is too narrow to show them in the row."
                                                      Visibility="{Binding DataContext.CompactTrackControls, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />
                                        <Popup PlacementTarget="{Binding ElementName=layerControlsButton}" Placement="Left" HorizontalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                                               IsOpen="{Binding IsChecked, ElementName=layerControlsButton, Mode=TwoWay}" Opened="TrackControlsPopup_Opened" Closed="TrackControlsPopup_Closed">
                                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                                    TextElement.Foreground="{DynamicResource TextBrush}">
                                                <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource LayerControls}" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- A hidden layer stays in the list, dimmed -->
                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                            <Setter TargetName="layerRow" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
            </TabItem>
            <TabItem Header="Audio">
                <DockPanel x:Name="AudioPanel" Background="Transparent" AllowDrop="True"
                           ToolTipService.ShowDuration="6000">
                    <!--
                        Applies to every track at once, and sets the codec of a mixed track. One line: the codec on
                        the left, the buttons on the right, and between them the checkboxes while there is room for
                        them. When there is not, they are not wrapped onto a second line (where they ran into the
                        rows below): they fold into one button that opens them as a small menu.
                    -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All tracks:" Style="{StaticResource FieldLabel}" />
                            <ComboBox Margin="0" ItemsSource="{Binding AudioEncoders}" SelectedItem="{Binding AudioEncoder}"
                                      ToolTip="Sets every track below to this codec. Also the codec of the mixed track when mixing." />
                            <ComboBox Margin="8,0,0,0" MinWidth="90" ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrate}"
                                      IsEnabled="{Binding IsAudioReencoded}" />
                        </StackPanel>
                        <Grid Grid.Column="1" x:Name="AudioOptionsHost" ClipToBounds="True" Margin="24,0,10,0" SizeChanged="AudioOptionsHost_SizeChanged">
                            <StackPanel x:Name="AudioOptionsInline" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <CheckBox Content="Mix Selected Tracks" IsChecked="{Binding MergeAudioTracks}" Margin="0"
                                          ToolTip="Merges / mixes the selected tracks into a single track: every track that is not set to Ignore / Drop goes into one output track (amix). The mix is always encoded. Editor Mode starts with this on." />
                                <CheckBox Content="Normalize audio" IsChecked="{Binding NormalizeAudio}" Margin="20,0,0,0"
                                          ToolTip="Evens out the loudness to the EBU R128 standard: loudnorm (I=-16, TP=-1.5, LRA=11), applied to re-encoded and mixed tracks. Copied tracks are left as they are." />
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                            ToolTip="How far a sound set to Auto-Duck is turned down while a sound marked Voice is speaking. Right-click a track to set it to Auto-Duck, or to mark it as the voice.">
                                    <TextBlock Text="Duck by (dB):" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding DuckAmountDb, StringFormat={}{0:0}}" AutomationProperties.Name="Duck Amount"
                                             local:NumericInput.Default="-15" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="-1" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton x:Name="AudioOptionsButton" Content="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="11,6" HorizontalAlignment="Left"
                                          Visibility="Collapsed" AutomationProperties.Name="Audio Options"
                                          ToolTip="Audio options: mix selected tracks, normalize audio, and how far Auto-Duck turns a sound down." />
                            <Popup x:Name="AudioOptionsPopup" PlacementTarget="{Binding ElementName=AudioOptionsButton}" Placement="Bottom" VerticalOffset="4" StaysOpen="False"
                                   AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=AudioOptionsButton, Mode=TwoWay}"
                                   Opened="BinPopup_Opened" Closed="BinPopup_Closed">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                        <CheckBox Content="Mix Selected Tracks" IsChecked="{Binding MergeAudioTracks}" Margin="0,2"
                                                  ToolTip="Merges / mixes the selected tracks into a single track: every track that is not set to Ignore / Drop goes into one output track (amix). The mix is always encoded. Editor Mode starts with this on." />
                                        <CheckBox Content="Normalize audio" IsChecked="{Binding NormalizeAudio}" Margin="0,2"
                                                  ToolTip="Evens out the loudness to the EBU R128 standard: loudnorm (I=-16, TP=-1.5, LRA=11), applied to re-encoded and mixed tracks. Copied tracks are left as they are." />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                    ToolTip="How far a sound set to Auto-Duck is turned down while a sound marked Voice is speaking. Right-click a track to set it to Auto-Duck, or to mark it as the voice.">
                                            <TextBlock Text="Duck by (dB):" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding DuckAmountDb, StringFormat={}{0:0}}" AutomationProperties.Name="Duck Amount (Menu)"
                                                     local:NumericInput.Default="-15" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="-1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- An eye struck through: lists only the sounds that go into the output -->
                            <ToggleButton IsChecked="{Binding HideDroppedTracks}" Padding="9,6" Margin="0,0,8,0" AutomationProperties.Name="Show or Hide Muted Tracks"
                                          ToolTip="Show/hide muted tracks: hides the sounds that are muted (in Encoder Mode, set to Ignore / Drop), so the list shows only what goes into the output. Press again to show them.">
                                <Path Width="19" Height="15" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      Data="M1,8 C3,4.2 5.5,2.5 8,2.5 C10.5,2.5 13,4.2 15,8 C13,11.8 10.5,13.5 8,13.5 C5.5,13.5 3,11.8 1,8 Z M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z M2.6,14.2 L13.4,1.8" />
                            </ToggleButton>
                            <Button Content="Add Audio File..." Padding="12,5" Click="AddAudio_Click" IsEnabled="{Binding IsEnabled, ElementName=AddStartButton}"
                                    ToolTip="Adds a sound from a file (music, a recording, or the sound of a video) to the timeline as a clip of its own, starting at the playhead. It is mixed into the first audio track. A file can also be dropped anywhere on this tab." />
                            <!-- Editor Mode's: a recording goes onto the timeline as a clip, and Encoder Mode has no timeline of clips. -->
                            <Button Margin="8,0,0,0" Padding="12,5" Click="OpenVoiceoverStudio_Click" AutomationProperties.Name="Record Voiceover"
                                    Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Record Voiceover: record from a microphone while the video plays. When the recording is stopped it goes onto the timeline as an audio clip of its own, starting where the playhead was when it began.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Record Voiceover" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AudioTracksHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                    <!-- The voiceover, once there is one: a track of its own in the picture, mixed into the first track in the encode -->
                    <Grid DockPanel.Dock="Bottom" Height="50" Margin="0,6,0,0" Visibility="{Binding HasVoiceover, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Voiceover" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VoiceoverTrimText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding VoiceoverWaveform}" Stretch="Fill" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Voiceover Track Waveform">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding VoiceoverGainDb, Converter={StaticResource DecibelToScale}}" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <CheckBox Content="Mix into output" IsChecked="{Binding MixVoiceover}" Margin="0,0,14,0"
                                      ToolTip="Adds the voiceover to the encode as a second input, mixed into the first audio track. It is always mixed in when captions are made from it." />
                            <TextBlock Text="Gain (dB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Width="130" Minimum="-24" Maximum="24" VerticalAlignment="Center"
                                    Value="{Binding VoiceoverGainDb}" AutomationProperties.Name="Voiceover Gain" local:NumericInput.Default="0" />
                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding VoiceoverGainDb, StringFormat={}{0:0}}" AutomationProperties.Name="Voiceover Gain Value"
                                     local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-24" local:NumericInput.Maximum="24" />
                            <Button Content="Delete Voiceover" Padding="10,4" Margin="14,0,0,0" Command="{Binding RemoveVoiceoverCommand}"
                                    ToolTip="Takes the voiceover out of the project. A recording is deleted; a file brought in from elsewhere is left where it is." />
                        </StackPanel>
                    </Grid>

                    <!-- Master mix: the tracks' waveforms laid over each other, each with its gain -->
                    <!-- One line: the tools for the audio blocks (the same as on the Layers tab), then the mix -->
                    <Grid DockPanel.Dock="Bottom" Height="34" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Click a track's waveform to select it. Unlink (the chain button) to drag it; split it at the playhead to silence a part.">
                            <Button Content="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="SplitClip_Click"
                                    AutomationProperties.Name="Split Audio at Playhead" ToolTip="Split at Playhead (S): cuts the selected audio track in two at the playhead, so a part of it can be silenced." />
                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="DeleteClip_Click"
                                    AutomationProperties.Name="Silence Selected Audio" ToolTip="Delete (Del): silences the selected part of an audio track. Pressed again on a silenced part, it plays again." />
                            <Button Content="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="RemoveDeadAir_Click"
                                    AutomationProperties.Name="Remove Dead Air from Audio" ToolTip="Remove Dead Air: listens to the selected audio track for silences, and marks or removes them from the video." />
                            <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="10,0,4,0" Click="Undo_Click" AutomationProperties.Name="Undo Audio" ToolTip="Undo (Ctrl+Z)" />
                            <Button Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="0,0,4,0" Click="Redo_Click" AutomationProperties.Name="Redo Audio" ToolTip="Redo (Ctrl+Y)" />
                            <ToggleButton Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="10,6" Margin="10,0,4,0" IsChecked="{Binding AudioLinked, Mode=OneWay}" Checked="LinkAudio_Click" Unchecked="LinkAudio_Click"
                                          AutomationProperties.Name="Link Audio and Video (Audio Tab)" ToolTip="Link Audio and Video: linked, sound follows its picture and is cut with it. Unlinked, an audio block can be dragged on its own; linking again offers to snap it back." />
                            <!-- The recycle bin: deleted clips wait here, and are put back from here. -->
                            <ToggleButton x:Name="AudioBinButton" Padding="10,6" Margin="10,0,4,0" AutomationProperties.Name="Recycle Bin"
                                          ToolTip="Recycle Bin: the clips that were deleted from the timeline. Nothing of them is rendered; any of them can be put back where it was.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RecycleBinText}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=AudioBinButton}" Placement="Top" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=AudioBinButton, Mode=TwoWay}" Opened="BinPopup_Opened" Closed="BinPopup_Closed" Tag="{Binding ElementName=AudioBinButton}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Empty" Padding="10,3" Click="EmptyBin_Click" IsEnabled="{Binding HasDeleted}"
                                                    ToolTip="Throws away everything in the bin. (Ctrl+Z still brings it back.)" />
                                            <TextBlock Text="Recycle Bin" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Nothing has been deleted." Foreground="{DynamicResource MutedTextBrush}" Width="380"
                                                   Visibility="{Binding HasDeleted, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding RecycleBin}" ItemTemplate="{StaticResource BinItemTemplate}" Focusable="False" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" ToolTip="Track height: how tall each sound's row is.">
                                <TextBlock Text="&#xE1D8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider Width="70" Margin="6,0,0,0" VerticalAlignment="Center" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                                        Value="{Binding AudioTrackHeight}" AutomationProperties.Name="Audio Track Height" local:NumericInput.Default="25" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Master Mix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding ShowWaveforms, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="The tracks' waveforms laid over each other, each at its gain: what the mix looks like." />
                        <Border Grid.Column="2" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True" Cursor="Hand"
                                Visibility="{Binding ShowWaveforms, Converter={StaticResource BoolToVisibility}}"
                                MouseLeftButtonDown="Waveform_MouseLeftButtonDown" MouseMove="Waveform_MouseMove" MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                                ToolTip="Click or drag to move the playhead to that moment.">
                            <Grid>
                            <ItemsControl ItemsSource="{Binding AudioTracks}" Focusable="False" AutomationProperties.Name="Master Mix View">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleY="{Binding GainDb, Converter={StaticResource DecibelToScale}}" />
                                            </Image.RenderTransform>
                                        </Image>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The voiceover: only the part its trim keeps, starting where it starts and as long as it lasts -->
                            <Canvas x:Name="MixVoiceCanvas" IsHitTestVisible="False"
                                    Visibility="{Binding IncludeVoiceover, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding VoiceoverMixWaveform}" Stretch="Fill" Opacity="0.8" RenderTransformOrigin="0.5,0.5"
                                       Height="{Binding ActualHeight, ElementName=MixVoiceCanvas}" AutomationProperties.Name="Voiceover In Master Mix">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource FractionToOffset}">
                                            <Binding Path="VoiceoverMixStart" />
                                            <Binding Path="ActualWidth" ElementName="MixVoiceCanvas" />
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Image.Width>
                                        <MultiBinding Converter="{StaticResource FractionToOffset}">
                                            <Binding Path="VoiceoverMixWidth" />
                                            <Binding Path="ActualWidth" ElementName="MixVoiceCanvas" />
                                        </MultiBinding>
                                    </Image.Width>
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleY="{Binding VoiceoverGainDb, Converter={StaticResource DecibelToScale}}" />
                                    </Image.RenderTransform>
                                </Image>
                            </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--
                        One list for every sound on the timeline: the video's own audio tracks, and after them the
                        sounds added from files. Every row is made from the one template below, whichever of the two
                        it is for, so they cannot drift apart: the same name box, the same block on the timeline
                        (dragged, split and silenced in the same way) at the same width, the same settings
                        drop-down, the same compact Duck and Voice boxes and the same gain slider.

                        The two kinds of sound differ in a few things only (a track of the video has a codec, filters
                        and a solo button; a sound from a file has a speed and can be removed). Each of those has a
                        place of a fixed width in the row, which is simply empty in the rows it does not apply to;
                        that is what keeps every row's timeline the same width. The names bound to are ones both
                        AudioTrack and Layer have.
                    -->
                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding AudioRows}" SizeChanged="TrackList_SizeChanged" AutomationProperties.Name="Audio Tracks" AllowDrop="True"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.Resources>
                            <!-- Encoder Mode's: what is done with the track, its codec and bitrate, and under them its gain, filters and speed. -->
                            <DataTemplate x:Key="AudioControlsFull">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Editor Mode: a sound is in the mix or muted, and how it is encoded is the export's business. Encoder Mode keeps the three boxes. -->
                                            <ToggleButton IsChecked="{Binding IsMuted}" Width="40" Margin="0,1" Padding="0,5" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                          Visibility="{Binding DataContext.IsEditorMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                        <Setter Property="Content" Value="&#xE767;" />
                                                        <Setter Property="AutomationProperties.Name" Value="Mute Track" />
                                                        <Setter Property="ToolTip" Value="Mute: leave this sound out of the mix, in the preview and in the export. Press again to bring it back." />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Content" Value="&#xE74F;" />
                                                                <Setter Property="ToolTip" Value="Muted: this sound is left out. Press to bring it back." />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsEncoderMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox Margin="0,1" Width="170" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" AutomationProperties.Name="Stream Mode"
                                                      ToolTip="Stream mode: a track of the video is copied, re-encoded or dropped; a sound from a file or a video layer is mixed into the first track, or left out." />
                                            <ComboBox Margin="6,1,0,1" Width="112" ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}"
                                                      IsEnabled="{Binding HasOwnFormat}" AutomationProperties.Name="Track Format" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="Format: the codec a re-encoded track of the video is encoded with. A sound from a file or a video layer has no stream of its own in the output: it is mixed into the first track, and encoded as that track is." />
                                            <ComboBox Margin="6,1,0,1" Width="86" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}"
                                                      IsEnabled="{Binding HasOwnFormat}" AutomationProperties.Name="Track Bitrate" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="Bitrate of a re-encoded track of the video. A sound that is mixed into the first track has that track's." />
                                            </StackPanel>
                                            <CheckBox Content="Duck" IsChecked="{Binding AutoDuck}" Margin="12,1,0,1"
                                                      ToolTip="Auto-Duck against Voice (also on the right-click menu): turns this sound down, by the Duck by (dB) amount above, whenever a sound marked Voice is speaking. A ducked track is re-encoded." />
                                            <CheckBox Content="Voice" IsChecked="{Binding IsVoice}" Margin="10,1,0,1"
                                                      ToolTip="Voiceover / Dialogue: this sound is a voice. Sounds set to Duck make room for it." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" IsEnabled="{Binding IsReencoded}" ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Gain and filters change the sound, so they apply to a sound that is re-encoded or mixed, not to a track that is copied.">
                                            <TextBlock Text="Gain (dB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Slider Width="170" Minimum="-40" Maximum="24" VerticalAlignment="Center"
                                                    Value="{Binding GainDb}" AutomationProperties.Name="Track Gain" local:NumericInput.Default="0" />
                                            <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding GainDb, StringFormat={}{0:0}}" AutomationProperties.Name="Track Gain Value"
                                                     local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="24" />
                                            <Button Padding="10,4" Margin="8,0,0,0" MinWidth="52" Click="TrackFilters_Click" AutomationProperties.Name="Track Filters"
                                                    ToolTip="Filters for this sound: compressor, noise gate, de-noise, bass/treble, high-pass, and the advanced ones. The number is how many are on.">
                                                <!-- The gear, and beside it how many filters are switched on -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FiltersCountText}" MinWidth="8" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" IsEnabled="{Binding HasSpeed}" ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="Speed: how many times as fast as recorded this sound plays, from 0.1 to 10, at the same pitch. Its block gets shorter as it gets faster. For a video layer it is the layer's speed, picture and sound together. A track of the main video runs with the main video, which has no speed of its own.">
                                                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Style="{StaticResource ValueBox}" Width="46" Text="{Binding ClipSpeed, StringFormat={}{0:0.##}}" AutomationProperties.Name="Track Speed"
                                                         local:NumericInput.Default="1" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="10" />
                                                <TextBlock Text="x" VerticalAlignment="Center" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                            </DataTemplate>
                            <!--
                                Editor Mode's: a sound is heard or muted, and how it is encoded is the export's business. Mute,
                                Duck, Voice and speed on one line, gain and the filters under it, in half the width.
                            -->
                            <DataTemplate x:Key="AudioControlsCompact">
                                <StackPanel MaxWidth="250" VerticalAlignment="Center" TextElement.FontSize="11.5">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding IsMuted}" Width="34" Padding="0,4" FontFamily="Segoe MDL2 Assets" FontSize="14">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                    <Setter Property="Content" Value="&#xE767;" />
                                                    <Setter Property="AutomationProperties.Name" Value="Mute Track" />
                                                    <Setter Property="ToolTip" Value="Mute: leave this sound out of the mix, in the preview and in the export. Press again to bring it back." />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="&#xE74F;" />
                                                            <Setter Property="ToolTip" Value="Muted: this sound is left out. Press to bring it back." />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <CheckBox Content="Duck" IsChecked="{Binding AutoDuck}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  ToolTip="Turned down while a sound marked Voice is speaking." />
                                        <CheckBox Content="Voice" IsChecked="{Binding IsVoice}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                  ToolTip="A voice: the sounds marked Duck make room for it." />
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsEnabled="{Binding HasSpeed}" ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Speed: how many times as fast as recorded this sound runs, from 0.1 to 10. A sound of the video itself has none of its own.">
                                            <TextBox Style="{StaticResource ValueBox}" Width="40" Margin="0" Text="{Binding ClipSpeed, StringFormat={}{0:0.##}}" AutomationProperties.Name="Track Speed"
                                                     local:NumericInput.Default="1" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0.1" local:NumericInput.Maximum="10" />
                                            <TextBlock Text="x" VerticalAlignment="Center" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" IsEnabled="{Binding IsReencoded}" ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Gain in decibels, and this sound's filters (compressor, gate, equalizer). Not for a muted sound.">
                                        <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Slider Width="92" Minimum="-40" Maximum="24" VerticalAlignment="Center" Value="{Binding GainDb}" AutomationProperties.Name="Track Gain" local:NumericInput.Default="0" />
                                        <TextBox Style="{StaticResource ValueBox}" Width="38" Margin="6,0,0,0" Text="{Binding GainDb, StringFormat={}{0:0}}" AutomationProperties.Name="Track Gain Value"
                                                 local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0" local:NumericInput.Minimum="-40" local:NumericInput.Maximum="24" />
                                        <Button Padding="7,3" Margin="6,0,0,0" Click="TrackFilters_Click" AutomationProperties.Name="Track Filters">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FiltersCountText}" MinWidth="6" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{Binding DataContext.AudioTrackRowHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="Transparent"
                                      ContextMenuOpening="AudioRow_ContextMenuOpening">
                                    <Grid.ContextMenu>
                                        <ContextMenu />
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="232" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <!-- Plays a track of the video on its own: the player switches to it, and back to the first track when pressed again -->
                                        <Grid DockPanel.Dock="Left" Width="42">
                                            <Button Padding="9,7" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                    Visibility="{Binding IsStream, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.ToggleSoloCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding SoloTarget}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="&#xE768;" />
                                                        <Setter Property="AutomationProperties.Name" Value="Play Track Alone" />
                                                        <Setter Property="ToolTip" Value="Play this track on its own. The player plays one track at a time, so it switches to this one; the encode is not affected." />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                <Setter Property="Content" Value="&#xE769;" />
                                                                <Setter Property="AutomationProperties.Name" Value="Stop Playing Track Alone" />
                                                                <Setter Property="ToolTip" Value="Pause, and go back to playing the first track." />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- A sound from a file is not something the player can switch to: a note in the button's place -->
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" ToolTip="A sound added from a file."
                                                       Visibility="{Binding IsStream, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                        <!--
                                            Where the sound comes from: the file, and under it which stream of the file
                                            (with its title), or that it is a voiceover recording, and its format.
                                            The name itself is changed from the row's right-click menu.
                                        -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Audio Source File">
                                                <TextBlock.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" />
                                                        <TextBlock Text="Right-click the row to rename it." Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Description}"
                                                       Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.Name="Audio Source Stream" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- The sound along the timeline. A gain stretches a track's picture at once; FFmpeg applies it when encoding. Click or drag on it to seek. -->
                                    <Border Grid.Column="1" Margin="0,3" Background="{DynamicResource InsetBrush}" CornerRadius="4" ClipToBounds="True" Cursor="Hand"
                                            MouseLeftButtonDown="Waveform_MouseLeftButtonDown" MouseMove="Waveform_MouseMove" MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                                            ToolTip="Click or drag to move the playhead to that moment.">
                                        <Grid>
                                        <Image Source="{Binding TrackWaveform}" Stretch="Fill" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Track Waveform">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleY="{Binding GainDb, Converter={StaticResource DecibelToScale}}" />
                                            </Image.RenderTransform>
                                        </Image>
                                        <!-- The sound as a block, or as the parts it was split into: dragged, selected for Split and Delete. Drawn from code. -->
                                        <local:TimelineTrack ClipToBounds="True" Background="Transparent" Tag="row"
                                                Loaded="ClipTrack_Loaded" Unloaded="ClipTrack_Unloaded" SizeChanged="ClipTrack_Changed" DataContextChanged="ClipTrack_DataContextChanged"
                                                AutomationProperties.Name="Audio Track Timeline" />
                                        </Grid>
                                    </Border>
                                    <!-- Right: the sound's controls. Encoder Mode's full set; Editor Mode's compact one, which a narrow window moves into a flyout. -->
                                    <ContentControl Grid.Column="2" Focusable="False" Content="{Binding}" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource AudioControlsFull}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsEditorMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource AudioControlsCompact}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.CompactTrackControls, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <!--
                                        With the window too narrow for a time bar of any use beside them, the controls are
                                        taken out of the row and offered from this one button instead, in a flyout.
                                    -->
                                    <ToggleButton Grid.Column="2" x:Name="audioControlsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Track Controls" ToolTip="This sound's controls: mute, duck, voice, speed, gain and filters. They are here because the window is too narrow to show them in the row."
                                                  Visibility="{Binding DataContext.CompactTrackControls, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />
                                    <Popup PlacementTarget="{Binding ElementName=audioControlsButton}" Placement="Left" HorizontalOffset="-4" StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=audioControlsButton, Mode=TwoWay}" Opened="TrackControlsPopup_Opened" Closed="TrackControlsPopup_Closed">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                                TextElement.Foreground="{DynamicResource TextBrush}">
                                            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource AudioControlsCompact}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Subtitles">
                <DockPanel>
                    <!-- Encoder Mode's: there the tab opens on the source's own subtitle tracks, and this button shows the captions instead. -->
                    <ToggleButton DockPanel.Dock="Top" Content="Show Advanced (Auto-Captions)" IsChecked="{Binding ShowAutoCaptions}"
                                  HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,10"
                                  Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Switches this tab between the subtitle tracks of the source and captions made from the spoken words. Remembered between sessions." />
                    <!-- Editor Mode's: the traditional view (the source's own subtitle tracks) is behind this button. -->
                    <ToggleButton DockPanel.Dock="Bottom" Content="Legacy Subtitle Settings" IsChecked="{Binding ShowLegacySubtitles}"
                                  HorizontalAlignment="Left" Padding="12,5" Margin="0,10,0,0"
                                  Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="The traditional view: carry over or burn in the subtitle tracks the source itself has, and import a subtitle file. Press again to come back to the captions." />
                    <!--
                        The subtitle track: imported from a file here, and edited in the Subtitle Editor. At the bottom
                        of the tab in Encoder Mode; in Editor Mode, at the bottom of the legacy settings.
                    -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" x:Name="SubtitleImportRow"
                               Visibility="{Binding ShowSubtitleImportRow, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Import External Subtitles" Padding="12,5" Margin="0,2,0,2" Click="ImportSubtitles_Click"
                                ToolTip="Reads a subtitle file in as the subtitle track. Text (.srt, .vtt) is drawn as captions in the caption style and can be edited; image-based subtitles (.sup, .pgs, VobSub .idx/.sub) are shown in the player and can be retimed, not reworded." />
                        <Button Content="Edit Subtitles" Padding="12,5" Margin="6,2,0,2" Click="EditSubtitles_Click"
                                ToolTip="Opens the Subtitle Editor: every subtitle on a timeline, to retime by dragging and to reword, and the track's Global Offset." />
                        <Button Content="Remove" Padding="12,5" Margin="6,2,0,2" Command="{Binding ClearSubtitlesCommand}" IsEnabled="{Binding HasSubtitleCues}"
                                ToolTip="Removes the subtitle track. Auto-captions, if they are on, are transcribed again from then on." />
                        <TextBlock Text="{Binding SubtitleTrackSummary}" VerticalAlignment="Center" Margin="14,2,0,2" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <Grid>
                        <!-- Standard: carry over or burn in the subtitle tracks the source has -->
                        <DockPanel Visibility="{Binding ShowStandardSubtitles, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox DockPanel.Dock="Top" Content="Download Subtitles with yt-dlp (--write-subs --write-auto-subs)"
                                      IsChecked="{Binding DownloadSubtitles}" HorizontalAlignment="Left" Margin="0"
                                      ToolTip="Applies to the next URL you load. The subtitles are embedded in the download, so they appear in the list below." />
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding SubtitleTracksHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
                            <ListBox Margin="0,10,0,0" ItemsSource="{Binding SubtitleTracks}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ComboBox Grid.Column="1" Margin="8,2,0,2" MinWidth="230" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Advanced: captions transcribed from the audio by whisper.cpp and drawn into the picture -->
                        <StackPanel Visibility="{Binding ShowAutoCaptions, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Generate Auto-Captions" IsChecked="{Binding AutoCaptions}" Margin="0,0,0,6"
                                      ToolTip="Transcribes the speech with whisper.cpp when an encode or Render Preview starts, and draws the words into the picture as animated captions." />
                            <!-- Analysis audio source: one of the video's own tracks, or a separate file -->
                            <Grid IsEnabled="{Binding AutoCaptions}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <RadioButton Grid.Row="3" Grid.ColumnSpan="2" GroupName="CaptionSource" Content="Recorded Voiceover Track" Margin="0,4,0,0"
                                             IsChecked="{Binding CaptionUseVoiceover}" IsEnabled="{Binding HasVoiceover}"
                                             ToolTip="Transcribe the voiceover from the Voiceover Studio (Audio tab), trimmed as set there. Choosing it also mixes the voiceover into the encode. Available once there is a voiceover." />
                                <TextBlock Grid.ColumnSpan="4" Text="Analysis Audio Source" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <RadioButton Grid.Row="1" GroupName="CaptionSource" Content="Video Audio Track:" IsChecked="{Binding CaptionUseVideoAudio}"
                                             ToolTip="Transcribe one of the loaded video's own audio tracks." />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" MinWidth="320" ItemsSource="{Binding AudioTracks}"
                                          SelectedItem="{Binding CaptionAudioTrack}" IsEnabled="{Binding CaptionUseVideoAudio}"
                                          AutomationProperties.Name="Caption Audio Track"
                                          ToolTip="Which track to listen to: the microphone track of a recording with separate game and voice tracks, for example.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <RadioButton Grid.Row="2" GroupName="CaptionSource" Content="External Audio File:" IsChecked="{Binding CaptionUseExternalAudio}"
                                             ToolTip="Transcribe a separate audio file that is in sync with the video: a clean voice recording, for example." />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding CaptionAudioPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CaptionUseExternalAudio}" AutomationProperties.Name="External Audio File" />
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="6,4,0,4" Click="BrowseCaptionAudio_Click" />
                                <Button Grid.Row="2" Grid.Column="3" Content="Clear" Margin="6,4,0,4" Click="ClearCaptionAudio_Click"
                                        IsEnabled="{Binding CaptionUseExternalAudio}" />
                            </Grid>
                            <!-- Which speech model listens: larger ones hear better and take longer. Chosen here, downloaded when needed. -->
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding AutoCaptions}" Margin="0,6,0,0">
                                <TextBlock Text="Model:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <ComboBox MinWidth="130" ItemsSource="{Binding WhisperModelChoices}" SelectedItem="{Binding WhisperModelChoice}" AutomationProperties.Name="Whisper Model"
                                          ToolTip="The whisper speech model the captions are transcribed with: tiny is the fastest and roughest, large-v3 the best and slowest, turbo nearly as good as large and several times faster. The .en models are for English only. A model that has not been downloaded yet is fetched when it is chosen." />
                                <TextBlock Text="{Binding WhisperModelStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <!-- How whisper is asked to listen -->
                            <Grid IsEnabled="{Binding AutoCaptions}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MaxWidth="460" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Language:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" MinWidth="80" Margin="0,4" ItemsSource="{Binding WhisperLanguages}" SelectedItem="{Binding WhisperLanguage}"
                                          AutomationProperties.Name="Whisper Language"
                                          ToolTip="The language that is spoken (--language). auto lets whisper decide; the English-only .en models need en." />
                                <CheckBox Grid.Column="2" Content="Translate to English" IsChecked="{Binding WhisperTranslate}" Margin="16,0,16,0"
                                          ToolTip="Captions in English whatever language is spoken (--translate). Needs a multilingual model, not an .en one." />
                                <TextBlock Grid.Column="3" Text="Initial Prompt:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="4" Margin="0,4" Text="{Binding WhisperPrompt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Whisper Prompt"
                                         ToolTip="Names, game terms and spellings to expect (--prompt), for example: Overwatch, Kiriko, ult. Whisper is more likely to write them that way." />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding AutoCaptions}">
                                <Button Content="Caption Style Settings" Click="CaptionStyle_Click"
                                        ToolTip="Font, colors, outline, words per line and the animation." />
                                <ToggleButton Content="Preview Subtitles" Margin="6,0,0,0" IsChecked="{Binding PreviewSubtitles}" AutomationProperties.Name="Preview Subtitles"
                                              ToolTip="Draws the captions over the picture in the player, in the style and the box they have: the words are transcribed the first time, which takes a moment. Change the style, or move the box, and the preview follows. The player draws them itself, so playback stays smooth; the box's rounded or soft edges and its mask are only in the export and in Render Preview." />
                                <Button Content="Edit Captions" Margin="6,0,0,0" Click="EditSubtitles_Click" AutomationProperties.Name="Edit Captions"
                                        ToolTip="Opens the Subtitle Editor: every caption on a timeline, to retime by dragging and to reword. The first time, the captions are transcribed and become a subtitle track that is yours to edit." />
                                <Button Content="Style / Blending" Margin="6,0,0,0" Click="CaptionLayerStyle_Click"
                                        ToolTip="The captions as a layer: opacity, rounded or soft edges, and a drop shadow. The same layer is listed under Layers on the Filters tab." />
                                <Button Content="Reset Position" Margin="6,0,0,0" Command="{Binding ResetCaptionLayerCommand}"
                                        ToolTip="Puts the caption box back in the lower part of the frame." />
                                <TextBlock Text="{Binding CaptionStyleSummary}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CaptionHint}" Foreground="{DynamicResource WarningTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <!-- Encoder Mode only: Editor Mode has these two boxes on its Video tab. -->
            <TabItem Header="Chapters" x:Name="ChaptersTab" Visibility="{Binding IsEncoderMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <CheckBox Content="Create chapter markers" IsChecked="{Binding ChapterMarkers}"
                              ToolTip="Carries the source's chapters over. Only for uncut encodes: once sections are removed, the source's chapter times no longer fit." />
                    <CheckBox Content="Generate Chapters at Cut Points" IsChecked="{Binding ChaptersAtCuts}"
                              ToolTip="Gives the output one chapter per kept segment, so a player can jump from cut to cut." />
                </StackPanel>
            </TabItem>

            <!-- Off by default; switched on in Settings for those who want to read or edit the FFmpeg command. -->
            <TabItem Header="Command Preview" x:Name="CommandPreviewTab"
                     Visibility="{Binding ShowCommandPreviewTab, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Regenerate" Command="{Binding RegenerateCommandCommand}" />
                        <TextBlock Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsCommandManuallyEdited, Converter={StaticResource BoolToVisibility}}"
                                   Text="Edited by hand: settings changes no longer update this command. Regenerate discards your edits." />
                    </StackPanel>
                    <TextBox FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="8"
                             Text="{Binding CommandPreview, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </TabItem>
        </TabControl>

        </Grid>
        </DockPanel>

        <!--
            The bottom of the window: where the output goes, and the status bar under it. In Editor Mode, in a
            window wide enough for both, the two are one row (see UpdateBottomBar).
        -->
        <Grid Grid.Row="4" Grid.RowSpan="2" x:Name="BottomBar">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Destination -->
        <Border Grid.ColumnSpan="2" x:Name="DestinationBar" Style="{StaticResource Panel}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save As:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="BrowseDestination_Click" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Add to Queue" Margin="6,0,0,0" Command="{Binding AddToQueueCommand}"
                            ToolTip="Queue the command in the Command Preview box to run later. While editing a queued job, this adds a second job." />
                    <!-- Only while a queued job is loaded for editing -->
                    <Button Content="Update Queued Job" Margin="6,0,0,0" Command="{Binding UpdateQueuedJobCommand}"
                            Visibility="{Binding IsEditingQueuedJob, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Replace the queued job being edited with the current settings." />
                </StackPanel>
                <Button Grid.Column="3" Content="Start Encode" Margin="6,0,0,0" FontWeight="SemiBold"
                        Command="{Binding StartEncodeCommand}" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" x:Name="StatusBar" Margin="2,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The action log: the last thing done, lit up for a moment when it changes; the ones before it are in the tooltip. -->
            <Grid x:Name="StatusTextHost" VerticalAlignment="Center">
                <Border x:Name="StatusFlash" Background="{DynamicResource AccentBrush}" CornerRadius="3" Margin="-4,-2" Opacity="0" IsHitTestVisible="False" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="Status"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent" ToolTipService.ShowDuration="20000">
                    <TextBlock.ToolTip>
                        <StackPanel MaxWidth="640">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                            <TextBlock Text="Recent actions" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding RecentActions}" TextWrapping="Wrap" FontFamily="Consolas" />
                        </StackPanel>
                    </TextBlock.ToolTip>
                </TextBlock>
            </Grid>
            <!-- A newer HandPeg has been downloaded. Ignoring this is fine: it is put in when the application closes. -->
            <StackPanel Grid.Column="1" x:Name="UpdateNotice" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="UpdateNoticeText" VerticalAlignment="Center" />
                <Button Content="Restart to update" Margin="8,0,0,0" Padding="12,3" Click="RestartToUpdate_Click"
                        ToolTip="Closes HandPeg, puts the new version in and starts it again. Without this, the update goes in the next time HandPeg is closed." />
                <Button Content="Later" Margin="6,0,0,0" Padding="10,3" Click="DismissUpdateNotice_Click"
                        ToolTip="Hide this. The update goes in when HandPeg is closed." />
            </StackPanel>
            <StackPanel Grid.Column="2" x:Name="StatusProgressHost" Orientation="Horizontal">
                <!-- How the I-frame index came out: shown for ten seconds, then cleared -->
                <TextBlock Text="{Binding IFrameStatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                           AutomationProperties.AutomationId="I-Frame Status" />
                <ProgressBar x:Name="StatusProgress" Width="240" Height="14" Margin="10,0,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
            </StackPanel>
            <Button Grid.Column="3" Content="Cancel" Margin="8,0,0,0" Padding="12,3" Command="{Binding CancelCommand}" />
        </Grid>
        </Grid>

        <!--
            The drop overlay: while a file is dragged over the window, the window dims and offers targets to
            drop it on (style or encoding presets, by the mode, and the Social Squisher's). Only the targets
            take the drop; the dimming does not, so a file let go anywhere else lands on what is under it, as
            it always did. Filled from code, after the window is up: nothing of it is on the way to starting.
        -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="999" Visibility="Collapsed">
            <Grid.Resources>
                <DataTemplate x:Key="DropTargetSmall">
                    <Button Height="60" MinWidth="110" Margin="4" Padding="8,3" HorizontalAlignment="Stretch" AllowDrop="True" Background="{DynamicResource DropTargetBrush}" Focusable="False" FontSize="11.5"
                            DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="None" HorizontalAlignment="Center" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding IconData}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate x:Key="DropTargetTemplate">
                    <Button Height="112" Width="232" Margin="6" Padding="12,6" FontSize="14" AllowDrop="True" Background="{DynamicResource DropTargetBrush}" Focusable="False"
                            DragEnter="DropTarget_DragEnter" DragLeave="DropTarget_DragLeave" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                            AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="None" HorizontalAlignment="Center" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding IconData}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </Grid.Resources>
            <Rectangle Fill="#C8000000" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The first and larger choice: open the file, with a preset. Which kind of preset is the mode's. -->
                <Border x:Name="DropPresetSection" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="10" Background="#38000000" Padding="16,10,16,12" HorizontalAlignment="Stretch">
                <StackPanel>
                <TextBlock x:Name="DropPresetTitle" Text="Open with a style preset" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" IsHitTestVisible="False" />
                <ItemsControl x:Name="DropPresetList" Focusable="False" ItemTemplate="{StaticResource DropTargetTemplate}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </StackPanel>
                </Border>
                <!-- The second, smaller: do not open it at all, squeeze it for somewhere. -->
                <Border x:Name="DropSquishSection" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="10" Background="#38000000" Padding="14,8,14,10" Margin="0,32,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                <TextBlock Text="Social Sharing Squisher" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" IsHitTestVisible="False" />
                <ItemsControl x:Name="DropSquishList" Focusable="False" ItemTemplate="{StaticResource DropTargetSmall}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
