<Window x:Class="HandPegApp.PasteEffectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste Selected Effects" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- The effects copied with Copy Stack, each with a box (all ticked), and where they go: this clip or every clip on its track (4.1.1-B). -->
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="EffectChoices" AutomationProperties.Name="Copied Effects" />
        </ScrollViewer>
        <CheckBox x:Name="ToTrackBox" Content="Paste to all clips on track" Margin="0,12,0,0" AutomationProperties.Name="Paste to All Clips on Track"
                  ToolTip="Every clip on this clip's track gets the effects ticked above, not only this one." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="PasteButton" Content="Paste" MinWidth="110" IsDefault="True" Click="Paste_Click" />
            <Button Content="Cancel" MinWidth="88" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
