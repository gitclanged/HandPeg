<Window x:Class="HandPegApp.PreviewPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Render Preview" Width="760" Height="560" MinWidth="360" MinHeight="280"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Content="Pause" MinWidth="80" Click="PlayPause_Click" />
            <Slider Grid.Column="1" x:Name="PositionSlider" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    IsMoveToPointEnabled="True" AutomationProperties.Name="Preview Position"
                    ValueChanged="PositionSlider_ValueChanged"
                    Thumb.DragStarted="PositionSlider_DragStarted" Thumb.DragCompleted="PositionSlider_DragCompleted" />
            <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00.0 / 00:00.0" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="Close" MinWidth="80" IsCancel="True" Click="Close_Click" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" x:Name="InfoText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis" />
        <Border Background="Black" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <!-- The clip is a small H.264 file, which Windows plays by itself: no second video engine needed. -->
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
        </Border>
    </DockPanel>
</Window>
