<Window x:Class="HandPegApp.Views.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        xmlns:views="clr-namespace:HandPegApp.Views"
        Title="Subtitle Editor" Width="980" Height="680" MinWidth="640" MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A player of the editor's own: a blank black picture the shape of the output frame, with the subtitles on it and nothing else. -->
        <Border Background="Black" CornerRadius="4">
            <Grid>
                <local:VideoSurface x:Name="Surface" />
                <TextBlock x:Name="PlayerNotice" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!--
            The timeline. Its two ends fade out: the mask is opaque across the middle and see-through at the
            edges, so the strip seems to come out of nothing on one side and go into it on the other.
        -->
        <Border Grid.Row="1" Margin="0,10,0,0" Height="92">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.09" Color="#FF000000" />
                    <GradientStop Offset="0.91" Color="#FF000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <views:SubtitleTimeline x:Name="Timeline" AutomationProperties.Name="Subtitle Timeline"
                                    ToolTip="Drag the strip to scrub; the mouse wheel zooms. Drag a subtitle to move it, or one of its ends to retime that end." />
        </Border>

        <!-- Transport, and what is done to the cues. -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,6" Click="Play_Click"
                        ToolTip="Play or pause (Space)." AutomationProperties.Name="Play or Pause" />
                <TextBlock x:Name="TimeText" Text="0:00.000" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,14,0" MinWidth="86" />
                <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,6" Click="Previous_Click" ToolTip="Go to the subtitle before." AutomationProperties.Name="Previous Subtitle" />
                <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="10,6" Margin="4,0,0,0" Click="Next_Click" ToolTip="Go to the next subtitle." AutomationProperties.Name="Next Subtitle" />
                <Button x:Name="AddButton" Content="Add Segment" Padding="12,6" Margin="14,0,0,0" Click="Add_Click" ToolTip="A new, blank subtitle of two seconds at the playhead." />
                <Button x:Name="SplitButton" Content="Split" Padding="12,6" Margin="4,0,0,0" Click="Split_Click" ToolTip="Cuts the selected subtitle in two at the playhead: the words said before it stay, the rest become a subtitle of their own." />
                <Button x:Name="AddWordButton" Content="Add Word" Padding="12,6" Margin="4,0,0,0" Click="AddWord_Click" ToolTip="Adds a word to the end of the selected subtitle, ready to be typed over." />
                <Button x:Name="DeleteButton" Content="Delete" Padding="12,6" Margin="4,0,0,0" Click="Delete_Click" ToolTip="Deletes the word that is picked out in the selected subtitle; with no word picked out, the whole subtitle (Delete)." />
            </StackPanel>
        </DockPanel>

        <!-- The selected cue: its words, and its times to the millisecond. -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CueText" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     TextChanged="CueText_TextChanged" IsEnabled="False" AutomationProperties.Name="Subtitle Text" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Start (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="StartBox" Grid.Column="1" Width="92" Margin="0,2" Padding="4,2" FontFamily="Consolas" IsEnabled="False" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="Subtitle Start" />
                <TextBlock Grid.Row="1" Text="End (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="EndBox" Grid.Row="1" Grid.Column="1" Width="92" Margin="0,2" Padding="4,2" FontFamily="Consolas" IsEnabled="False" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="Subtitle End" />
                <TextBlock Grid.Row="2" Text="Global Offset (ms):" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="OffsetBox" Grid.Row="2" Grid.Column="1" Width="92" Margin="0,2" Padding="4,2" FontFamily="Consolas" LostFocus="OffsetBox_LostFocus" KeyDown="TimeBox_KeyDown" TextChanged="OffsetBox_TextChanged" AutomationProperties.Name="Global Offset"
                         ToolTip="Shifts every subtitle of the track as it is typed: later when positive, earlier when negative." />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,6" IsCancel="True" IsDefault="False" Click="Close_Click" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
