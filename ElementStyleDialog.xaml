<Window x:Class="HandPegApp.ElementStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandPegApp"
        Title="{Binding Name, StringFormat=Style / Blending: {0}}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Bound straight to the element: every change shows in the command at once. -->
    <StackPanel Margin="16">
        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="How the element sits on the picture. Use Render Preview to see the result." />

        <!-- Shape and transparency: always available -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CornerRow" Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Text="Corner Radius:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding CornerRadius}" AutomationProperties.Name="Corner Radius" local:NumericInput.Default="0"
                    ToolTip="Rounds the corners, as a percentage of the element's shorter side: 0 is square, 50 turns the short sides into half-circles." />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding CornerRadius, StringFormat={}{0:0}}" AutomationProperties.Name="Corner Radius Value" local:NumericInput.Default="0" local:NumericInput.DragStep="0.2" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="50" /><TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>

            <TextBlock Grid.Row="1" Text="Opacity:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding Opacity}" AutomationProperties.Name="Element Opacity" local:NumericInput.Default="100"
                    ToolTip="100 is solid. Lower lets the picture underneath show through, as a watermark does." />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding Opacity, StringFormat={}{0:0}}" AutomationProperties.Name="Element Opacity Value" local:NumericInput.Default="100" local:NumericInput.DragStep="1" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="100" /><TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
        </Grid>

        <!-- Shaping a picture: not for the caption box, which has only its opacity -->
        <StackPanel x:Name="ShapePanel">
        <CheckBox Content="Feather / Blurred Edges" IsChecked="{Binding Feather}"
                  ToolTip="Fades the element out towards its edges instead of ending in a hard line." />
        <Grid IsEnabled="{Binding Feather}" Margin="26,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Feather Radius:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding FeatherRadius}" AutomationProperties.Name="Feather Radius" local:NumericInput.Default="12"
                    ToolTip="Width of the fade, in output pixels. It is held to less than half the element's size." />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding FeatherRadius, StringFormat={}{0:0}}" AutomationProperties.Name="Feather Radius Value" local:NumericInput.Default="12" local:NumericInput.DragStep="0.396" local:NumericInput.Decimals="0" local:NumericInput.Minimum="1" local:NumericInput.Maximum="100" /><TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
        </Grid>

        <CheckBox Content="Drop Shadow" IsChecked="{Binding Shadow}"
                  ToolTip="Lays a dark copy of the element's outline underneath it, offset down and to the right." />
        <Grid IsEnabled="{Binding Shadow}" Margin="26,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Text="Shadow Opacity:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding ShadowOpacity}" AutomationProperties.Name="Shadow Opacity" local:NumericInput.Default="0.5" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding ShadowOpacity, StringFormat={}{0:0.00}}" AutomationProperties.Name="Shadow Opacity Value" local:NumericInput.Default="0.5" local:NumericInput.DragStep="0.01" local:NumericInput.Decimals="2" local:NumericInput.Minimum="0" local:NumericInput.Maximum="1" /></StackPanel>

            <TextBlock Grid.Row="1" Text="Offset Distance:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding ShadowOffset}" AutomationProperties.Name="Shadow Offset" local:NumericInput.Default="10" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Style="{StaticResource ValueBox}" Width="48" Margin="8,0,0,0" Text="{Binding ShadowOffset, StringFormat={}{0:0}}" AutomationProperties.Name="Shadow Offset Value" local:NumericInput.Default="10" local:NumericInput.DragStep="0.24" local:NumericInput.Decimals="0" local:NumericInput.Minimum="0" local:NumericInput.Maximum="60" /><TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
        </Grid>

        </StackPanel>
        <Button Content="Close" MinWidth="88" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
